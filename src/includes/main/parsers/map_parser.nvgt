bool dispatch_entity_line(string[] sd)
{
if(sd[0]=="platform" && (sd.length()==10 || sd.length()==11 || sd.length()==12))
read_platform(sd);
else if(sd[0]=="staircase" && (sd.length()==11 || sd.length()==13))
read_staircase(sd);
else if(sd[0]=="slant" && (sd.length()==12 || sd.length()==14))
read_slant(sd);
else if(sd[0]=="vanishing_hazard" && (sd.length()==5 || sd.length()==6))
read_vanishing_hazard(sd);
else if(sd[0]=="vanishing_hazard" && (sd.length()==7 || sd.length()==9))
read_ranged_vanishing_hazard(sd);
else if(sd[0]=="vanishing_platform" && (sd.length()==11 || sd.length()==12 || sd.length()==13))
read_vanishing_platform(sd);
else if(sd[0]=="wall" && (sd.length()==12 || sd.length()==14))
read_wall(sd);
else if(sd[0]=="tpl" && ((mapmode=="3d" && sd.length()==7) || (mapmode!="3d" && sd.length()==6)))
read_template(sd);
else if(sd[0]=="blockage" && ((mapmode=="3d" && sd.length()>=8) || (mapmode!="3d" && sd.length()>=6)))
read_blockage(sd);
else if(sd[0]=="door" && ((mapmode=="3d" && sd.length()>=17) || (mapmode!="3d" && sd.length()>=15)))
read_door(sd);
else if(sd[0]=="elevator" && sd.length()>=10)
read_elevator(sd);
else if(sd[0]=="el_floor" && sd.length()>=5)
read_el_floor(sd);
else if(sd[0]=="passage" && ((mapmode=="3d" && sd.length()>=16) || (mapmode!="3d" && sd.length()>=14)))
read_passage(sd);
else if(sd[0]=="menu_zone" && (sd.length()==5 || sd.length()==6 || sd.length()==7 || sd.length()==8))
read_menu_zone(sd);
else if(sd[0]=="safe_zone" && (sd.length()==6 || sd.length()==8))
read_safe_zone(sd);
else if(sd[0]=="fall_zone" && (sd.length()==5 || sd.length()==7))
read_fall_zone(sd);
else if((sd[0]=="text_zone" || sd[0]=="zone") && ((mapmode=="3d" && sd.length()>=8) || (mapmode!="3d" && sd.length()>=6)))
read_text_zone(sd);
else if(sd[0]=="obscurity_zone" && ((mapmode=="3d" && sd.length()>=11) || (mapmode!="3d" && sd.length()>=9)))
read_obscurity_zone(sd);
else if(sd[0]=="effect_space" && sd.length()>=10)
read_effect_space(sd);
else if(sd[0]=="text_square" && sd.length()>=4)
read_text_square(sd);
else if(sd[0]=="clock" && sd.length()>=6)
read_clock(sd);
else if(sd[0]=="calendar" && sd.length()>=6)
read_calendar(sd);
else if(sd[0]=="chblocker" && ((mapmode=="3d" && sd.length()>=9) || (mapmode!="3d" && sd.length()>=7)))
read_chblocker(sd);
else if(sd[0]=="cblocker" && ((mapmode=="3d" && sd.length()>=9) || (mapmode!="3d" && sd.length()>=7)))
read_cblocker(sd);
else if(sd[0]=="sound_ambience" && (sd.length()==7 || sd.length()==8))
read_sound_ambience(sd);
else if(sd[0]=="sound_ambience" && (sd.length()==9 || sd.length()==11))
read_ranged_sound_ambience(sd);
else if(sd[0]=="sound_source" && (sd.length()==7 || sd.length()==8))
read_sound_source(sd);
else if(sd[0]=="sound_source" && (sd.length()==9 || sd.length()==11))
read_ranged_sound_source(sd);
else if(sd[0]=="speaker" && (sd.length()==9 || sd.length()==11))
read_speaker(sd);
else if(sd[0]=="trampoline" && (sd.length()==7 || sd.length()==9))
read_trampoline(sd);
else if(sd[0]=="url_ambience" && (sd.length()==6 || sd.length()==7))
read_url_ambience(sd);
else if(sd[0]=="url_ambience" && (sd.length()==8 || sd.length()==10))
read_ranged_url_ambience(sd);
else if(sd[0]=="url_source" && (sd.length()==6 || sd.length()==7))
read_url_source(sd);
else if(sd[0]=="url_source" && (sd.length()==8 || sd.length()==10))
read_ranged_url_source(sd);
else if(sd[0]=="excludable_ambience" && (sd.length()==13 || sd.length()==17))
read_excludable_ambience(sd);
else if(sd[0]=="excludable_source" && (sd.length()==13 || sd.length()==17))
read_excludable_source(sd);
else if(sd[0]=="time_bomb" && (sd.length()==7 || sd.length()==8))
read_timebomb(sd);
else if(sd[0]=="timed_ambience" && (sd.length()==8 || sd.length()==9))
read_timed_ambience(sd);
else if(sd[0]=="timed_ambience" && (sd.length()==10 || sd.length()==12))
read_ranged_timed_ambience(sd);
else if(sd[0]=="timed_source" && (sd.length()==8 || sd.length()==9))
read_timed_source(sd);
else if(sd[0]=="timed_source" && (sd.length()==10 || sd.length()==12))
read_ranged_timed_source(sd);
else if(sd[0]=="timed_text" && ((mapmode=="3d" && sd.length()>=6) || (mapmode!="3d" && sd.length()>=5)))
read_timed_text(sd);
else if(sd[0]=="heal_zone" && (sd.length()==9 || sd.length()==11))
read_heal_zone(sd);
else if(sd[0]=="tile_zone" && (sd.length()==10 || sd.length()==12))
read_tile_zone(sd);
else if(sd[0]=="flux_zone" && (sd.length()==10 || sd.length()==12))
read_flux_zone(sd);
else if(sd[0]=="hazard" && (sd.length()==5 || sd.length()==6))
read_hazard(sd);
else if(sd[0]=="hazard" && (sd.length()==7 || sd.length()==9))
read_ranged_hazard(sd);
else if(sd[0]=="lift" && (sd.length()==13 || sd.length()==15))
read_lift(sd);
else if(sd[0]=="mine" && (sd.length()==6 || sd.length()==7))
read_mine(sd);
else if(sd[0]=="mhazard" && (sd.length()==11 || sd.length()==14))
read_mhazard(sd);
else if(sd[0]=="mplatform" && (sd.length()==16 || sd.length()==19))
read_mplatform(sd);
else if(sd[0]=="sign" && sd.length()>=7)
read_sign(sd);
else if(sd[0]=="checkpoint" && (sd.length()==6 || sd.length()==7))
read_checkpoint(sd);
else if(sd[0]=="story_zone" && ((mapmode=="3d" && sd.length()>=10) || (mapmode!="3d" && sd.length()>=8)))
read_story_zone(sd);
else if(sd[0]=="item" && (sd.length()==8 || sd.length()==9))
read_item(sd);
else if(sd[0]=="item_zone" && (sd.length()==8 || sd.length()==10))
read_item_zone(sd);
else if(sd[0]=="spike" && (sd.length()==8 || sd.length()==9))
read_spike(sd);
else if(sd[0]=="spike" && (sd.length()==10 || sd.length()==12))
read_ranged_spike(sd);
else if(sd[0]=="spawnpoint" && (sd.length()==3 || sd.length()==4))
read_spawnpoint(sd);
else if(sd[0]=="travelpoint" && ((mapmode=="3d" && sd.length()>=9) || (mapmode!="3d" && sd.length()>=7)))
read_travelpoint(sd);
else if(sd[0]=="aircraft" && (sd.length()==5 || sd.length()==6))
read_aircraft(sd);
else if(sd[0]=="airbeacon" && (sd.length()==3 || sd.length()==4 || sd.length()==5 || sd.length()==6))
read_airbeacon(sd);
else if(sd[0]=="air_turbulence" && ((mapmode=="3d" && sd.length()==7) || (mapmode!="3d" && sd.length()==6)))
read_air_turbulence(sd);
else if(sd[0]=="npc" && (sd.length()==7 || sd.length()==8))
read_npc(sd);
else if(sd[0]=="ttsenemie")
read_ttsenemie(sd);
else if(sd[0]=="camera" && (sd.length()==11 || sd.length()==13))
read_camera(sd);
else if(sd[0]=="floor_breaker" && (sd.length()==4 || sd.length()==5))
read_floor_breaker(sd);
else if(sd[0]=="fire" && (sd.length()==9 || sd.length()==12))
read_fire(sd);
else if(sd[0]=="wind" && (sd.length()==12 || sd.length()==15))
read_wind(sd);
else if(sd[0]=="force_field" && (sd.length()==6 || sd.length()==7))
read_forcefield(sd);
else if(sd[0]=="force_field" && (sd.length()==8 || sd.length()==10))
read_ranged_forcefield(sd);
else if(sd[0]=="projectile" && (sd.length()==16 || sd.length()==19))
read_projectile(sd);
else if(sd[0]=="npc_zone" && (sd.length()==9 || sd.length()==10 || sd.length()==11))
read_npc_zone(sd);
else if(sd[0]=="bike" && (sd.length()==6 || sd.length()==7))
read_bike(sd);
else if(sd[0]=="bomb" && (sd.length()==6 || sd.length()==7))
read_bomb(sd);
else if(sd[0]=="bomb_zone" && (sd.length()==6 || sd.length()==7 || sd.length()==8))
read_bomb_zone(sd);
else if(sd[0]=="belt" && (sd.length()==9 || sd.length()==11))
read_belt(sd);
else if(sd[0]=="projectile_zone" && (sd.length()==6 || sd.length()==7 || sd.length()==8))
read_projectile_zone(sd);
else if(sd[0]=="switch")
read_switch(sd);
else if(sd[0]=="sensor")
read_sensor(sd);
else if(sd[0]=="teleporter" && (sd.length()==12 || sd.length()==16))
read_teleporter(sd);
else if(sd[0]=="vehicle" && (sd.length()==10 || sd.length()==11))
read_vehicle(sd);
else return false;
return true;
}
/* Structural validator twin of dispatch_entity_line above. Returns "" if the line would load,
otherwise a plain-english reason (unrecognized object, or wrong number of values). It mirrors the
exact keyword + length gates of dispatch_entity_line WITHOUT spawning, so it MUST be kept in sync
with that function: any entity added/changed there must be updated here too. `mode` is passed in
(not read from the global mapmode) so a paste can be checked against the pasted map's own mode. */
string entity_line_error(string[] sd, string mode)
{
if(sd.length()==0) return "";
string k = sd[0];
uint L = sd.length();
bool is3d = (mode=="3d");
bool known=false, lenok=false;
if(k=="platform"){ known=true; lenok=(L==10||L==11||L==12); }
else if(k=="staircase"){ known=true; lenok=(L==11||L==13); }
else if(k=="slant"){ known=true; lenok=(L==12||L==14); }
else if(k=="vanishing_hazard"){ known=true; lenok=(L==5||L==6||L==7||L==9); }
else if(k=="vanishing_platform"){ known=true; lenok=(L==11||L==12||L==13); }
else if(k=="wall"){ known=true; lenok=(L==12||L==14); }
else if(k=="tpl"){ known=true; lenok=(is3d ? L==7 : L==6); }
else if(k=="blockage"){ known=true; lenok=(is3d ? L>=8 : L>=6); }
else if(k=="door"){ known=true; lenok=(is3d ? L>=17 : L>=15); }
else if(k=="elevator"){ known=true; lenok=(L>=10); }
else if(k=="el_floor"){ known=true; lenok=(L>=5); }
else if(k=="passage"){ known=true; lenok=(is3d ? L>=16 : L>=14); }
else if(k=="menu_zone"){ known=true; lenok=(L==5||L==6||L==7||L==8); }
else if(k=="safe_zone"){ known=true; lenok=(L==6||L==8); }
else if(k=="fall_zone"){ known=true; lenok=(L==5||L==7); }
else if(k=="text_zone" || k=="zone"){ known=true; lenok=(is3d ? L>=8 : L>=6); }
else if(k=="obscurity_zone"){ known=true; lenok=(is3d ? L>=11 : L>=9); }
else if(k=="effect_space"){ known=true; lenok=(L>=10); }
else if(k=="text_square"){ known=true; lenok=(L>=4); }
else if(k=="clock"){ known=true; lenok=(L>=6); }
else if(k=="calendar"){ known=true; lenok=(L>=6); }
else if(k=="chblocker"){ known=true; lenok=(is3d ? L>=9 : L>=7); }
else if(k=="cblocker"){ known=true; lenok=(is3d ? L>=9 : L>=7); }
else if(k=="sound_ambience"){ known=true; lenok=(L==7||L==8||L==9||L==11); }
else if(k=="sound_source"){ known=true; lenok=(L==7||L==8||L==9||L==11); }
else if(k=="speaker"){ known=true; lenok=(L==9||L==11); }
else if(k=="trampoline"){ known=true; lenok=(L==7||L==9); }
else if(k=="url_ambience"){ known=true; lenok=(L==6||L==7||L==8||L==10); }
else if(k=="url_source"){ known=true; lenok=(L==6||L==7||L==8||L==10); }
else if(k=="excludable_ambience"){ known=true; lenok=(L==13||L==17); }
else if(k=="excludable_source"){ known=true; lenok=(L==13||L==17); }
else if(k=="time_bomb"){ known=true; lenok=(L==7||L==8); }
else if(k=="timed_ambience"){ known=true; lenok=(L==8||L==9||L==10||L==12); }
else if(k=="timed_source"){ known=true; lenok=(L==8||L==9||L==10||L==12); }
else if(k=="timed_text"){ known=true; lenok=(is3d ? L>=6 : L>=5); }
else if(k=="heal_zone"){ known=true; lenok=(L==9||L==11); }
else if(k=="tile_zone"){ known=true; lenok=(L==10||L==12); }
else if(k=="flux_zone"){ known=true; lenok=(L==10||L==12); }
else if(k=="hazard"){ known=true; lenok=(L==5||L==6||L==7||L==9); }
else if(k=="lift"){ known=true; lenok=(L==13||L==15); }
else if(k=="mine"){ known=true; lenok=(L==6||L==7); }
else if(k=="mhazard"){ known=true; lenok=(L==11||L==14); }
else if(k=="mplatform"){ known=true; lenok=(L==16||L==19); }
else if(k=="sign"){ known=true; lenok=(L>=7); }
else if(k=="checkpoint"){ known=true; lenok=(L==6||L==7); }
else if(k=="story_zone"){ known=true; lenok=(is3d ? L>=10 : L>=8); }
else if(k=="item"){ known=true; lenok=(L==8||L==9); }
else if(k=="item_zone"){ known=true; lenok=(L==8||L==10); }
else if(k=="spike"){ known=true; lenok=(L==8||L==9||L==10||L==12); }
else if(k=="spawnpoint"){ known=true; lenok=(L==3||L==4); }
else if(k=="travelpoint"){ known=true; lenok=(is3d ? L>=9 : L>=7); }
else if(k=="aircraft"){ known=true; lenok=(L==5||L==6); }
else if(k=="airbeacon"){ known=true; lenok=(L==3||L==4||L==5||L==6); }
else if(k=="air_turbulence"){ known=true; lenok=(is3d ? L==7 : L==6); }
else if(k=="npc"){ known=true; lenok=(L==7||L==8); }
else if(k=="ttsenemie"){ known=true; lenok=true; }
else if(k=="camera"){ known=true; lenok=(L==11||L==13); }
else if(k=="floor_breaker"){ known=true; lenok=(L==4||L==5); }
else if(k=="fire"){ known=true; lenok=(L==9||L==12); }
else if(k=="wind"){ known=true; lenok=(L==12||L==15); }
else if(k=="force_field"){ known=true; lenok=(L==6||L==7||L==8||L==10); }
else if(k=="projectile"){ known=true; lenok=(L==16||L==19); }
else if(k=="npc_zone"){ known=true; lenok=(L==9||L==10||L==11); }
else if(k=="bike"){ known=true; lenok=(L==6||L==7); }
else if(k=="bomb"){ known=true; lenok=(L==6||L==7); }
else if(k=="bomb_zone"){ known=true; lenok=(L==6||L==7||L==8); }
else if(k=="belt"){ known=true; lenok=(L==9||L==11); }
else if(k=="projectile_zone"){ known=true; lenok=(L==6||L==7||L==8); }
else if(k=="switch"){ known=true; lenok=true; }
else if(k=="sensor"){ known=true; lenok=true; }
else if(k=="teleporter"){ known=true; lenok=(L==12||L==16); }
else if(k=="vehicle"){ known=true; lenok=(L==10||L==11); }
if(!known) return "this is not a recognized object.";
if(!lenok) return "this object has the wrong number of values.";
return "";
}
/* True for the structural header lines (mode + bounds) that are not placeable entities, so callers
validating a whole pasted map skip them instead of flagging them as unrecognized objects. */
bool line_is_map_header(string[] sd)
{
if(sd.length()==0) return false;
string k=sd[0];
return k=="mode" || k=="minx" || k=="maxx" || k=="miny" || k=="maxy" || k=="minz" || k=="maxz";
}
/* --- Tier 2 semantic validation: shared helpers --- */
/* True if the token is a usable number: a plain integer/decimal (optionally negative) or a
random(low,high) token, which is valid in any numeric field and expands at load. */
bool is_number_token(string s)
{
if(s.length()==0) return false;
if(s.length()>=8 && s.substr(0,7)=="random(" && s.substr(s.length()-1,1)==")") return true;
uint start=0;
if(s.substr(0,1)=="-") start=1;
bool dot=false, digit=false;
for(uint i=start; i<s.length(); i++)
{
string c=s.substr(i,1);
if(c>="0" && c<="9") digit=true;
else if(c=="." && !dot) dot=true;
else return false;
}
return digit;
}
/* A coordinate value is in the map if it falls within that axis's min/max bounds (z only on 3d). */
bool coord_in_bounds(string axis, double v, string mode)
{
if(axis=="x") return v>=minx && v<=maxx;
if(axis=="y") return v>=miny && v<=maxy;
if(axis=="z") return mode!="3d" || (v>=minz && v<=maxz);
return true;
}
/* Check one coordinate token: returns "" if fine, else a reason fragment ("must be a number" /
"is outside the map"). A random(...) token is number-valid but its rolled value can't be
bounds-checked, so bounds are skipped for it. */
string coord_token_error(string tok, string axis, string mode)
{
if(!is_number_token(tok)) return "must be a number";
if(tok.length()>=7 && tok.substr(0,7)=="random(") return "";
if(!coord_in_bounds(axis, stn(tok), mode)) return "is outside the map";
return "";
}
/* For a ranged span, the minimum must not exceed the maximum. Both tokens are assumed already
number-checked by the caller; random(...) on either end is left alone (its value is unknown). */
string range_token_error(string lotok, string hitok)
{
if(lotok.length()>=7 && lotok.substr(0,7)=="random(") return "";
if(hitok.length()>=7 && hitok.substr(0,7)=="random(") return "";
if(stn(lotok) > stn(hitok)) return "minimum is greater than maximum";
return "";
}
/* True if a folder named `name` exists among those matching the sounds glob (e.g. the checkpoint
sound folders). Used for name-existence checks; resolves the same way the entity's build form lists
its choices — get_map_sound_folders returns the leaf folder names. Sentinels like "none"/"any" are
the caller's responsibility to accept before calling this. */
bool name_exists(string glob_path, string name)
{
string[] folders = get_map_sound_folders(glob_path);
for(uint i=0; i<folders.length(); i++)
if(folders[i]==name) return true;
return false;
}
/* True if the token is a boolean as the builder writes it (lowercase true/false). */
bool is_bool_token(string s)
{
return s=="true" || s=="false";
}
/* Tier 2 SEMANTIC validation, run only AFTER entity_line_error() confirms the line is structurally
valid (recognized object, right field count). Returns "" if the values are fine, else a plain-english
reason; col is set to the 1-based value position that's wrong (the sd index — keyword is 0, first
value is 1) so the error box can show "line: N (col)". Per-entity checkers live in each entity's own
.nvgt file, mirroring its read_ function; this just dispatches. Grows one entity at a time. */
string entity_semantic_error(string[] sd, string mode, int &out col)
{
col = -1;
string k = sd[0];
if(k=="spawnpoint") return spawnpoint_semantic_error(sd, mode, col);
if(k=="fall_zone") return fall_zone_semantic_error(sd, mode, col);
if(k=="airbeacon") return airbeacon_semantic_error(sd, mode, col);
if(k=="air_turbulence") return air_turbulence_semantic_error(sd, mode, col);
if(k=="url_source" || k=="url_ambience") return url_audio_semantic_error(sd, mode, col);
if(k=="checkpoint") return checkpoint_semantic_error(sd, mode, col);
if(k=="floor_breaker") return floor_breaker_semantic_error(sd, mode, col);
if(k=="safe_zone") return safe_zone_semantic_error(sd, mode, col);
if(k=="hazard") return hazard_semantic_error(sd, mode, col);
if(k=="mine") return mine_semantic_error(sd, mode, col);
if(k=="spike") return spike_semantic_error(sd, mode, col);
if(k=="fire") return fire_semantic_error(sd, mode, col);
if(k=="force_field") return force_field_semantic_error(sd, mode, col);
if(k=="vanishing_hazard") return vanishing_hazard_semantic_error(sd, mode, col);
if(k=="time_bomb") return time_bomb_semantic_error(sd, mode, col);
return "";
}

bool load_map(string name, string owner, bool instent_update=true, bool speak_percentage=false, bool anounce_mapload=true, int loadtime=50, int loadbeeps=maploadbeeps, int loadsounds=maploadsounds, bool force_compiled=false, bool force_spawned=false)
{
mapname = name;
mapowner = owner;
mapmode = "";
minz = 0;
maxz = 0;
maploadbeeps = loadbeeps;
maploadsounds = loadsounds;
clearmap();
cloner_has_last = false;
if (string_ends_with(mapname, ".sif"))
mapname = string_replace(mapname, ".sif", "", true);
if (string_ends_with(mapname, ".map"))
mapname = string_replace(mapname, ".map", "", true);
string decompiled_info_path = "data/builder/maps/decompiled/" + mapname + "/data/main.sif";
string compiled_path = "data/builder/maps/compiled/" + mapname + ".map";
string mapdata = "";
string meta_text = "";
bool loaded = false;
map_is_compiled = false;
if (!force_compiled && file_exists(decompiled_info_path))
{
if (map_pack_loaded) map_pack.close();
map_pack_loaded = false;
@sound_default_pack = null;
mapper.open(decompiled_info_path, "rb");
mapdata = mapper.read();
mapper.close();
string meta_path = "data/builder/maps/decompiled/" + mapname + "/data/meta.sif";
if (file_exists(meta_path))
{
file mf;
if (mf.open(meta_path, "rb"))
{
meta_text = mf.read();
mf.close();
}
}
loaded = true;
map_is_compiled = false;
}
else if (file_exists(compiled_path))
{
if (!load_map_pack(mapname, ""))
{
dlg("Error: Map failed to load.");
return false;
}
if (map_pack.file_exists("data/main.sif"))
{
uint size = map_pack.get_file_size("data/main.sif");
mapdata = map_pack.read_file("data/main.sif", 0, size);
loaded = true;
map_is_compiled = true;
}
if (map_pack.file_exists("data/meta.sif"))
{
uint size = map_pack.get_file_size("data/meta.sif");
meta_text = map_pack.read_file("data/meta.sif", 0, size);
}
}
if (!loaded)
{
dlg("Error: Map not found or missing data/main.sif.");
return false;
}
map_meta@ meta = parse_map_meta(meta_text);
mapowner = meta.owner;
uint64 map_total_bytes = map_is_compiled ? file_get_size(compiled_path) : get_directory_size("data/builder/maps/decompiled/" + mapname);
string map_total_readable = measure_file_size(map_total_bytes);
string load_help = "Loading map. Press Space for percentage, 1 2 and 3 keys for detailed progress, or escape to cancel. Press h to read this help message again.";
sound mapload;
timer maploadtimer;
if(anounce_mapload==true) speak(load_help);
if(loadsounds==1) mpool.play_stationary(get_pack_sound("main/characters/"+chartype+"/map/*start*"),false);
if(loadsounds==1) mapload.load(get_pack_sound("main/characters/"+chartype+"/map/*load*"));
if(loadsounds==1) mapload.play_looped();
string[] raw_lines = delinear(mapdata);
string[] lines;
uint[] _filter_origin;
filter_empty_lines(raw_lines, lines, _filter_origin);
double percent=0;
double last_beep_percent=-1;
for (uint i=0; i<lines.length(); i++)
{
double progress_l=lines.length(), progress_ind=i;
double progress_percent_exact=progress_ind/progress_l*100;
int progress_percent=int(progress_percent_exact);
uint64 bytes_processed = uint64(progress_percent_exact/100.0*map_total_bytes);
if(key_pressed(KEY_SPACE)) speak(round(progress_percent_exact, 0)+" percent loaded");
if(key_pressed(KEY_1)) speak("Map size: "+map_total_readable);
if(key_pressed(KEY_2)) speak("Total processed: "+measure_file_size(bytes_processed));
if(key_pressed(KEY_3)) speak("Total remaining: "+measure_file_size(map_total_bytes - bytes_processed));
if(key_pressed(KEY_H)) speak(load_help);
if(key_pressed(KEY_ESCAPE))
{
if(loadsounds==1) mapload.stop();
speak("Map load canceled.");
clearmap();
return false;
}
if(loadbeeps == 1)
{
if(progress_percent>last_beep_percent && maploadtimer.elapsed>=loadtime)
{
if(speak_percentage==true) speak(progress_percent+" percent");
beep_percentage(progress_percent);
last_beep_percent=progress_percent;
maploadtimer.restart();
}
}
if(!instent_update)
{
wait(5);
}
else if(i % 100 == 0)
{
wait(0);
}
string normalized_line = string_replace(lines[i], "\t", " ", true);
int prev_length;
do {
prev_length = normalized_line.length();
normalized_line = string_replace(normalized_line, "  ", " ", true);
} while (int(normalized_line.length()) < prev_length);
normalized_line = string_trim_sides(normalized_line);
string[] sd=string_split(normalized_line, " ", true);
if(sd[0]=="minx" && sd.length()==2)
{
minx=stn(sd[1]);
}
else if(sd[0]=="maxx" && sd.length()==2)
{
maxx=stn(sd[1]);
}
else if(sd[0]=="miny" && sd.length()==2)
{
miny=stn(sd[1]);
}
else if(sd[0]=="maxy" && sd.length()==2)
{
maxy=stn(sd[1]);
}
else if(sd[0]=="minz" && sd.length()==2)
{
minz=stn(sd[1]);
}
else if(sd[0]=="maxz" && sd.length()==2)
{
maxz=stn(sd[1]);
}
else if(sd[0]=="mode" && sd.length()==2)
{
mapmode=sd[1];
}
else dispatch_entity_line(sd);
cammable = true;
hookable = true;
jumpable = true;
moveable = true;
pauseable = true;
quittable=true;
speedable = true;
spiable=true;
turnable = true;
}
if(mapmode == "")
{
if(loadsounds==1) mapload.stop();
dlg("Error: Map is missing the 'mode' field in data/main.sif. Add a line like 'mode 2d' (or topdown, or 3d) and try again.");
clearmap();
return false;
}
apply_map_pool();
if (force_spawned)
{
if (last_spawnpoint !is null)
{
me.x = last_spawnpoint.spawnx;
me.y = last_spawnpoint.spawny;
me.z = (mapmode == "3d") ? last_spawnpoint.spawnz : 0;
}
else if (spawnpoints.length() > 0)
{
me.x = spawnpoints[0].spawnx;
me.y = spawnpoints[0].spawny;
me.z = (mapmode == "3d") ? spawnpoints[0].spawnz : 0;
}
else
{
me.x = (0 < minx) ? minx : ((0 > maxx) ? maxx : 0);
me.y = (0 < miny) ? miny : ((0 > maxy) ? maxy : 0);
me.z = (mapmode == "3d") ? ((0 < minz) ? minz : ((0 > maxz) ? maxz : 0)) : 0;
}
fallcounter = 0;
jumping = 0;
falling = false;
}
if(loadsounds==1) mapload.stop();
if(loadsounds==1) mpool.play_stationary(get_pack_sound("main/characters/"+chartype+"/map/*stop*"),false);
if(loadbeeps == 1 && last_beep_percent<100)
{
if(speak_percentage==true) speak("100 "+"percent");
if(loadbeeps == 1) beep_percentage(100);
}
if(anounce_mapload==true) speak("map loded.");
return true;
}
