// Base URL of the map server (the dev's VPS). Downloads fetch the index at
// <map_server_url>/index.txt and each pack at <map_server_url>/maps/<name>.map.
string map_server_url = "http://reality-breaker-studios.net";
// Uploads: map_upload_token MUST match the server's UPLOAD_TOKEN or every upload is rejected.
string map_upload_token = "vIOmjLLpBhn2J6aLoDcAVL8jNfY9e6nLVbYyEzwov8onZCa7McywBa78BzDzzgbJs3RAxmRlW3VRvy0T6j36zXtnWCjWpfQt0EIUWsqxjWhYlRQqP7vScI8Ptm1ChYPOCPgfZCsbLWr6fcdzlY0K10DGNA";

int64 map_upload_max = int64(2) * 1024 * 1024 * 1024; // 2 GB, matches the server's cap

// Phase-1 map downloader: fetch the map server's index, then loop a menu so the
// player can download one map after another into the compiled-maps folder (where
// they appear under load map, then compiled maps). Overwriting an existing copy
// asks first; escape or back exits. Modeled on compile_map/decompile_map's loop.

void download_map()
{
string index = url_get(map_server_url + "/index.txt");
if(index == "" || string_contains(index, "<!DOCTYPE", 1) > -1)
{
alert("Error", "Could not reach the map server. Please check your internet connection and try again.");
return;
}
string[] maps = clean_lines_from_text(index);
if(maps.length() == 0)
{
alert("No maps", "There are no maps available to download right now.");
return;
}
while(true)
{
setupmenu();
for(uint i = 0; i < maps.length(); i++)
{
string[] parts = string_split(maps[i], "|", true);
string fname = parts[0];
string display = fname;
if(parts.length() >= 3)
display = fname + ", " + parts[1] + " map, total size, " + measure_file_size(int64(string_to_number(parts[2])));
m.add_item(display, fname);
}
m.add_item("back", "back");
m.intro_text = "Choose a map to download";
int res = m.run();
if(res < 0)
{
speak("canceled");
return;
}
string choice = m.selected_item_id;
if(choice == "back")
{
speak("canceled");
return;
}
// The index carries bare map names (no .map); re-append it, tolerating either form.
string fileword = choice;
if(fileword.length() < 4 || fileword.substr(fileword.length() - 4) != ".map") fileword += ".map";
if(!directory_exists("data/builder/maps/compiled"))
directory_create("data/builder/maps/compiled");
string local = "data/builder/maps/compiled/" + fileword;
if(file_exists(local))
{
setupmenu();
m.add_item("yes");
m.add_item("no");
m.intro_text = "This map already exists. Do you want to overwrite it?";
int conf = m.run();
if(conf != 0)
{
speak("canceled");
continue;
}
}
string result = dl_file(map_server_url + "/maps/public/" + fileword, local);
if(result != "finished")
{
if(result == "canceled" && file_exists(local)) file_delete(local);
alert("Download failed", "The map could not be downloaded.");
continue;
}
// A missing file on the server still "downloads" (the server's 404 page lands in
// the file), so confirm it's a real map pack before calling it a success; if not,
// bin the junk and report it rather than leaving an unplayable file behind.
if(read_map_mode_compiled(local) == "")
{
if(file_exists(local)) file_delete(local);
alert("Download failed", "That map isn't available on the server right now.");
continue;
}
alert("Download complete", fileword + " has been downloaded. You can now play it from the compiled maps menu.");
}
}

// Upload a compiled map to the server's pending folder for the dev to review.
// Mirrors the download menu: lists your compiled maps (name, mode, size), pick
// one, and it uploads with the same live progress screen. The map lands in
// pending and appears in the download list only once the dev approves it.
void upload_map()
{
string[] maps = find_files("data/builder/maps/compiled/*.map");
if(maps.length() == 0)
{
alert("No maps", "You have no compiled maps to upload. Compile a map first.");
return;
}
while(true)
{
setupmenu();
for(uint i = 0; i < maps.length(); i++)
{
string mpath = "data/builder/maps/compiled/" + maps[i];
string base = string_replace(maps[i], ".map", "", true);
string mode = read_map_mode_compiled(mpath);
int64 bytes = file_get_size(mpath);
m.add_item(base + ", " + mode + " map, total size, " + measure_file_size(bytes), maps[i]);
}
m.add_item("back", "back");
m.intro_text = "Choose a map to upload";
int res = m.run();
if(res < 0) { speak("canceled"); return; }
string choice = m.selected_item_id;
if(choice == "back") { speak("canceled"); return; }
string local = "data/builder/maps/compiled/" + choice;
if(file_get_size(local) > map_upload_max)
{
alert("Too large", "That map is larger than the 2 GB upload limit, so it can't be uploaded.");
continue;
}
string mode = read_map_mode_compiled(local);
string result = ul_file(map_server_url + "/upload?token=" + map_upload_token + "&name=" + choice + "&mode=" + mode, local);
if(result == "finished")
alert("Upload complete", choice + " has been submitted. It will appear in the download list once it has been approved.");
else if(result == "toobig")
alert("Upload failed", "That map is larger than the server allows.");
else if(result == "token")
alert("Upload failed", "The server did not accept the upload. Please try again later.");
else if(result == "canceled")
speak("canceled");
else
alert("Upload failed", "The map could not be uploaded. Please check your internet connection and try again.");
}
}
