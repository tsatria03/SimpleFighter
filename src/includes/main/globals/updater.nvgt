// Base URL of the map server (the dev's VPS). Downloads fetch the index at
// <map_server_url>/index.txt and each pack at <map_server_url>/maps/<name>.map.
string map_server_url = "http://reality-breaker-studios.net";

bool check_for_updates(string old_version, string projectname, bool precheck = false)
{
if (precheck)
{
speak("Checking for updates...");
wait(1000);
}
string version_url = "https://tsatria03.github.io/projects/games/" + projectname + "/version.txt";
string new_version = url_get(version_url);
if (new_version == "" || string_contains(new_version, "<!DOCTYPE", 1) > -1)
{
alert("Error", "Could not check for updates at this time.");
return false;
}
if (!is_newer_version(old_version, new_version))
{
if (precheck)
alert("No updates available", "You already have the latest version of the game!");
return false;
}
int response = question("Update Available", "A new version of " + projectname + " is available. Your version: " + old_version + ". Latest version: " + new_version + ". Would you like to download it now?");
if (response != 1)
{
return false;
}
wait(500);
string url = get_download_url(projectname, new_version);
string filename = get_disk_filename(url);
string bare_name = strip_extension(strip_directory(filename));
if (!file_exists(filename))
{
string test_file = filename + ".test";
if (!file_put_contents(test_file, "test"))
{
wait(500);
int choice = question("Permission Denied", "This update can't be downloaded to this directory because it's write-protected. Would you like to download this file to your Downloads folder instead?");
if (choice != 1)
{
speak("Update canceled.");
return false;
}
string downloads_folder = get_downloads_folder();
filename = downloads_folder + strip_directory(filename);
}
else
{
file_delete(test_file);
}
wait(500);
string result = dl_file(url, filename);
if (result != "finished")
{
if (result == "canceled" && file_exists(filename)) file_delete(filename);
alert("Download Failed", "The update could not be downloaded.");
return false;
}
}
else
{
wait(500);
alert("Notice", "The update file already exists. Skipping download.");
}
wait(500);
setupmenu(false);
m.add_item("Extract file", "extract");
m.add_item("Cancel", "cancel");
m.intro_text = "The update has been downloaded. What would you like to do with " + bare_name + "?";
int mres = m.run();
string choice = m.selected_item_id;
if (mres < 0 || choice == "cancel")
{
speak("Canceled");
return false;
}
if (choice == "extract")
{
wait(500);
speak("Extracting update...");
wait(1000);
bool success = run("lib/7zr.exe", "x \"" + filename + "\" -pSpfBuilder -aoa -y", true, true);
if (success)
{
if (file_exists(filename)) file_delete(filename);
alert("Update Complete", "The update has been successfully extracted to the sf folder. Please run the new version of the game to continue.");
exit();
}
else
{
alert("Extraction Failed", "Failed to extract the archive.");
}
}
return true;
}

string get_download_url(string projectname, string new_version)
{
string base = "https://github.com/tsatria03/" + projectname + "/releases/download/V" + new_version+"0";
return base + "/SimpleFighter_windows_portable_password_is_SpfBuilder.7z";
}

void downloadsounds()
{
quest=question("Error", "There are no sounds detected in the game! Would you like to download them now?");
if (quest != 1)
{
return;
}
if (file_exists("sounds.7z"))
{
alert("file found", "This file already exists. The downloader will now skip to the extraction process.");
}
else
{
string result=dl_file("https://github.com/tsatria03/SimpleFighter/releases/download/V"+version+"0/sounds.7z", "sounds.7z");
if (result != "finished")
{
alert("download error", "Download failed or was canceled.");
if(file_exists("sounds.7z")) file_delete("sounds.7z");
return;
}
alert("finished", "Download completed successfully.");
}
alert("extracting", "Extracting files.");
progs.load_url("https://tsatria03.github.io/projects/games/SimpleFighter/sounds/pi2.ogg");
progs.play_looped();
if(!directory_exists("sounds")) directory_create("sounds");
bool extr=run("lib/7zr.exe", "x sounds.7z -o\"sounds\" -y", true, true);
if (extr)
{
progs.stop();
alert("extraction_complete", "Extraction finished successfully.");
if(file_exists("sounds.7z")) file_delete("sounds.7z");
alert("restarting", "The game will now restart to apply changes.");
restart("sf.exe");
return;
}
alert("extraction_error", "Error occurred during extraction.");
return;
}

// Phase-1 map downloader: fetch the map server's index, then loop a menu so the
// player can download one map after another into the compiled-maps folder (where
// they appear under load map, then compiled maps). Overwriting an existing copy
// asks first; escape or back exits. Modeled on compile_map/decompile_map's loop.
void download_map()
{
string index = url_get(map_server_url + "/index.txt");
if(index == "" || string_contains(index, "<!DOCTYPE", 1) > -1)
{
alert("Error", "Could not reach the map server. Please check your internet connection and try again.");
return;
}
string[] maps = clean_lines_from_text(index);
if(maps.length() == 0)
{
alert("No maps", "There are no maps available to download right now.");
return;
}
while(true)
{
setupmenu();
for(uint i = 0; i < maps.length(); i++)
{
string[] parts = string_split(maps[i], "|", true);
string fname = parts[0];
string display = fname;
if(parts.length() >= 3)
display = fname + ", " + parts[1] + " map, total size, " + measure_file_size(parse_int(parts[2]));
m.add_item(display, fname);
}
m.add_item("back", "back");
m.intro_text = "Choose a map to download";
int res = m.run();
if(res < 0)
{
speak("canceled");
return;
}
string choice = m.selected_item_id;
if(choice == "back")
{
speak("canceled");
return;
}
// The index carries bare map names (no .map); re-append it, tolerating either form.
string fileword = choice;
if(fileword.length() < 4 || fileword.substr(fileword.length() - 4) != ".map") fileword += ".map";
if(!directory_exists("data/builder/maps/compiled"))
directory_create("data/builder/maps/compiled");
string local = "data/builder/maps/compiled/" + fileword;
if(file_exists(local))
{
setupmenu();
m.add_item("yes");
m.add_item("no");
m.intro_text = "This map already exists. Do you want to overwrite it?";
int conf = m.run();
if(conf != 0)
{
speak("canceled");
continue;
}
}
string result = dl_file(map_server_url + "/maps/" + fileword, local);
if(result != "finished")
{
if(result == "canceled" && file_exists(local)) file_delete(local);
alert("Download failed", "The map could not be downloaded.");
continue;
}
// A missing file on the server still "downloads" (the server's 404 page lands in
// the file), so confirm it's a real map pack before calling it a success; if not,
// bin the junk and report it rather than leaving an unplayable file behind.
if(read_map_mode_compiled(local) == "")
{
if(file_exists(local)) file_delete(local);
alert("Download failed", "That map isn't available on the server right now.");
continue;
}
alert("Download complete", fileword + " has been downloaded. You can now play it from the compiled maps menu.");
}
}
