/* Find the next double quote at or after start that is NOT escaped with a
preceding backslash, so a \" inside a field's text is skipped rather than
treated as the field delimiter. Returns -1 if none remain. */
int find_unescaped_quote(const string&in source, int start)
{
int p = start;
while(true)
{
int q = source.find_first_of("\"", p);
if(q == -1) return -1;
if(q == 0 or source.substr(q - 1, 1) != "\\") return q;
p = q + 1;
}
return -1;
}
array<string> extract_quoted(const string&in source, string&out remainder)
{
array<string> fields;
int pos = 0;
while(true)
{
int q1 = find_unescaped_quote(source, pos);
if(q1 == -1) break;
int q2 = find_unescaped_quote(source, q1 + 1);
if(q2 == -1) break;
string field = source.substr(q1 + 1, q2 - q1 - 1);
field = string_replace(field, "\\\"", "\"", true);
fields.insert_last(field);
pos = q2 + 1;
}
remainder = source.substr(pos);
return fields;
}
/* Escape every double quote in a text field as \" so it can be written inside a
quoted field on disk without ending it; extract_quoted reverses this on read.
Used in place of stripping quotes when a field (e.g. a slash command) may legitimately
contain them, such as a command that spawns or builds another quoted-text entity. */
string escape_quotes(string s)
{
return string_replace(s, "\"", "\\\"", true);
}
bool string_starts_with(const string& in str, const string& in start)
{
if (str.length()>=start.length())
{
return (str.substr(0, start.length()) == start);
}
return false;
}
bool string_ends_with(const string& in str,const string& in ending)
{
if (str.length()>=ending.length())
{
return (str.substr(str.length()-ending.length())==ending);
}
return false;
}
bool string_to_bool(string str)
{
return str.trim_whitespace().lower()=="true"? true:false;
}
// Map line-edit undo/redo. The stacks hold whole-file snapshots of main.sif and
// are tagged with the map they belong to, so switching maps auto-clears history
// without depending on clearmap() (which load_map calls on every reload/edit).
string[] map_undo_stack;
string[] map_redo_stack;
string map_undo_owner = "";
const uint MAP_UNDO_MAX = 50;
void map_undo_sync()
{
if(map_undo_owner != mapname)
{
map_undo_stack.resize(0);
map_redo_stack.resize(0);
map_undo_owner = mapname;
}
}
string read_map_main_sif()
{
file f;
f.open("data/builder/maps/decompiled/"+mapname+"/data/main.sif", "rb");
string data = f.read();
f.close();
return data;
}
void write_map_main_sif(string data)
{
file f;
f.open("data/builder/maps/decompiled/"+mapname+"/data/main.sif", "wb");
f.write(data);
f.close();
}
void push_map_undo()
{
map_undo_sync();
map_undo_stack.insert_last(read_map_main_sif());
if(map_undo_stack.length() > MAP_UNDO_MAX) map_undo_stack.remove_at(0);
map_redo_stack.resize(0);
}
bool map_undo()
{
map_undo_sync();
if(map_undo_stack.length() == 0) return false;
map_redo_stack.insert_last(read_map_main_sif());
uint last = map_undo_stack.length()-1;
string prev = map_undo_stack[last];
map_undo_stack.remove_at(last);
write_map_main_sif(prev);
return true;
}
bool map_redo()
{
map_undo_sync();
if(map_redo_stack.length() == 0) return false;
map_undo_stack.insert_last(read_map_main_sif());
uint last = map_redo_stack.length()-1;
string next = map_redo_stack[last];
map_redo_stack.remove_at(last);
write_map_main_sif(next);
return true;
}
bool validate_map_data(string[] raw_lines)
{
string[] lines;
uint[] _filter_origin;
filter_empty_lines(raw_lines, lines, _filter_origin);
bool has_minx = false, has_maxx = false, has_miny = false, has_maxy = false;
bool has_minz = false, has_maxz = false;
int mode_count = 0;
bool mode_valid = false;
string mode_val = "";
for (uint i = 0; i < lines.length(); i++)
{
string[] parts = string_split(lines[i], " ", true);
if (parts.length() < 2) continue;
string key = string_trim_sides(parts[0]);
if (key == "minx") has_minx = true;
if (key == "maxx") has_maxx = true;
if (key == "miny") has_miny = true;
if (key == "maxy") has_maxy = true;
if (key == "minz") has_minz = true;
if (key == "maxz") has_maxz = true;
if (key == "mode")
{
mode_count++;
mode_val = string_trim_sides(parts[1]);
if (mode_val == "2d" || mode_val == "topdown" || mode_val == "3d") mode_valid = true;
}
}
if (!(has_minx && has_maxx && has_miny && has_maxy && mode_count == 1 && mode_valid)) return false;
if (mode_val == "3d" && !(has_minz && has_maxz)) return false;
return true;
}
/* Map error reporting (Tier 1). Holds the most recent authoring-time error report so the errors
box can be re-shown with /maperrors, and builds/presents that box from formatted blocks. The blocks
are produced by the callers using entity_line_error() (map_parser.nvgt) as the validator. */
string map_error_report="";
string map_error_block(int line_no, string text, string reason, int col=-1)
{
string head = "line: "+line_no;
if(col>=0) head += " ("+col+")";
return head+"\r\ntext: "+text+"\r\nERROR: "+reason;
}
void show_map_error_box()
{
vd.info_box("Map errors", "Map errors", map_error_report);
}
void present_map_errors(string[] blocks)
{
if(blocks.length()==0) return;
string body="";
for(uint i=0; i<blocks.length(); i++)
{
if(i>0) body+="\r\n\r\n";
body+=blocks[i];
}
map_error_report=body;
show_map_error_box();
}
/* The /maperrors handler: re-scan the map you're currently on (however you got here — menu, reload,
travelpoint, door) and show its full error box, or speak that there are none. The command is gated
to decompiled maps in the parser, so this never runs on a compiled map. */
void show_last_map_errors()
{
string[] blocks = collect_map_file_errors(mapmode);
if(blocks.length()==0)
{
speak("There are no map errors to show.");
return;
}
present_map_errors(blocks);
}
int map_nonempty_line_count()
{
string[] all = delinear(read_map_main_sif());
string[] f;
uint[] o;
filter_empty_lines(all, f, o);
return int(f.length());
}
/* Validate one just-written map line (permit-but-warn): if it isn't a valid entity line for the
given mode, show the error box for it. line_no is its 1-based position among the map's non-empty
lines. Header lines (mode/bounds) are skipped — they aren't placeable objects. */
void report_single_map_line(string line, int line_no, string mode)
{
dictionary map_vars;
build_map_var_table(map_vars);   // no top-to-bottom context here, so use every defined variable
string resolved = substitute_map_variables(line, map_vars);
string[] sd = string_split(resolved, " ", true);
if(sd.length()==0) return;
if(line_is_map_header(sd)) return;
string undef = first_undefined_variable(resolved, map_vars);
if(undef != "")
{
string[] ublocks = {map_error_block(line_no, line, "the variable '"+undef+"' is not defined on an earlier line.", -1)};
present_map_errors(ublocks);
return;
}
int col=-1;
string reason = entity_line_error(sd, mode);
if(reason == "")
{
reason = entity_semantic_error(sd, mode, col);
if(reason == "") return;
}
string[] blocks = {map_error_block(line_no, line, reason, col)};
present_map_errors(blocks);
}
/* The build-menu forms (build_<entity>) append their line and reload but don't call
report_single_map_line themselves, so after a successful build we check the just-appended last
line here. Called centrally from buildobj, only when the map actually grew by a line. */
void report_last_built_line()
{
string[] all = delinear(read_map_main_sif());
string[] f;
uint[] o;
filter_empty_lines(all, f, o);
if(f.length()==0) return;
report_single_map_line(f[f.length()-1], int(f.length()), mapmode);
}
/* Scan every entity line of the current map file and return one error block per line that won't
load (unrecognized object or wrong value count). Line numbers are the 1-based position among
non-empty lines, matching the edit a line menu; header lines are skipped. Shared by the whole-map
report (load/reload/paste) and the /maperrors on-demand check. */
string[] collect_map_file_errors(string mode)
{
string[] blocks;
string[] all = delinear(read_map_main_sif());
string[] filtered;
uint[] orig;
filter_empty_lines(all, filtered, orig);
dictionary map_vars;   // map variables defined so far, top to bottom (define-above-use)
for(uint i=0; i<filtered.length(); i++)
{
// Resolve every $name defined on an earlier line before validating, so a variable reference in a
// numeric field doesn't false-flag; the report block still shows the original text.
string resolved = substitute_map_variables(filtered[i], map_vars);
string[] sd = string_split(resolved, " ", true);
if(sd.length()==0) continue;
if(line_is_map_header(sd)) continue;
string undef = first_undefined_variable(resolved, map_vars);
if(undef != "")
{
blocks.insert_last(map_error_block(int(i+1), filtered[i], "the variable '"+undef+"' is not defined on an earlier line.", -1));
continue;
}
int col=-1;
string reason = entity_line_error(sd, mode);
if(reason == "")
{
reason = entity_semantic_error(sd, mode, col);
if(reason == "")
{
if(sd[0]=="mapvar") map_vars.set(sd[1], freeze_map_variable_value(sd[2]));   // clean definition: record for lines below
continue;
}
}
blocks.insert_last(map_error_block(int(i+1), filtered[i], reason, col));
}
return blocks;
}
/* Validate the whole current map and show the collected error box for all lines that won't load.
Used after a whole-map paste and on map load/reload. */
void report_map_file_errors(string mode)
{
present_map_errors(collect_map_file_errors(mode));
}
/* The removal counterpart to /build: delete one entity's line from the current map's main.sif and
reload. type is the normalized on-disk keyword. by_coord false removes the LAST line of that type
(newest, LIFO); true removes the one whose placement corner matches gx,gy[,gz] -- a single-tile
entity's x,y[,z] or a ranged entity's minx,miny[,minz] -- with the newest winning an exact-corner
tie. Header lines (mode/bounds) are skipped so they can never be removed. push_map_undo() first so
/undomap recovers it. Returns true if a line was removed. Decompiled maps only (callers gate that). */
bool unbuild_entity(string type, bool by_coord, double gx, double gy, double gz)
{
string[] lines = delinear(read_map_main_sif());
int target = -1;
for(uint i=0; i<lines.length(); i++)
{
string[] t = string_split(lines[i], " ", true);
if(t.length() < 1) continue;
if(line_is_map_header(t)) continue;
if(t[0] != type) continue;
if(!by_coord) { target = int(i); continue; }
if(t.length() < 3) continue;
bool single = (stn(t[1]) == gx && stn(t[2]) == gy);
bool ranged = (t.length() > 3 && stn(t[1]) == gx && stn(t[3]) == gy);
if(mapmode == "3d")
{
if(single) single = (t.length() > 3 && stn(t[3]) == gz);
if(ranged) ranged = (t.length() > 5 && stn(t[5]) == gz);
}
if(single || ranged) target = int(i);
}
if(target < 0) return false;
lines.remove_at(target);
string joined;
for(uint i=0; i<lines.length(); i++)
{
if(i > 0) joined += "\r\n";
joined += lines[i];
}
push_map_undo();
write_map_main_sif(joined);
bump_map_modified();
load_map(mapname, mapowner);
return true;
}

float stn(string str)
{
if (string_contains(str,"random",1)>-1)
{
string a=string_replace(str,"random(","",true);
a=string_replace(a,")","",true);
string[] b=string_split(a,",",true);
double c=0;
c=random(string_to_number(b[0]),string_to_number(b[1]));
return c;
}
else
return string_to_number(str);
}

string expand_random_tokens(string str)
{
int start = 0;
while(true)
{
int idx = str.find("random(", start);
if(idx < 0) break;
int close = str.find(")", idx + 7);
if(close < 0) break;
string inner = str.substr(idx + 7, close - (idx + 7));
int comma = inner.find(",");
if(comma < 0) { start = close + 1; continue; }
string lo_str = string_trim_sides(inner.substr(0, comma));
string hi_str = string_trim_sides(inner.substr(comma + 1, int(inner.length()) - comma - 1));
int lo = string_to_number(lo_str);
int hi = string_to_number(hi_str);
int rolled = random(lo, hi);
string replacement = "" + rolled;
str = str.substr(0, idx) + replacement + str.substr(close + 1, int(str.length()) - close - 1);
start = idx + int(replacement.length());
}
return str;
}

/* Universal state tokens, resolved for every command at execution time inside comparse -- the text
counterpart to random(). They let any command (most usefully speak) read back the player's live stats
and position, e.g. "speak %health% of %maxhealth%, %healthpc% percent". Because comparse runs each
stacked step in turn, a token reads the value AFTER an earlier step in the same stack changed it, so
"setx 50;speak %x%" says 50. Longer names are replaced before the ones they contain so no token
clobbers another, and the percentages match the statistics screen's two-decimal rounding. */
string expand_state_tokens(string cmd)
{
if(cmd.find("%") < 0) return cmd;
cmd = string_replace(cmd, "%maxhealth%", ""+maxhealth, true);
cmd = string_replace(cmd, "%healthpc%", ""+round(health/maxhealth*100, 2), true);
cmd = string_replace(cmd, "%health%", ""+health, true);
cmd = string_replace(cmd, "%maxstam%", ""+maxstamina, true);
cmd = string_replace(cmd, "%stampc%", ""+round(stamina/maxstamina*100, 2), true);
cmd = string_replace(cmd, "%stam%", ""+stamina, true);
cmd = string_replace(cmd, "%level%", ""+level, true);
int xpleft_val = xprequiered - xp;
if(xpleft_val < 0) xpleft_val = 0;
cmd = string_replace(cmd, "%xpneeded%", ""+xprequiered, true);
cmd = string_replace(cmd, "%xpleft%", ""+xpleft_val, true);
cmd = string_replace(cmd, "%xp%", ""+xp, true);
cmd = string_replace(cmd, "%points%", ""+points, true);
cmd = string_replace(cmd, "%lives%", ""+lifecard, true);
cmd = string_replace(cmd, "%kills%", ""+kills, true);
cmd = string_replace(cmd, "%speed%", ""+modspeed, true);
cmd = string_replace(cmd, "%jump%", ""+jumpheight, true);
cmd = string_replace(cmd, "%minx%", ""+minx, true);
cmd = string_replace(cmd, "%maxx%", ""+maxx, true);
cmd = string_replace(cmd, "%miny%", ""+miny, true);
cmd = string_replace(cmd, "%maxy%", ""+maxy, true);
cmd = string_replace(cmd, "%minz%", ""+minz, true);
cmd = string_replace(cmd, "%maxz%", ""+maxz, true);
cmd = string_replace(cmd, "%x%", ""+me.x, true);
cmd = string_replace(cmd, "%y%", ""+me.y, true);
cmd = string_replace(cmd, "%z%", ""+me.z, true);
return cmd;
}

/* Shared by the text_input and menu_input builder entities: substitutes the input's captured value
into an author-written command right before it is handed to comstack(). %answer% is the text a text
input captured, %choice% the label a menu input picked, %index% that choice's 0-based position.
%attempt% and %attempts% are text-input-only: the number of the try just made and the tries left after
it; they are only substituted when a non-negative count is passed, so menu calls (which omit them) are
unaffected. The semicolon is stripped from %answer% because it is player-typed and comstack splits on
";", so an unstripped answer could break the author's command out into a second stacked command. The
other tokens come from author-defined data or the engine, so they need no stripping. */
string expand_input_tokens(string cmd, string answer, string choice, int index, int attempt = -1, int attempts_left = -1)
{
answer = string_replace(answer, ";", "", true);
cmd = string_replace(cmd, "%answer%", answer, true);
cmd = string_replace(cmd, "%choice%", choice, true);
cmd = string_replace(cmd, "%index%", "" + index, true);
if(attempt >= 0) cmd = string_replace(cmd, "%attempt%", "" + attempt, true);
if(attempts_left >= 0) cmd = string_replace(cmd, "%attempts%", "" + attempts_left, true);
return cmd;
}

/* Substitutes the map timer's time tokens into a command. remaining is whole seconds left.
Plural tokens are the whole remaining time in that unit; singular tokens are the remainder
after the next-bigger unit is removed (a clock breakdown). %hour% equals %hours% since hours
is the largest unit. The closing % on every token keeps them independent, so replacement
order doesn't matter (the same reason %attempt% and %attempts% coexist above). */
string expand_time_tokens(string cmd, int remaining)
{
if(remaining < 0) remaining = 0;
int total_seconds = remaining;
int total_minutes = remaining / 60;
int total_hours = remaining / 3600;
int rem_seconds = remaining % 60;
int rem_minutes = (remaining / 60) % 60;
int rem_hours = remaining / 3600;
cmd = string_replace(cmd, "%seconds%", "" + total_seconds, true);
cmd = string_replace(cmd, "%second%", "" + rem_seconds, true);
cmd = string_replace(cmd, "%minutes%", "" + total_minutes, true);
cmd = string_replace(cmd, "%minute%", "" + rem_minutes, true);
cmd = string_replace(cmd, "%hours%", "" + total_hours, true);
cmd = string_replace(cmd, "%hour%", "" + rem_hours, true);
return cmd;
}

string join_string_array(string[] arr, uint start, uint end)
{
string result = "";
for(uint i = start; i < end; i++)
{
if(i>start) result+=" ";
result+=arr[i];
}
return result;
}
bool map_exists(string mn)
{
if(string_ends_with(mn, ".sif")) mn = string_replace(mn, ".sif", "", true);
if(string_ends_with(mn, ".map")) mn = string_replace(mn, ".map", "", true);
return file_exists("data/builder/maps/decompiled/" + mn + "/data/main.sif") || file_exists("data/builder/maps/compiled/" + mn + ".map");
}
string gmt(double x, double y)
{
string mt;
for(uint i=0; i<platforms.length(); i++)
{
if(@platforms[i] == null) continue;
if(platforms[i].minx<=x and platforms[i].maxx>=x and platforms[i].miny<=y and platforms[i].maxy>=y)
{
mt=platforms[i].tile;
tilevolume=platforms[i].volume;
tilepitch=platforms[i].pitch;
}
}
for(uint i=0; i<walls.length(); i++)
{
if(@walls[i] == null) continue;
if(walls[i].minx<=x and walls[i].maxx>=x and walls[i].miny<=y and walls[i].maxy>=y)
{
wallvolume=walls[i].volume;
wallpitch=walls[i].pitch;
}
}
return mt;
}
string gmt(double x, double y, double z)
{
string mt;
for(uint i=0; i<platforms.length(); i++)
{
if(@platforms[i] == null) continue;
if(platforms[i].minx<=x and platforms[i].maxx>=x and platforms[i].miny<=y and platforms[i].maxy>=y)
{
if(mapmode == "3d" and platforms[i].z != z) continue;
mt=platforms[i].tile;
tilevolume=platforms[i].volume;
tilepitch=platforms[i].pitch;
}
}
for(uint i=0; i<walls.length(); i++)
{
if(@walls[i] == null) continue;
if(walls[i].minx<=x and walls[i].maxx>=x and walls[i].miny<=y and walls[i].maxy>=y)
{
if(mapmode == "3d" and (z < walls[i].minz or z > walls[i].maxz)) continue;
wallvolume=walls[i].volume;
wallpitch=walls[i].pitch;
}
}
return mt;
}
string gct(double x, double y)
{
string ct;
for(uint i=0; i<platforms.length(); i++)
{
if(@platforms[i] == null) continue;
if(platforms[i].minx<=x and platforms[i].maxx>=x and platforms[i].miny<=y and platforms[i].maxy>=y)
{
ct=platforms[i].tile;
}
}
return ct;
}
string gct(double x, double y, double z)
{
string ct;
for(uint i=0; i<platforms.length(); i++)
{
if(@platforms[i] == null) continue;
if(platforms[i].minx<=x and platforms[i].maxx>=x and platforms[i].miny<=y and platforms[i].maxy>=y)
{
if(mapmode == "3d" and platforms[i].z != z) continue;
ct=platforms[i].tile;
}
}
return ct;
}

string[] delinear(string a)
{
a = string_replace(a, "\r\n", "\n", true);
a = string_replace(a, "\r", "\n", true);
return string_split(a, "\n", false);
}
string linear(string[] a)
{
string final;
for(uint i=0; i<a.length(); i++)
{
final+=(a[i]+"\r\n");
}
return final;
}

string normalize_buildtype(string buildtype)
{
if(buildtype == "aircraft_beacon") return "airbeacon";
else if(buildtype == "aircraft_turbulence") return "air_turbulence";
else if(buildtype == "conveyor_belt") return "belt";
else if(buildtype == "elevator_floor") return "el_floor";
else if(buildtype == "moving_platform") return "mplatform";
else if(buildtype == "character_blocker") return "chblocker";
else if(buildtype == "command_blocker") return "cblocker";
else if(buildtype == "tts_enemie") return "ttsenemie";
else if(buildtype == "moving_hazard") return "mhazard";
else if(buildtype == "security_camera") return "camera";
else if(buildtype == "map_variable") return "mapvar";
else if(buildtype == "item_door") return "door";
else if(buildtype == "item_passage") return "passage";
return buildtype;
}

string utc_iso8601_now()
{
timestamp t;
t.update();
return t.format(DATE_TIME_FORMAT_ISO8601, 0);
}

class map_meta
{
string owner;
string description;
string created_date;
string modified_date;
map_meta()
{
owner = "noone";
description = "";
created_date = "";
modified_date = "";
}
}
map_meta@ parse_map_meta(string meta_text)
{
map_meta@ result = map_meta();
string[] lines = split_lines(meta_text);
for (uint i = 0; i < lines.length(); i++)
{
string line = lines[i];
int eq = string_find(line, "=");
if (eq < 0) continue;
string key = string_trim_sides(line.substr(0, eq));
string value = string_trim_sides(line.substr(eq + 1));
if (key == "owner") result.owner = value;
else if (key == "description") result.description = strip_quotes(value);
else if (key == "created date") result.created_date = value;
else if (key == "modified date") result.modified_date = value;
}
return result;
}
void bump_map_modified(string map_name = "")
{
if (map_name == "") map_name = mapname;
if (map_name == "") return;
string now = utc_iso8601_now();
map_meta@ meta = read_map_meta_decompiled(map_name);
if (meta.created_date == "") meta.created_date = now;
meta.modified_date = now;
string path = "data/builder/maps/decompiled/" + map_name + "/data/meta.sif";
file f;
if (!f.open(path, "wb")) return;
f.write("owner=" + meta.owner + "\r\n" +
"description=" + quote_value(meta.description) + "\r\n" +
"created date=" + meta.created_date + "\r\n" +
"modified date=" + meta.modified_date + "\r\n");
f.close();
}
int fixup_travelpoint_destmaps(string old_name, string new_name)
{
int touched = 0;
string[] maps = find_directories("data/builder/maps/decompiled/*");
for (uint i = 0; i < maps.length(); i++)
{
string path = "data/builder/maps/decompiled/" + maps[i] + "/data/main.sif";
if (!file_exists(path)) continue;
file f;
if (!f.open(path, "rb")) continue;
string text = f.read();
f.close();
string[] lines = delinear(text);
bool changed = false;
for (uint j = 0; j < lines.length(); j++)
{
string[] sd = string_split(lines[j], " ", true);
if (sd.length() < 1 || sd[0] != "travelpoint") continue;
int destmap_idx = (sd.length() == 12) ? 7 : 5;
if (destmap_idx >= int(sd.length())) continue;
string dm = sd[destmap_idx];
string dm_bare = dm;
bool had_map_suffix = false;
if (string_ends_with(dm, ".map"))
{
dm_bare = string_replace(dm, ".map", "", true);
had_map_suffix = true;
}
if (dm_bare == old_name)
{
sd[destmap_idx] = had_map_suffix ? (new_name + ".map") : new_name;
lines[j] = string_join(sd, " ");
changed = true;
}
}
if (!changed) continue;
string rewritten;
for (uint j = 0; j < lines.length(); j++)
{
if (j > 0) rewritten += "\r\n";
rewritten += lines[j];
}
file fw;
if (!fw.open(path, "wb")) continue;
fw.write(rewritten);
fw.close();
bump_map_modified(maps[i]);
touched++;
}
return touched;
}

bool write_map_meta(string map_name, map_meta@ meta)
{
if (map_name == "") return false;
string now = utc_iso8601_now();
if (meta.created_date == "") meta.created_date = now;
meta.modified_date = now;
string path = "data/builder/maps/decompiled/" + map_name + "/data/meta.sif";
file f;
if (!f.open(path, "wb")) return false;
f.write("owner=" + meta.owner + "\r\n" +
"description=" + quote_value(meta.description) + "\r\n" +
"created date=" + meta.created_date + "\r\n" +
"modified date=" + meta.modified_date + "\r\n");
f.close();
return true;
}

map_meta@ read_map_meta_decompiled(string map_name)
{
string path = "data/builder/maps/decompiled/" + map_name + "/data/meta.sif";
if (!file_exists(path)) return map_meta();
file f;
if (!f.open(path, "rb")) return map_meta();
string text = f.read();
f.close();
return parse_map_meta(text);
}

map_meta@ read_map_meta_compiled(string map_path)
{
pack preview_pack;
if (!preview_pack.open(map_path, PACK_OPEN_MODE_READ)) return map_meta();
string text = "";
if (preview_pack.file_exists("data/meta.sif"))
{
uint size = preview_pack.get_file_size("data/meta.sif");
text = preview_pack.read_file("data/meta.sif", 0, size);
}
preview_pack.close();
return parse_map_meta(text);
}

bool line_has_block_close(string line)
{
return string_find(line, "*/") >= 0 || string_find(line, "*#") >= 0 || string_find(line, "*;") >= 0;
}
bool line_opens_block_comment(string trimmed)
{
return string_starts_with(trimmed, "/*") || string_starts_with(trimmed, "#*") || string_starts_with(trimmed, ";*");
}
void filter_empty_lines(string[] lines, string[]& filtered_lines, uint[]& original_lines)
{
filtered_lines.resize(0);
original_lines.resize(0);
bool in_block = false;
for (uint i=0; i<lines.length(); i++)
{
if (lines[i].length()==0) continue;
if (in_block)
{
if (line_has_block_close(lines[i])) in_block = false;
continue;
}
string trimmed = string_trim_sides(lines[i]);
if (trimmed.length()==0) continue;
if (string_starts_with(trimmed, "//")) continue;
if (line_opens_block_comment(trimmed))
{
if (!line_has_block_close(lines[i])) in_block = true;
continue;
}
if (string_starts_with(trimmed, "#") || string_starts_with(trimmed, ";")) continue;
filtered_lines.insert_last(lines[i]);
original_lines.insert_last(i);
}
}
