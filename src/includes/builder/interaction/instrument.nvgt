/* Note keys in physical keyboard order. Position i drives note index i+1: the digit row plays notes
1-10, the top letter row 11-20, the home row 21-29, and the bottom row 30-36. Shared by every instrument. */

int[] note_keys = {
	KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9, KEY_0,
	KEY_Q, KEY_W, KEY_E, KEY_R, KEY_T, KEY_Y, KEY_U, KEY_I, KEY_O, KEY_P,
	KEY_A, KEY_S, KEY_D, KEY_F, KEY_G, KEY_H, KEY_J, KEY_K, KEY_L,
	KEY_Z, KEY_X, KEY_C, KEY_V, KEY_B, KEY_N, KEY_M
};

sound_pool instpool;
instrument@[] instruments(0);

class instrument
{
	bool is_ranged;                      // false = a single tile, true = a rectangular area
	double minx, maxx, miny, maxy;       // the tile or area the player stands on to play
	double minz, maxz;
	int instcad = 1;                     // 1 = pianos, 2 = drums, 3 = others
	int overlap = 0;                     // 0 = cut the previous note, 1 = let notes ring together
	int staccato = 0;                    // 1 = cut a note when its key is released
	int pitchable = 1;                   // whether the pitch bend is allowed
	int pitchtime = 50;                  // milliseconds between pitch-bend steps
	int pianoslot, drumslot, otherslot;  // the currently ringing note for each category
	double pitch = 100;
	string piano = "classical grand";
	string drum = "acoustic";
	string other = "acoustic guitar";
	timer pitchtimer;

	instrument(double mnx, double mxx, double mny, double mxy, double mnz=0, double mxz=0, bool rng=false)
	{
		minx=mnx;
		maxx=mxx;
		miny=mny;
		maxy=mxy;
		minz=mnz;
		maxz=mxz;
		is_ranged=rng;
	}

	// Per-frame input handling for this instrument.
	void update()
	{
		if(key_repeating(KEY_TAB)) cycle_category();
		if(key_repeating(KEY_LEFT)) cycle_instrument(1);
		if(key_repeating(KEY_RIGHT)) cycle_instrument(2);
		if(key_pressed(KEY_RETURN)) toggle_overlap();
		if(key_pressed(KEY_BACKSLASH)) toggle_staccato();
		if(key_down(KEY_UP) and pitchable==1 and pitch!=160 and pitchtimer.elapsed>=pitchtime) bend_pitch(1);
		if(key_released(KEY_UP)) reset_pitch();
		if(key_down(KEY_DOWN) and pitchable==1 and pitch!=40 and pitchtimer.elapsed>=pitchtime) bend_pitch(-1);
		if(key_released(KEY_DOWN)) reset_pitch();
		for(uint i=0; i<note_keys.length(); i++)
		{
			if(key_pressed(note_keys[i])) play_note(i+1);
			if(key_released(note_keys[i]) and staccato==1) stop_note();
		}
	}

	// Play note index idx on the current instrument, cutting the previous note first when overlap is off.
	// The clip path is also handed to the recorder, which captures it (with timing) only while recording.
	void play_note(int idx)
	{
		string path;
		if(instcad==1)
		{
			path=get_map_sound("builder/interaction/instruments/pianos/"+piano+"/p"+idx+".ogg");
			if(overlap==0) { instpool.destroy_sound(pianoslot); instrec.record_stop(1); }
			pianoslot=instpool.play_stationary(path,false);
			instpool.update_sound_start_values(pianoslot,0,0,pitch);
		}
		else if(instcad==2)
		{
			path=get_map_sound("builder/interaction/instruments/drums/"+drum+"/d"+idx+".wav");
			if(overlap==0) { instpool.destroy_sound(drumslot); instrec.record_stop(2); }
			drumslot=instpool.play_stationary(path,false);
			instpool.update_sound_start_values(drumslot,0,0,pitch);
		}
		else
		{
			path=get_map_sound("builder/interaction/instruments/others/"+other+"/p"+idx+".ogg");
			if(overlap==0) { instpool.destroy_sound(otherslot); instrec.record_stop(3); }
			otherslot=instpool.play_stationary(path,false);
			instpool.update_sound_start_values(otherslot,0,0,pitch);
		}
		instrec.record_note(path, instcad, int(pitch));
	}

	// Staccato cutoff: stop the current instrument's ringing note, and record the note-off so the
	// cutoff is reproduced on playback.
	void stop_note()
	{
		if(instcad==1) instpool.destroy_sound(pianoslot);
		else if(instcad==2) instpool.destroy_sound(drumslot);
		else instpool.destroy_sound(otherslot);
		instrec.record_stop(instcad);
	}

	// Tab: cycle through the piano, drum, and other categories.
	void cycle_category()
	{
		instpool.destroy_all();
		pool.play_stationary(get_pack_sound("main/misc/medalbutton"+random(1,3)+".ogg"),false);
		if(instcad==1) { instcad=2; speak("drums, currently on "+drum); }
		else if(instcad==2) { instcad=3; speak("others, currently on "+other); }
		else { instcad=1; speak("pianos, currently on "+piano); }
	}

	// Left and right arrows: step to the previous (dir 1) or next (dir 2) instrument in the current category.
	void cycle_instrument(int dir)
	{
		instpool.destroy_all();
		pool.play_stationary(get_pack_sound("main/misc/medalbutton"+random(1,3)+".ogg"),false);
		if(instcad==1) { piano=cycle_instrument_folder("pianos", piano, dir); speak(piano); }
		else if(instcad==2) { drum=cycle_instrument_folder("drums", drum, dir); speak(drum); }
		else { other=cycle_instrument_folder("others", other, dir); speak(other); }
	}

	// Enter: toggle whether new notes overlap the ringing one or cut it off.
	void toggle_overlap()
	{
		instpool.destroy_all();
		if(overlap==0) { pool.play_stationary(get_pack_sound("main/misc/switchon.ogg"),false); speak("overlap enabled"); overlap=1; }
		else { pool.play_stationary(get_pack_sound("main/misc/switchoff.ogg"),false); speak("overlap disabled"); overlap=0; }
	}

	// Backslash: toggle staccato, so held notes are cut on release instead of ringing on.
	void toggle_staccato()
	{
		instpool.destroy_all();
		if(staccato==0) { pool.play_stationary(get_pack_sound("main/misc/toggleon.ogg"),false); speak("staccato enabled"); staccato=1; }
		else { pool.play_stationary(get_pack_sound("main/misc/toggleoff.ogg"),false); speak("staccato disabled"); staccato=0; }
	}

	// Up and down arrows held: bend the live pitch one step (dir is 1 up or -1 down).
	void bend_pitch(int dir)
	{
		pitch+=dir;
		instpool.update_sound_start_values(pianoslot,0,0,pitch);
		instpool.update_sound_start_values(drumslot,0,0,pitch);
		instpool.update_sound_start_values(otherslot,0,0,pitch);
		instrec.record_bend(int(pitch));
		pitchtimer.restart();
	}

	// Releasing the pitch arrows snaps the pitch back to normal.
	void reset_pitch()
	{
		pitch=100;
		instpool.update_sound_start_values(pianoslot,0,0,pitch);
		instpool.update_sound_start_values(drumslot,0,0,pitch);
		instpool.update_sound_start_values(otherslot,0,0,pitch);
		instrec.record_bend(int(pitch));
	}

	// Interact opened this instrument: pause the game, capture the keyboard for playing and recording,
	// and return to the game on Escape.
	void play_mode()
	{
		pause_game();
		string cur_cat = (instcad==1) ? "pianos" : ((instcad==2) ? "drums" : "others");
		string cur_name = (instcad==1) ? piano : ((instcad==2) ? drum : other);
		speak("Playing "+cur_cat+", currently on "+cur_name+".");
		while(true)
		{
			wait(5);
			instrec.recordcheck();
			update();
			if(key_pressed(KEY_ESCAPE)) break;
		}
		instpool.destroy_all();
		resume_game();
		speak("Stopped playing.");
	}
}

// Step to the previous (dir 1) or next (dir 2) instrument folder within a category, wrapping around the
// list. Folders are discovered from the map's assets and the shipped sounds, so custom instruments show up.
string cycle_instrument_folder(string category, string current, int dir)
{
	string[] folders=get_map_sound_folders("builder/interaction/instruments/"+category+"/*");
	if(folders.length()==0) return current;
	int idx=-1;
	for(uint i=0; i<folders.length(); i++)
	{
		if(current==folders[i]) { idx=int(i); break; }
	}
	if(idx==-1) return current;
	if(dir==1) { idx--; if(idx<0) idx=int(folders.length())-1; }
	else if(dir==2) { idx++; if(idx>=int(folders.length())) idx=0; }
	return folders[idx];
}

// Each frame: if the player is standing on an instrument's tile or area and presses interact, open it.
void instrumentcheck()
{
	for(uint i=0; i<instruments.length(); i++)
	{
		if(@instruments[i] == null) continue;
		bool match = me.x>=instruments[i].minx and me.x<=instruments[i].maxx and me.y>=instruments[i].miny and me.y<=instruments[i].maxy;
		if(mapmode == "3d") match = match and me.z>=instruments[i].minz and me.z<=instruments[i].maxz;
		if(match and controls.action_pressed("interact"))
			instruments[i].play_mode();
	}
}

void spawn_instrument(double mnx, double mxx, double mny, double mxy, double mnz=0, double mxz=0, bool ranged=false)
{
	instrument inst1(mnx, mxx, mny, mxy, mnz, mxz, ranged);
	instruments.insert_last(inst1);
}

void destroy_all_instruments()
{
	instpool.destroy_all();
	instruments.resize(0);
}

// A single instrument is one tile (x y [z]); a ranged one is an area (minx maxx miny maxy [minz maxz]).
// The line is pure coordinates, so the numeric count alone tells single from ranged.
void read_instrument(string[] sd)
{
	int numcount = int(sd.length()) - 1;
	bool ranged_shape = (mapmode == "3d") ? (numcount == 6) : (numcount == 4);
	if(ranged_shape) { read_ranged_instrument(sd); return; }
	double x = stn(sd[1]);
	double y = stn(sd[2]);
	double z = (mapmode == "3d") ? stn(sd[3]) : 0;
	spawn_instrument(x, x, y, y, z, z, false);
}

void read_ranged_instrument(string[] sd)
{
	double mnx = stn(sd[1]);
	double mxx = stn(sd[2]);
	double mny = stn(sd[3]);
	double mxy = stn(sd[4]);
	double mnz = 0, mxz = 0;
	if(mapmode == "3d") { mnz = stn(sd[5]); mxz = stn(sd[6]); }
	spawn_instrument(mnx, mxx, mny, mxy, mnz, mxz, true);
}

void write_instrument(double x, double y, double z=0)
{
	mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
	mapdata=mapper.read();
	if(mapmode == "3d")
	mapper.write("\r\n"+"instrument "+x+" "+y+" "+z);
	else
	mapper.write("\r\n"+"instrument "+x+" "+y);
	mapper.close();
	bump_map_modified();
}

void write_ranged_instrument(double mnx, double mxx, double mny, double mxy, double mnz=0, double mxz=0)
{
	mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
	mapdata=mapper.read();
	if(mapmode == "3d")
	mapper.write("\r\n"+"instrument "+mnx+" "+mxx+" "+mny+" "+mxy+" "+mnz+" "+mxz);
	else
	mapper.write("\r\n"+"instrument "+mnx+" "+mxx+" "+mny+" "+mxy);
	mapper.close();
	bump_map_modified();
}
