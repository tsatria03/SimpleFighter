/* Note keys in physical keyboard order. Position i drives note index i+1: the digit row plays notes
1-10, the top letter row 11-20, the home row 21-29, and the bottom row 30-36. Shared by every instrument. */

int[] note_keys = {
	KEY_1, KEY_2, KEY_3, KEY_4, KEY_5, KEY_6, KEY_7, KEY_8, KEY_9, KEY_0,
	KEY_Q, KEY_W, KEY_E, KEY_R, KEY_T, KEY_Y, KEY_U, KEY_I, KEY_O, KEY_P,
	KEY_A, KEY_S, KEY_D, KEY_F, KEY_G, KEY_H, KEY_J, KEY_K, KEY_L,
	KEY_Z, KEY_X, KEY_C, KEY_V, KEY_B, KEY_N, KEY_M
};

sound_pool instpool;
instrument@[] instruments(0);

class instrument
{
	int instcad = 1;         // 1 = pianos, 2 = drums
	int overlap = 0;         // 0 = cut the previous note, 1 = let notes ring together
	int staccato = 0;        // 1 = cut a note when its key is released
	int pitchable = 1;       // whether the pitch bend is allowed
	int pitchtime = 50;      // milliseconds between pitch-bend steps
	int pianoslot, drumslot; // the currently ringing note for each category
	double pitch = 100;
	string piano = "classical grand";
	string drum = "acoustic";
	timer pitchtimer;

	instrument()
	{
	}

	// Per-frame input handling for this instrument.
	void update()
	{
		if(key_repeating(KEY_TAB)) cycle_category();
		if(key_repeating(KEY_LEFT)) cycle_instrument(1);
		if(key_repeating(KEY_RIGHT)) cycle_instrument(2);
		if(key_pressed(KEY_RETURN)) toggle_overlap();
		if(key_pressed(KEY_BACKSLASH)) toggle_staccato();
		if(key_down(KEY_UP) and pitchable==1 and pitch!=160 and pitchtimer.elapsed>=pitchtime) bend_pitch(1);
		if(key_released(KEY_UP)) reset_pitch();
		if(key_down(KEY_DOWN) and pitchable==1 and pitch!=40 and pitchtimer.elapsed>=pitchtime) bend_pitch(-1);
		if(key_released(KEY_DOWN)) reset_pitch();
		for(uint i=0; i<note_keys.length(); i++)
		{
			if(key_pressed(note_keys[i])) play_note(i+1);
			if(key_released(note_keys[i]) and staccato==1) stop_note();
		}
	}

	// Play note index idx on the current instrument, cutting the previous note first when overlap is off.
	// The clip path is also handed to the recorder, which captures it (with timing) only while recording.
	void play_note(int idx)
	{
		string path;
		if(instcad==1)
		{
			path="sounds/instruments/pianos/"+piano+"/p"+idx+".ogg";
			if(overlap==0) { instpool.destroy_sound(pianoslot); rec.record_stop(1); }
			pianoslot=instpool.play_stationary(path,false);
			instpool.update_sound_start_values(pianoslot,0,0,pitch);
		}
		else
		{
			path="sounds/instruments/drums/"+drum+"/d"+idx+".wav";
			if(overlap==0) { instpool.destroy_sound(drumslot); rec.record_stop(2); }
			drumslot=instpool.play_stationary(path,false);
			instpool.update_sound_start_values(drumslot,0,0,pitch);
		}
		rec.record_note(path, instcad, pitch);
	}

	// Staccato cutoff: stop the current instrument's ringing note, and record the note-off so the
	// cutoff is reproduced on playback.
	void stop_note()
	{
		if(instcad==1)
		{
			instpool.destroy_sound(pianoslot);
			instpool.update_sound_start_values(pianoslot,0,0,pitch);
		}
		else
		{
			instpool.destroy_sound(drumslot);
			instpool.update_sound_start_values(drumslot,0,0,pitch);
		}
		rec.record_stop(instcad);
	}

	// Tab: switch between the piano and drum categories.
	void cycle_category()
	{
		instpool.destroy_all();
		pool.play_stationary("sounds/misc/medalbutton"+random(1,3)+".ogg",false);
		if(instcad==1) { instcad=2; speak("drums, currently on "+drum); }
		else { instcad=1; speak("pianos, currently on "+piano); }
	}

	// Left and right arrows: step to the previous (dir 1) or next (dir 2) instrument in the current category.
	void cycle_instrument(int dir)
	{
		instpool.destroy_all();
		pool.play_stationary("sounds/misc/medalbutton"+random(1,3)+".ogg",false);
		if(instcad==1) { piano=get_new_mallit(piano,dir); speak(piano); }
		else { drum=get_new_perc(drum,dir); speak(drum); }
	}

	// Enter: toggle whether new notes overlap the ringing one or cut it off.
	void toggle_overlap()
	{
		instpool.destroy_all();
		if(overlap==0) { pool.play_stationary("sounds/misc/switchon.ogg",false); speak("overlap enabled"); overlap=1; }
		else { pool.play_stationary("sounds/misc/switchoff.ogg",false); speak("overlap disabled"); overlap=0; }
	}

	// Backslash: toggle staccato, so held notes are cut on release instead of ringing on.
	void toggle_staccato()
	{
		instpool.destroy_all();
		if(staccato==0) { pool.play_stationary("sounds/misc/toggleon.ogg",false); speak("staccato enabled"); staccato=1; }
		else { pool.play_stationary("sounds/misc/toggleoff.ogg",false); speak("staccato disabled"); staccato=0; }
	}

	// Up and down arrows held: bend the live pitch one step (dir is 1 up or -1 down).
	void bend_pitch(int dir)
	{
		pitch+=dir;
		instpool.update_sound_start_values(pianoslot,0,0,pitch);
		instpool.update_sound_start_values(drumslot,0,0,pitch);
		rec.record_bend(pitch);
		pitchtimer.restart();
	}

	// Releasing the pitch arrows snaps the pitch back to normal.
	void reset_pitch()
	{
		pitch=100;
		instpool.update_sound_start_values(pianoslot,0,0,pitch);
		instpool.update_sound_start_values(drumslot,0,0,pitch);
		rec.record_bend(pitch);
	}
}

// Run every spawned instrument's per-frame handling.
void instloop()
{
	for(uint i=0; i<instruments.length(); i++)
	{
		if(@instruments[i] == null) continue;
		instruments[i].update();
	}
}

string get_new_perc(string perc,int direction)
{
string[] percussion=find_directories("sounds/instruments/drums/*");
int percindex=-1;
for (uint i=0; i<percussion.length(); i++)
{
if(perc==percussion[i])
{
percindex=i;
break;
}
}
if(percindex==-1)
return perc;
if (direction==1)
{
if(percindex>-1)
percindex--;
if(percindex<0)
percindex=percussion.length()-1;
}
else if (direction==2)
{
if(percindex>-1)
percindex++;
if(percindex>=percussion.length())
percindex=0;
}
else if (direction==3)
{
if(percindex>-1)
percindex=random(0,percussion.length()-1);
}
return percussion[percindex];
}
string get_new_mallit(string mallit,int direction)
{
string[] piano=find_directories("sounds/instruments/pianos/*");
int mallitindex=-1;
for (uint i=0; i<piano.length(); i++)
{
if(mallit==piano[i])
{
mallitindex=i;
break;
}
}
if(mallitindex==-1)
return mallit;
if (direction==1)
{
if(mallitindex>-1)
mallitindex--;
if(mallitindex<0)
mallitindex=piano.length()-1;
}
else if (direction==2)
{
if(mallitindex>-1)
mallitindex++;
if(mallitindex>=piano.length())
mallitindex=0;
}
else if (direction==3)
{
if(mallitindex>-1)
mallitindex=random(0,piano.length()-1);
}
return piano[mallitindex];
}

void spawn_instrument()
{
	instrument inst1();
	instruments.insert_last(inst1);
}

void destroy_all_instruments()
{
	instruments.resize(0);
}

void instplay()
{
speak("Instrument simulator. Press letters and numbers to play chords, melodies, and drums on the keyboard. Press the Tab key to cycle through the instrument categories. Press Left and Right arrow keys to cycle through the instrument types. Hold Up or Down arrow keys to utilize the pitch modulator. Press the Enter key to enable or disable the overlapping pettle for the current instrument you're playing. Press the Backslash key to enable or disable the sustaining pettle for the current instrument you're playing. Press the Escape key to exit.");
	spawn_instrument();
	while(true)
	{
		wait(5);
		rec.recordcheck();
		instloop();
		if(key_pressed(KEY_ESCAPE))
		{
			instpool.destroy_all();
			destroy_all_instruments();
			exit();
		}
	}
}
