menu_input@[]menu_inputs(0);

class menu_input
{
double minx, maxx;
double miny, maxy;
double minz, maxz;
string prompt;
string options;
string submit_command;
string cancel_command;
string escape_behavior;
bool singleuse;
menu_input(double mnx, double mxx, double mny, double mxy, string prmt, string opts, string submit, string cancel, string escbehavior, bool sgl, double mnz=0, double mxz=0)
{
minx=mnx;
maxx=mxx;
miny=mny;
maxy=mxy;
minz=mnz;
maxz=mxz;
prompt=prmt;
options=opts;
submit_command=submit;
cancel_command=cancel;
escape_behavior=escbehavior;
singleuse=sgl;
}
}

void spawn_menu_input(double mnx, double mxx, double mny, double mxy, string prompt, string options, string submit_command, string cancel_command, string escape_behavior, bool singleuse, double mnz=0, double mxz=0)
{
menu_input mi1(mnx, mxx, mny, mxy, prompt, options, submit_command, cancel_command, escape_behavior, singleuse, mnz, mxz);
menu_inputs.insert_last(mi1);
}

/* Remove one live menu input for the despawn command; it owns no sounds or sub-entities, so just
null the slot. */
bool despawn_menu_input(bool by_coord, double gx, double gy, double gz)
{
int target = -1;
for(uint i=0; i<menu_inputs.length(); i++)
{
if(@menu_inputs[i] == null) continue;
if(!by_coord || (menu_inputs[i].minx==gx && menu_inputs[i].miny==gy && (mapmode!="3d" || menu_inputs[i].minz==gz))) target = int(i);
}
if(target < 0) return false;
@menu_inputs[target] = null;
return true;
}
void destroy_all_menu_inputs()
{
menu_inputs.resize(0);
}

/* Splits the raw options string into parallel label/command arrays. Commas separate options; a
literal comma inside a label or command is escaped as \, and is unescaped here. Each entry splits on
its FIRST = into label (before) and command (after); an entry with no = is a bare label with an empty
command (it will fall back to the menu's submit command at pick time). */
void parse_menu_options(string raw, string[]@ labels, string[]@ cmds)
{
labels.resize(0);
cmds.resize(0);
string[] parts;
string cur = "";
for(uint i=0; i<raw.length(); i++)
{
string ch = raw.substr(i, 1);
if(ch == "\\" and i+1 < raw.length() and raw.substr(i+1, 1) == ",")
{
cur += ",";
i++;
continue;
}
if(ch == ",")
{
parts.insert_last(cur);
cur = "";
continue;
}
cur += ch;
}
parts.insert_last(cur);
for(uint i=0; i<parts.length(); i++)
{
string entry = string_trim_sides(parts[i]);
if(entry == "") continue;
int eq = entry.find("=");
string lab, cmd;
if(eq >= 0)
{
lab = string_trim_sides(entry.substr(0, eq));
cmd = string_trim_sides(entry.substr(eq+1, int(entry.length()) - eq - 1));
}
else
{
lab = entry;
cmd = "";
}
if(lab == "") continue;
labels.insert_last(lab);
cmds.insert_last(cmd);
}
}

void menu_input_loop()
{
for(uint i=0; i<menu_inputs.length(); i++)
{
if(@menu_inputs[i] == null) continue;
bool inside = menu_inputs[i].minx<=me.x and menu_inputs[i].maxx>=me.x and menu_inputs[i].miny<=me.y and menu_inputs[i].maxy>=me.y;
if(mapmode == "3d") inside = inside and me.z >= menu_inputs[i].minz and me.z <= menu_inputs[i].maxz;
if(!(inside and controls.action_repeating("interact"))) continue;
string[] labels;
string[] cmds;
parse_menu_options(menu_inputs[i].options, labels, cmds);
if(labels.length() == 0) continue;
pause_pools();
int res = -1;
while(true)
{
setupmenu();
for(uint j=0; j<labels.length(); j++)
m.add_item(labels[j], labels[j]);
m.intro_text = menu_inputs[i].prompt;
res = m.run();
if(res < 0 and menu_inputs[i].escape_behavior == "reopen") continue;
break;
}
resume_pools();
if(res < 0)
{
speak("canceled");
if(menu_inputs[i].cancel_command != "")
comstack(expand_input_tokens(menu_inputs[i].cancel_command, "", "", -1), true);
return;
}
string picked_label = labels[res];
string to_run = (cmds[res] != "") ? cmds[res] : menu_inputs[i].submit_command;
if(menu_inputs[i].singleuse) @menu_inputs[i] = null;
if(to_run != "")
comstack(expand_input_tokens(to_run, "", picked_label, res), true);
return;
}
}

void build_menu_input()
{
string disallowed_nums = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ `!@#$%^&*()[]{};:'\"\\|,<>?_/.+=~";
bool y_uses_back_front = mapmode != "2d";
string saved_x = sel_left_set ? sel_left : "";
string saved_y = y_uses_back_front ? (sel_back_set ? sel_back : "") : (sel_bottom_set ? sel_bottom : "");
string saved_z = sel_bottom_set ? sel_bottom : "";
string saved_mnx = sel_left_set ? sel_left : "";
string saved_mxx = sel_right_set ? sel_right : "";
string saved_mny = y_uses_back_front ? (sel_back_set ? sel_back : "") : (sel_bottom_set ? sel_bottom : "");
string saved_mxy = y_uses_back_front ? (sel_front_set ? sel_front : "") : (sel_top_set ? sel_top : "");
string saved_mnz = sel_bottom_set ? sel_bottom : "";
string saved_mxz = sel_top_set ? sel_top : "";
string saved_prompt = "";
string saved_options = "";
string saved_submit = "";
string saved_cancel = "";
int saved_escape_pos = 0;
bool saved_single = false;
int saved_mode_pos = 0;
int last_mode_pos = -2;
bool do_build = true;
int mode_list=-1, mx=-1, my=-1, mz=-1, mnx=-1, mxx=-1, mny=-1, mxy=-1, mnz=-1, mxz=-1, prompt_box=-1, options_box=-1, submit_box=-1, cancel_box=-1, escape_list=-1, single_cb=-1, ok=-1, cn=-1;
while(true)
{
if(do_build)
{
do_build = false;
if(last_mode_pos != -2)
{
saved_prompt = form.get_text(prompt_box);
saved_options = form.get_text(options_box);
saved_submit = form.get_text(submit_box);
saved_cancel = form.get_text(cancel_box);
saved_escape_pos = form.get_list_position(escape_list);
saved_single = form.is_checked(single_cb);
if(last_mode_pos == 1)
{
saved_mnx = form.get_text(mnx);
saved_mxx = form.get_text(mxx);
saved_mny = form.get_text(mny);
saved_mxy = form.get_text(mxy);
if(mnz != -1) saved_mnz = form.get_text(mnz);
if(mxz != -1) saved_mxz = form.get_text(mxz);
}
else
{
saved_x = form.get_text(mx);
saved_y = form.get_text(my);
if(mz != -1) saved_z = form.get_text(mz);
}
}
form.reset();
form.create_window("menu input", false, true, last_mode_pos != -2);
mode_list = form.create_list("build mode");
form.add_list_item(mode_list, "single - one tile at a single position", "single");
form.add_list_item(mode_list, "ranged - a rectangular area between a minimum and maximum axes", "ranged");
form.set_list_position(mode_list, saved_mode_pos, false);
mx = -1; my = -1; mz = -1; mnx = -1; mxx = -1; mny = -1; mxy = -1; mnz = -1; mxz = -1;
if(saved_mode_pos == 1)
{
mnx = form.create_input_box("minimum x", saved_mnx);
mxx = form.create_input_box("maximum x", saved_mxx);
mny = form.create_input_box("minimum y", saved_mny);
mxy = form.create_input_box("maximum y", saved_mxy);
if(mapmode == "3d")
{
mnz = form.create_input_box("minimum z", saved_mnz);
mxz = form.create_input_box("maximum z", saved_mxz);
}
}
else
{
mx = form.create_input_box("x", saved_x);
my = form.create_input_box("y", saved_y);
if(mapmode == "3d") mz = form.create_input_box("z", saved_z);
}
prompt_box = form.create_input_box("prompt: spoken when the menu opens, leave blank to skip", saved_prompt);
options_box = form.create_input_box("options: comma separated, each label or label=command", saved_options);
submit_box = form.create_input_box("submit command: runs for a bare label, leave blank to skip", saved_submit);
cancel_box = form.create_input_box("cancel command: runs if backed out, leave blank to skip", saved_cancel);
if(saved_mode_pos == 1)
{
form.set_disallowed_chars(mnx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(mxx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(mny, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(mxy, disallowed_nums, false, "This character is not allowed.");
if(mnz != -1) form.set_disallowed_chars(mnz, disallowed_nums, false, "This character is not allowed.");
if(mxz != -1) form.set_disallowed_chars(mxz, disallowed_nums, false, "This character is not allowed.");
}
else
{
form.set_disallowed_chars(mx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(my, disallowed_nums, false, "This character is not allowed.");
if(mz != -1) form.set_disallowed_chars(mz, disallowed_nums, false, "This character is not allowed.");
}
escape_list = form.create_list("escape behavior");
form.add_list_item(escape_list, "cancel", "cancel");
form.add_list_item(escape_list, "reopen", "reopen");
form.set_list_position(escape_list, saved_escape_pos, false);
single_cb = form.create_checkbox("single use", saved_single);
ok = form.create_button("&okay", true);
cn = form.create_button("&cancel");
if(last_mode_pos == -2) form.focus(mode_list);
else form.focus_silently(mode_list);
last_mode_pos = saved_mode_pos;
}
wait(5);
form.monitor();
int cur_mode_pos = form.get_list_position(mode_list);
if(cur_mode_pos != -1 && cur_mode_pos != last_mode_pos)
{
saved_mode_pos = cur_mode_pos;
do_build = true;
continue;
}
if(key_pressed(KEY_ESCAPE))
{
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(cn))
{
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(ok))
{
bool ranged = (saved_mode_pos == 1);
if(ranged)
{
if(form.get_text(mnx) == "") { speak("Minimum X is required."); form.focus(mnx); continue; }
if(form.get_text(mxx) == "") { speak("Maximum X is required."); form.focus(mxx); continue; }
if(form.get_text(mny) == "") { speak("Minimum Y is required."); form.focus(mny); continue; }
if(form.get_text(mxy) == "") { speak("Maximum Y is required."); form.focus(mxy); continue; }
if(mnz != -1 && form.get_text(mnz) == "") { speak("Minimum Z is required."); form.focus(mnz); continue; }
if(mxz != -1 && form.get_text(mxz) == "") { speak("Maximum Z is required."); form.focus(mxz); continue; }
}
else
{
if(form.get_text(mx) == "") { speak("X is required."); form.focus(mx); continue; }
if(form.get_text(my) == "") { speak("Y is required."); form.focus(my); continue; }
if(mz != -1 && form.get_text(mz) == "") { speak("Z is required."); form.focus(mz); continue; }
}
if(form.get_text(options_box) == "") { speak("Options are required."); form.focus(options_box); continue; }
int bx = 0, by = 0, bz = 0;
double bmnx = 0, bmxx = 0, bmny = 0, bmxy = 0, bmnz = 0, bmxz = 0;
if(ranged)
{
bmnx = string_to_number(form.get_text(mnx));
bmxx = string_to_number(form.get_text(mxx));
bmny = string_to_number(form.get_text(mny));
bmxy = string_to_number(form.get_text(mxy));
bmnz = (mnz != -1) ? string_to_number(form.get_text(mnz)) : 0;
bmxz = (mxz != -1) ? string_to_number(form.get_text(mxz)) : 0;
}
else
{
bx = string_to_number(form.get_text(mx));
by = string_to_number(form.get_text(my));
bz = (mz != -1) ? string_to_number(form.get_text(mz)) : 0;
}
string b_prompt = form.get_text(prompt_box);
string b_options = form.get_text(options_box);
string b_submit = form.get_text(submit_box);
string b_cancel = form.get_text(cancel_box);
int ep = form.get_list_position(escape_list);
string b_escape = (ep == 1) ? "reopen" : "cancel";
bool b_single = form.is_checked(single_cb);
resume_pools();
if(ranged)
{
write_ranged_menu_input(bmnx, bmxx, bmny, bmxy, b_prompt, b_options, b_submit, b_cancel, b_escape, b_single, bmnz, bmxz);
spawn_menu_input(bmnx, bmxx, bmny, bmxy, b_prompt, b_options, b_submit, b_cancel, b_escape, b_single, bmnz, bmxz);
}
else
{
write_menu_input(bx, by, b_prompt, b_options, b_submit, b_cancel, b_escape, b_single, bz);
spawn_menu_input(bx, bx, by, by, b_prompt, b_options, b_submit, b_cancel, b_escape, b_single, bz, bz);
}
load_map(mapname, mapowner);
mpool.play_stationary(get_pack_sound("main/characters/"+chartype+"/map/*update*"), false);
speak("Map updated.");
return;
}
}
}

/* Shared Tier 2 semantic check for the input entities (menu_input now, text_input in Phase B). Mirrors
switch_sensor_semantic_error MINUS the sound-folder check, since inputs have no enum/name field: it
detects single vs ranged by the first-quote position, then validates only the coordinates. The quoted
text fields and the bool tail are free-form and left unjudged, exactly as the switch leaves its
commands and flags. */
string input_semantic_error(string[] sd, string mode, int &out col)
{
bool is3d = (mode == "3d");
int qidx = -1;
for(uint i=1; i<sd.length(); i++)
if(sd[i].length() > 0 && sd[i].substr(0,1) == "\"") { qidx = int(i); break; }
bool ranged = false;
if(qidx != -1)
{
int numcount = qidx - 1;
ranged = is3d ? (numcount >= 5) : (numcount >= 4);
}
int maxidx = ranged ? (is3d ? 7 : 5) : (is3d ? 4 : 3);
if(int(sd.length()) <= maxidx) return "";
if(ranged)
{
string e = coord_token_error(sd[1], "x", mode);
if(e != "") { col=1; return "the minimum x "+e+"."; }
e = coord_token_error(sd[2], "x", mode);
if(e != "") { col=2; return "the maximum x "+e+"."; }
if(range_token_error(sd[1], sd[2]) != "") { col=2; return "the maximum x is less than the minimum x."; }
e = coord_token_error(sd[3], "y", mode);
if(e != "") { col=3; return "the minimum y "+e+"."; }
e = coord_token_error(sd[4], "y", mode);
if(e != "") { col=4; return "the maximum y "+e+"."; }
if(range_token_error(sd[3], sd[4]) != "") { col=4; return "the maximum y is less than the minimum y."; }
if(is3d)
{
e = coord_token_error(sd[5], "z", mode);
if(e != "") { col=5; return "the minimum z "+e+"."; }
e = coord_token_error(sd[6], "z", mode);
if(e != "") { col=6; return "the maximum z "+e+"."; }
if(range_token_error(sd[5], sd[6]) != "") { col=6; return "the maximum z is less than the minimum z."; }
}
}
else
{
string e = coord_token_error(sd[1], "x", mode);
if(e != "") { col=1; return "the x coordinate "+e+"."; }
e = coord_token_error(sd[2], "y", mode);
if(e != "") { col=2; return "the y coordinate "+e+"."; }
if(is3d)
{
e = coord_token_error(sd[3], "z", mode);
if(e != "") { col=3; return "the z coordinate "+e+"."; }
}
}
return "";
}

void read_menu_input(string[] sd)
{
int qidx = -1;
for(uint i=1; i<sd.length(); i++)
if(sd[i].length() > 0 && sd[i].substr(0,1) == "\"") { qidx = int(i); break; }
bool ranged = false;
if(qidx != -1)
{
int numcount = qidx - 1;
ranged = (mapmode == "3d") ? (numcount >= 5) : (numcount >= 4);
}
double mnx=0, mxx=0, mny=0, mxy=0, mnz=0, mxz=0;
int o;
if(ranged)
{
mnx=stn(sd[1]);
mxx=stn(sd[2]);
mny=stn(sd[3]);
mxy=stn(sd[4]);
o=5;
if(mapmode == "3d") { mnz=stn(sd[5]); mxz=stn(sd[6]); o=7; }
}
else
{
mnx=stn(sd[1]); mxx=mnx;
mny=stn(sd[2]); mxy=mny;
o=3;
if(mapmode == "3d") { mnz=stn(sd[3]); mxz=mnz; o=4; }
}
string prompt="", options="", submit="", cancel="";
string escape_behavior="cancel";
bool singleuse=false;
string combined = join_string_array(sd, o, sd.length());
string remainder;
array<string> quoted = extract_quoted(combined, remainder);
if(quoted.length() >= 1) prompt = quoted[0];
if(quoted.length() >= 2) options = quoted[1];
if(quoted.length() >= 3) submit = quoted[2];
if(quoted.length() >= 4) cancel = quoted[3];
array<string> tail = string_split(string_trim_sides(remainder), " ");
if(tail.length() >= 2)
{
escape_behavior = tail[0];
singleuse = string_to_bool(tail[1]);
}
spawn_menu_input(mnx, mxx, mny, mxy, prompt, options, submit, cancel, escape_behavior, singleuse, mnz, mxz);
}

void write_menu_input(int x, int y, string prompt, string options, string submit_command, string cancel_command, string escape_behavior, bool singleuse, int z=0)
{
string cp = escape_quotes(prompt);
string co = escape_quotes(options);
string cs = escape_quotes(submit_command);
string cc = escape_quotes(cancel_command);
mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
mapdata=mapper.read();
if(mapmode == "3d")
mapper.write("\r\n"+"menu_input "+x+" "+y+" "+z+" \""+cp+"\" \""+co+"\" \""+cs+"\" \""+cc+"\" "+escape_behavior+" "+singleuse);
else
mapper.write("\r\n"+"menu_input "+x+" "+y+" \""+cp+"\" \""+co+"\" \""+cs+"\" \""+cc+"\" "+escape_behavior+" "+singleuse);
mapper.close();
bump_map_modified();
}

void write_ranged_menu_input(double mnx, double mxx, double mny, double mxy, string prompt, string options, string submit_command, string cancel_command, string escape_behavior, bool singleuse, double mnz=0, double mxz=0)
{
string cp = escape_quotes(prompt);
string co = escape_quotes(options);
string cs = escape_quotes(submit_command);
string cc = escape_quotes(cancel_command);
mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
mapdata=mapper.read();
if(mapmode == "3d")
mapper.write("\r\n"+"menu_input "+mnx+" "+mxx+" "+mny+" "+mxy+" "+mnz+" "+mxz+" \""+cp+"\" \""+co+"\" \""+cs+"\" \""+cc+"\" "+escape_behavior+" "+singleuse);
else
mapper.write("\r\n"+"menu_input "+mnx+" "+mxx+" "+mny+" "+mxy+" \""+cp+"\" \""+co+"\" \""+cs+"\" \""+cc+"\" "+escape_behavior+" "+singleuse);
mapper.close();
bump_map_modified();
}
