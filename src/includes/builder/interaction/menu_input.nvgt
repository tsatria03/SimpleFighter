menu_input@[]menu_inputs(0);

class menu_input
{
double minx, maxx;
double miny, maxy;
double minz, maxz;
string title;
string prompt;
string options;
string submit_command;
string cancel_command;
bool allow_cancel;
bool singleuse;
menu_input(double mnx, double mxx, double mny, double mxy, string ttl, string prmt, string opts, string submit, string cancel, bool allowcancel, bool sgl, double mnz=0, double mxz=0)
{
minx=mnx;
maxx=mxx;
miny=mny;
maxy=mxy;
minz=mnz;
maxz=mxz;
title=ttl;
prompt=prmt;
options=opts;
submit_command=submit;
cancel_command=cancel;
allow_cancel=allowcancel;
singleuse=sgl;
}
}

void spawn_menu_input(double mnx, double mxx, double mny, double mxy, string title, string prompt, string options, string submit_command, string cancel_command, bool allow_cancel, bool singleuse, double mnz=0, double mxz=0)
{
menu_input mi1(mnx, mxx, mny, mxy, title, prompt, options, submit_command, cancel_command, allow_cancel, singleuse, mnz, mxz);
menu_inputs.insert_last(mi1);
}

void destroy_all_menu_inputs()
{
menu_inputs.resize(0);
}
