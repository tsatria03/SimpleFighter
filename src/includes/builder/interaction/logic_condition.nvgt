/*
Logic condition -- an if/elseif/else branching map element (14.9). This file will hold the whole
element: the class, its live array, read/write, the per-frame contact/interact/watch check, and the
build form. Those arrive in SECTION 2. Section 1 defines only the shared condition EVALUATOR below,
which both the element (to decide which branch wins) and the Tier 2 map-error check (to validate a
condition's syntax) will use.

evaluate_condition takes a condition string whose tokens have ALREADY been substituted to values --
for example "140 >= 50 and 0 == 1" -- and returns whether it is true. It is a left-to-right clause
fold in the style of the dev's StoryBuilder evaluate_condition: read one "value operator value" clause
to a bool, then for each following connector (and, or, &&, ||) read the next clause and fold it in,
strictly left to right with NO precedence and NO parentheses, so "a or b and c" means ((a or b) and c).
Comparisons accept floats. Anything malformed -- fewer than three tokens, an unknown connector, a
missing clause -- returns false, so a broken condition simply fails and the element falls through to
the next branch or the else (the runtime backstop for a typo Tier 2 missed).
*/

// True if s parses as a plain number (optionally signed, at most one decimal point). Used to choose
// numeric vs string equality; the ordering comparisons always go through stn.
bool logic_is_number(string s)
{
if(s.length() == 0) return false;
bool digit = false, dot = false;
for(uint i = 0; i < s.length(); i++)
{
string c = s.substr(i, 1);
if(c >= "0" and c <= "9") { digit = true; continue; }
if(c == "." and !dot) { dot = true; continue; }
if((c == "-" or c == "+") and i == 0) continue;
return false;
}
return digit;
}

// Evaluate one "a op b" clause. Ordering (> < >= <=) compares numeric values via stn. Equality
// (== !=) compares numerically when both sides are numbers (so 5 equals 5.0), otherwise as exact
// text. An unrecognized operator yields false.
bool logic_compare(string a, string op, string b)
{
if(op == "==") { if(logic_is_number(a) and logic_is_number(b)) return stn(a) == stn(b); return a == b; }
if(op == "!=") { if(logic_is_number(a) and logic_is_number(b)) return stn(a) != stn(b); return a != b; }
if(op == ">") return stn(a) > stn(b);
if(op == "<") return stn(a) < stn(b);
if(op == ">=") return stn(a) >= stn(b);
if(op == "<=") return stn(a) <= stn(b);
return false;
}

bool logic_is_connector(string t)
{
return t == "and" or t == "or" or t == "&&" or t == "||";
}

bool evaluate_condition(string cond)
{
string[] raw = string_split(string_trim_sides(cond), " ", true);
string[] tok;
for(uint i = 0; i < raw.length(); i++)
if(raw[i].length() > 0) tok.insert_last(raw[i]);
if(tok.length() < 3) return false;
bool result = logic_compare(tok[0], tok[1], tok[2]);
int idx = 3;
int n = int(tok.length());
while(idx < n)
{
string conn = tok[idx].lower();
if(!logic_is_connector(conn)) return false;
idx += 1;
if(idx + 2 >= n) return false;
bool clause = logic_compare(tok[idx], tok[idx + 1], tok[idx + 2]);
idx += 3;
if(conn == "and" or conn == "&&") result = result and clause;
else result = result or clause;
}
return result;
}

/* ===== The logic_condition element (section 2): state, parsing, runtime. Soundless (no pool), so it
gets no spier / obscurity / object-menu wiring per the soundless-entity rule. Branches are held as two
parallel arrays: conditions[i] with commands[i] are the if (i==0) and elseif (i>=1) branches, evaluated
top to bottom; the first true one wins, and if none match the else_command wins (it may be empty). ===== */
class logic_condition
{
double minx, maxx, miny, maxy, minz, maxz;
string mode;            // "contact", "interact", or "watch"
bool singleuse;
string[] conditions;    // if + elseif conditions, in order
string[] commands;      // the matching command for each condition (empty = do nothing)
string else_command;    // fired when no condition matches (may be empty)
bool was_inside;        // contact: fire-on-enter / re-arm-on-exit gate
int last_winner;        // watch: index of the last-fired branch (-2 = none / reset on exit)
logic_condition(double mnx, double mxx, double mny, double mxy, double mnz, double mxz, string md, string[]@ conds, string[]@ cmds, string ec, bool sgl)
{
minx=mnx; maxx=mxx; miny=mny; maxy=mxy; minz=mnz; maxz=mxz;
mode=md; singleuse=sgl;
conditions=conds; commands=cmds; else_command=ec;
was_inside=false; last_winner=-2;
}
/* Index of the winning branch: 0..conditions.length()-1 for a matched if/elseif, or conditions.length()
for the else. Each condition's universal tokens (%health%, %flag:x%, %item:y%, ...) are substituted to
values before the evaluator runs, so it only ever compares literals. */
int evaluate_winner()
{
for(uint i=0; i<conditions.length(); i++)
{
string c = conditions[i];
c = expand_state_tokens(c);
c = expand_flag_tokens(c);
c = expand_item_tokens(c);
if(evaluate_condition(c)) return int(i);
}
return int(conditions.length());
}
}
logic_condition@[] logic_conditions(0);

void spawn_logic_condition(double mnx, double mxx, double mny, double mxy, double mnz, double mxz, string mode, string[]@ conds, string[]@ cmds, string else_cmd, bool singleuse)
{
logic_condition lc(mnx, mxx, mny, mxy, mnz, mxz, mode, conds, cmds, else_cmd, singleuse);
logic_conditions.insert_last(lc);
}

/* Build the quoted-field block for the on-disk line: "if cond" "if cmd" ["elseif cond" "elseif cmd"]...
"else cmd". Every field is escape_quotes'd so a quote inside a command survives (the shared escape
convention). The count of quoted fields is always odd and >= 3, which the parser uses to peel if / else /
elseif pairs deterministically. */
string build_logic_quoted(string[]@ conds, string[]@ cmds, string else_cmd)
{
string s = "";
for(uint i=0; i<conds.length(); i++)
s += " \"" + escape_quotes(conds[i]) + "\" \"" + escape_quotes(cmds[i]) + "\"";
s += " \"" + escape_quotes(else_cmd) + "\"";
return s;
}

/* Parse one logic_condition line. Shape: logic_condition <coords> <mode> <quoted fields...> <singleuse>.
Coords are single (x y [z]) or ranged (mnx mxx mny mxy [mnz mxz]); the count of bare tokens before the
first quote tells them apart (same detection sensors use). The mode word sits just before the first
quote. The quoted block peels into if/elseif pairs + a trailing else; a trailing bare bool is single-use.
A structurally broken line (no quotes, or an even quoted-field count) is dropped, matching the reader's
permit-what-loads contract. */
void read_logic_condition(string[] sd)
{
int qidx = -1;
for(uint i=1; i<sd.length(); i++)
{
if(sd[i].length() > 0 and sd[i].substr(0,1) == "\"") { qidx = int(i); break; }
}
if(qidx == -1) return;
int numcount = qidx - 1;
bool ranged = (mapmode == "3d") ? (numcount >= 5) : (numcount >= 4);
// Drop a line that lacks enough bare tokens for its detected shape, so the coord reads below can't
// run off the end (permit-what-loads: a broken line simply doesn't place, Tier 2 flags it at authoring).
if(ranged)
{
if(mapmode == "3d" and numcount < 7) return;
if(mapmode != "3d" and numcount < 5) return;
}
else
{
if(mapmode == "3d" and numcount < 4) return;
if(mapmode != "3d" and numcount < 3) return;
}
double mnx, mxx, mny, mxy, mnz=0, mxz=0;
if(ranged)
{
mnx=stn(sd[1]); mxx=stn(sd[2]); mny=stn(sd[3]); mxy=stn(sd[4]);
if(mapmode == "3d") { mnz=stn(sd[5]); mxz=stn(sd[6]); }
}
else
{
mnx=stn(sd[1]); mxx=mnx; mny=stn(sd[2]); mxy=mny;
if(mapmode == "3d") { mnz=stn(sd[3]); mxz=mnz; }
}
string mode = sd[qidx-1];
string combined = join_string_array(sd, qidx, sd.length());
string remainder;
array<string> quoted = extract_quoted(combined, remainder);
if(quoted.length() < 3 or (quoted.length() % 2) == 0) return;
string[] conds;
string[] cmds;
uint pairs = (quoted.length()-1)/2;
for(uint i=0; i<pairs; i++)
{
conds.insert_last(quoted[i*2]);
cmds.insert_last(quoted[i*2+1]);
}
string else_cmd = quoted[quoted.length()-1];
bool singleuse = false;
array<string> tail = string_split(string_trim_sides(remainder), " ");
if(tail.length() >= 1 and tail[0].length() > 0) singleuse = string_to_bool(tail[0]);
spawn_logic_condition(mnx, mxx, mny, mxy, mnz, mxz, mode, conds, cmds, else_cmd, singleuse);
}

void write_logic_condition(double x, double y, double z, string mode, string[]@ conds, string[]@ cmds, string else_cmd, bool singleuse)
{
mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
mapdata=mapper.read();
string coords = (mapmode=="3d") ? (""+x+" "+y+" "+z) : (""+x+" "+y);
mapper.write("\r\n"+"logic_condition "+coords+" "+mode+build_logic_quoted(conds, cmds, else_cmd)+" "+singleuse);
mapper.close();
bump_map_modified();
}

void write_ranged_logic_condition(double mnx, double mxx, double mny, double mxy, double mnz, double mxz, string mode, string[]@ conds, string[]@ cmds, string else_cmd, bool singleuse)
{
mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
mapdata=mapper.read();
string coords = (mapmode=="3d") ? (""+mnx+" "+mxx+" "+mny+" "+mxy+" "+mnz+" "+mxz) : (""+mnx+" "+mxx+" "+mny+" "+mxy);
mapper.write("\r\n"+"logic_condition "+coords+" "+mode+build_logic_quoted(conds, cmds, else_cmd)+" "+singleuse);
mapper.close();
bump_map_modified();
}

/* Fire the winning branch of the element in slot `slot`. A real if/elseif match on a single-use element
consumes it (nulls the slot) BEFORE running its command; an else win never consumes single-use (it keeps
waiting for a real match). An empty winning command is a silent no-op. Commands run trusted, so they work
on a compiled map. */
void fire_logic_condition_winner(uint slot, int w)
{
if(@logic_conditions[slot] == null) return;
logic_condition@ lc = @logic_conditions[slot];
bool real_match = (w < int(lc.conditions.length()));
string cmd = real_match ? lc.commands[w] : lc.else_command;
if(real_match and lc.singleuse) @logic_conditions[slot] = null;
if(cmd != "") comstack(cmd, true);
}

void fire_logic_condition(uint slot)
{
if(@logic_conditions[slot] == null) return;
fire_logic_condition_winner(slot, logic_conditions[slot].evaluate_winner());
}

void logicloop()
{
for(uint i=0; i<logic_conditions.length(); i++)
{
if(@logic_conditions[i] == null) continue;
bool inside = me.x>=logic_conditions[i].minx and me.x<=logic_conditions[i].maxx and me.y>=logic_conditions[i].miny and me.y<=logic_conditions[i].maxy;
if(mapmode == "3d") inside = inside and me.z>=logic_conditions[i].minz and me.z<=logic_conditions[i].maxz;
string md = logic_conditions[i].mode;
if(md == "contact")
{
if(inside and !logic_conditions[i].was_inside)
{
logic_conditions[i].was_inside = true;
fire_logic_condition(i);
}
else if(!inside and logic_conditions[i].was_inside)
logic_conditions[i].was_inside = false;
}
else if(md == "watch")
{
if(inside)
{
int w = logic_conditions[i].evaluate_winner();
if(w != logic_conditions[i].last_winner)
{
logic_conditions[i].last_winner = w;
fire_logic_condition_winner(i, w);
}
}
else if(logic_conditions[i].last_winner != -2)
logic_conditions[i].last_winner = -2;
}
else if(md == "interact")
{
if(inside and controls.action_repeating("interact"))
{
fire_logic_condition(i);
return;
}
}
}
}

// Remove one live logic condition for the despawn command: the newest, or the one whose placement
// corner matches gx,gy[,gz]. Soundless, so nothing to stop before nulling the slot.
bool despawn_logic_condition(bool by_coord, double gx, double gy, double gz)
{
int target = -1;
for(uint i=0; i<logic_conditions.length(); i++)
{
if(@logic_conditions[i] == null) continue;
if(!by_coord or (logic_conditions[i].minx==gx and logic_conditions[i].miny==gy and (mapmode!="3d" or logic_conditions[i].minz==gz))) target = int(i);
}
if(target < 0) return false;
@logic_conditions[target] = null;
return true;
}

void destroy_all_logic_conditions()
{
logic_conditions.resize(0);
}

/* The "add elseif branch" sub-form: one small window with two inputs (condition + command) and okay /
cancel. Returns true with the condition/command filled if okay is pressed (condition required), false if
canceled. It reuses the global audio form, so the caller must rebuild its own form afterward. */
bool add_elseif_branch(string &out cond, string &out cmd)
{
cond = "";
cmd = "";
form.reset();
form.create_window("elseif branch", false);
int cbox = form.create_input_box("elseif condition", "");
int mbox = form.create_input_box("elseif command: leave blank to skip", "");
int sok = form.create_button("&okay", true);
int scn = form.create_button("&cancel");
form.focus(cbox);
while(true)
{
wait(5);
form.monitor();
if(key_pressed(KEY_ESCAPE)) { speak("canceled"); return false; }
if(form.is_pressed(scn)) { speak("canceled"); return false; }
if(form.is_pressed(sok))
{
string c = string_trim_sides(form.get_text(cbox));
if(c == "") { speak("The elseif condition is required."); form.focus(cbox); continue; }
cond = c;
cmd = form.get_text(mbox);
return true;
}
}
return false;
}

/* Build form for a logic condition. Mirrors the sensor form's single/ranged build-mode list (which
rebuilds the coord fields), then the if condition + command, the else command, a trigger-mode list
(contact/interact/watch), and a single-use checkbox. The three buttons are "add elseif branch" (opens the
sub-form above, appends the pair, rebuilds this form with fields intact), okay (builds immediately with
the branches gathered so far), and cancel. Only the coord boxes restrict characters; conditions and
commands accept anything (they hold tokens, operators, quotes). */
void build_logic_condition()
{
string disallowed_nums = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ `!@#$%^&*()[]{};:'\"\\|,<>?_/.+=~";
bool y_uses_back_front = mapmode != "2d";
string saved_x = sel_left_set ? sel_left : "";
string saved_y = y_uses_back_front ? (sel_back_set ? sel_back : "") : (sel_bottom_set ? sel_bottom : "");
string saved_z = sel_bottom_set ? sel_bottom : "";
string saved_mnx = sel_left_set ? sel_left : "";
string saved_mxx = sel_right_set ? sel_right : "";
string saved_mny = y_uses_back_front ? (sel_back_set ? sel_back : "") : (sel_bottom_set ? sel_bottom : "");
string saved_mxy = y_uses_back_front ? (sel_front_set ? sel_front : "") : (sel_top_set ? sel_top : "");
string saved_mnz = sel_bottom_set ? sel_bottom : "";
string saved_mxz = sel_top_set ? sel_top : "";
string saved_if_cond = "";
string saved_if_cmd = "";
string saved_else_cmd = "";
int saved_trigger_pos = 0;
bool saved_single = false;
int saved_mode_pos = 0;
int last_mode_pos = -2;
bool skip_save = false;
string[] elseif_conds;
string[] elseif_cmds;
bool do_build = true;
int mode_list=-1, mx=-1, my=-1, mz=-1, mnx=-1, mxx=-1, mny=-1, mxy=-1, mnz=-1, mxz=-1;
int if_cond_box=-1, if_cmd_box=-1, else_cmd_box=-1, trigger_list=-1, single_cb=-1, add_btn=-1, ok=-1, cn=-1;
while(true)
{
if(do_build)
{
do_build = false;
if(last_mode_pos != -2 and !skip_save)
{
saved_if_cond = form.get_text(if_cond_box);
saved_if_cmd = form.get_text(if_cmd_box);
saved_else_cmd = form.get_text(else_cmd_box);
saved_trigger_pos = form.get_list_position(trigger_list);
saved_single = form.is_checked(single_cb);
if(last_mode_pos == 1)
{
saved_mnx = form.get_text(mnx);
saved_mxx = form.get_text(mxx);
saved_mny = form.get_text(mny);
saved_mxy = form.get_text(mxy);
if(mnz != -1) saved_mnz = form.get_text(mnz);
if(mxz != -1) saved_mxz = form.get_text(mxz);
}
else
{
saved_x = form.get_text(mx);
saved_y = form.get_text(my);
if(mz != -1) saved_z = form.get_text(mz);
}
}
skip_save = false;
form.reset();
form.create_window("logic condition", false, true, last_mode_pos != -2);
mode_list = form.create_list("build mode");
form.add_list_item(mode_list, "single - one tile at a single position", "single");
form.add_list_item(mode_list, "ranged - a rectangular area between a minimum and maximum axes", "ranged");
form.set_list_position(mode_list, saved_mode_pos, false);
mx=-1; my=-1; mz=-1; mnx=-1; mxx=-1; mny=-1; mxy=-1; mnz=-1; mxz=-1;
if(saved_mode_pos == 1)
{
mnx = form.create_input_box("minimum x", saved_mnx);
mxx = form.create_input_box("maximum x", saved_mxx);
mny = form.create_input_box("minimum y", saved_mny);
mxy = form.create_input_box("maximum y", saved_mxy);
if(mapmode == "3d")
{
mnz = form.create_input_box("minimum z", saved_mnz);
mxz = form.create_input_box("maximum z", saved_mxz);
}
}
else
{
mx = form.create_input_box("x", saved_x);
my = form.create_input_box("y", saved_y);
if(mapmode == "3d") mz = form.create_input_box("z", saved_z);
}
if_cond_box = form.create_input_box("if condition", saved_if_cond);
if_cmd_box = form.create_input_box("if command: leave blank to skip", saved_if_cmd);
else_cmd_box = form.create_input_box("else command: leave blank to skip", saved_else_cmd);
if(saved_mode_pos == 1)
{
form.set_disallowed_chars(mnx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(mxx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(mny, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(mxy, disallowed_nums, false, "This character is not allowed.");
if(mnz != -1) form.set_disallowed_chars(mnz, disallowed_nums, false, "This character is not allowed.");
if(mxz != -1) form.set_disallowed_chars(mxz, disallowed_nums, false, "This character is not allowed.");
}
else
{
form.set_disallowed_chars(mx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(my, disallowed_nums, false, "This character is not allowed.");
if(mz != -1) form.set_disallowed_chars(mz, disallowed_nums, false, "This character is not allowed.");
}
trigger_list = form.create_list("trigger mode");
form.add_list_item(trigger_list, "contact", "contact");
form.add_list_item(trigger_list, "interact", "interact");
form.add_list_item(trigger_list, "watch", "watch");
form.set_list_position(trigger_list, saved_trigger_pos, false);
single_cb = form.create_checkbox("single use", saved_single);
add_btn = form.create_button("&add elseif branch");
ok = form.create_button("&okay", true);
cn = form.create_button("&cancel");
if(last_mode_pos == -2) form.focus(mode_list);
else form.focus_silently(mode_list);
last_mode_pos = saved_mode_pos;
}
wait(5);
form.monitor();
int cur_mode_pos = form.get_list_position(mode_list);
if(cur_mode_pos != -1 and cur_mode_pos != last_mode_pos)
{
saved_mode_pos = cur_mode_pos;
do_build = true;
continue;
}
if(key_pressed(KEY_ESCAPE)) { resume_pools(); speak("canceled"); return; }
if(form.is_pressed(cn)) { resume_pools(); speak("canceled"); return; }
if(form.is_pressed(add_btn))
{
saved_if_cond = form.get_text(if_cond_box);
saved_if_cmd = form.get_text(if_cmd_box);
saved_else_cmd = form.get_text(else_cmd_box);
saved_trigger_pos = form.get_list_position(trigger_list);
saved_single = form.is_checked(single_cb);
if(saved_mode_pos == 1)
{
saved_mnx = form.get_text(mnx);
saved_mxx = form.get_text(mxx);
saved_mny = form.get_text(mny);
saved_mxy = form.get_text(mxy);
if(mnz != -1) saved_mnz = form.get_text(mnz);
if(mxz != -1) saved_mxz = form.get_text(mxz);
}
else
{
saved_x = form.get_text(mx);
saved_y = form.get_text(my);
if(mz != -1) saved_z = form.get_text(mz);
}
string ec, ecmd;
if(add_elseif_branch(ec, ecmd))
{
elseif_conds.insert_last(ec);
elseif_cmds.insert_last(ecmd);
speak("Elseif branch added.");
}
skip_save = true;
do_build = true;
continue;
}
if(form.is_pressed(ok))
{
bool ranged = (saved_mode_pos == 1);
if(ranged)
{
if(form.get_text(mnx) == "") { speak("Minimum x is required."); form.focus(mnx); continue; }
if(form.get_text(mxx) == "") { speak("Maximum x is required."); form.focus(mxx); continue; }
if(form.get_text(mny) == "") { speak("Minimum y is required."); form.focus(mny); continue; }
if(form.get_text(mxy) == "") { speak("Maximum y is required."); form.focus(mxy); continue; }
if(mnz != -1 and form.get_text(mnz) == "") { speak("Minimum z is required."); form.focus(mnz); continue; }
if(mxz != -1 and form.get_text(mxz) == "") { speak("Maximum z is required."); form.focus(mxz); continue; }
}
else
{
if(form.get_text(mx) == "") { speak("X is required."); form.focus(mx); continue; }
if(form.get_text(my) == "") { speak("Y is required."); form.focus(my); continue; }
if(mz != -1 and form.get_text(mz) == "") { speak("Z is required."); form.focus(mz); continue; }
}
if(string_trim_sides(form.get_text(if_cond_box)) == "") { speak("The if condition is required."); form.focus(if_cond_box); continue; }
int tpos = form.get_list_position(trigger_list);
string tmode = (tpos == 1) ? "interact" : ((tpos == 2) ? "watch" : "contact");
bool bsingle = form.is_checked(single_cb);
string[] conds;
string[] cmds;
conds.insert_last(string_trim_sides(form.get_text(if_cond_box)));
cmds.insert_last(form.get_text(if_cmd_box));
for(uint i=0; i<elseif_conds.length(); i++)
{
conds.insert_last(elseif_conds[i]);
cmds.insert_last(elseif_cmds[i]);
}
string else_cmd = form.get_text(else_cmd_box);
resume_pools();
if(ranged)
{
double bmnx = string_to_number(form.get_text(mnx));
double bmxx = string_to_number(form.get_text(mxx));
double bmny = string_to_number(form.get_text(mny));
double bmxy = string_to_number(form.get_text(mxy));
double bmnz = (mnz != -1) ? string_to_number(form.get_text(mnz)) : 0;
double bmxz = (mxz != -1) ? string_to_number(form.get_text(mxz)) : 0;
write_ranged_logic_condition(bmnx, bmxx, bmny, bmxy, bmnz, bmxz, tmode, conds, cmds, else_cmd, bsingle);
}
else
{
double bx = string_to_number(form.get_text(mx));
