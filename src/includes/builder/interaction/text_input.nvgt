text_input@[]text_inputs(0);

class text_input
{
double minx, maxx;
double miny, maxy;
double minz, maxz;
string title;
string prompt;
string answer;
string char_filter;
string submit_command;
string incorrect_command;
string exhausted_command;
string cancel_command;
int max_attempts;
int max_length;
bool whitelist;
bool secure;
bool case_sensitive;
string escape_behavior;
string exhaust_behavior;
bool singleuse;
int attempts_used;
bool spent;
text_input(double mnx, double mxx, double mny, double mxy, string ttl, string prmt, string ans, string cfilter, string submit, string incorrect, string exhausted, string cancel, int maxatt, int maxlen, bool wl, bool sec, bool casesens, string escbehavior, string exhbehavior, bool sgl, double mnz=0, double mxz=0)
{
minx=mnx;
maxx=mxx;
miny=mny;
maxy=mxy;
minz=mnz;
maxz=mxz;
title=ttl;
prompt=prmt;
answer=ans;
char_filter=cfilter;
submit_command=submit;
incorrect_command=incorrect;
exhausted_command=exhausted;
cancel_command=cancel;
max_attempts=maxatt;
max_length=maxlen;
whitelist=wl;
secure=sec;
case_sensitive=casesens;
escape_behavior=escbehavior;
exhaust_behavior=exhbehavior;
singleuse=sgl;
attempts_used=0;
spent=false;
}
}

void spawn_text_input(double mnx, double mxx, double mny, double mxy, string title, string prompt, string answer, string char_filter, string submit_command, string incorrect_command, string exhausted_command, string cancel_command, int max_attempts, int max_length, bool whitelist, bool secure, bool case_sensitive, string escape_behavior, string exhaust_behavior, bool singleuse, double mnz=0, double mxz=0)
{
text_input ti1(mnx, mxx, mny, mxy, title, prompt, answer, char_filter, submit_command, incorrect_command, exhausted_command, cancel_command, max_attempts, max_length, whitelist, secure, case_sensitive, escape_behavior, exhaust_behavior, singleuse, mnz, mxz);
text_inputs.insert_last(ti1);
}

void destroy_all_text_inputs()
{
text_inputs.resize(0);
}

void text_input_loop()
{
for(uint i=0; i<text_inputs.length(); i++)
{
if(@text_inputs[i] == null) continue;
bool inside = text_inputs[i].minx<=me.x and text_inputs[i].maxx>=me.x and text_inputs[i].miny<=me.y and text_inputs[i].maxy>=me.y;
if(mapmode == "3d") inside = inside and me.z >= text_inputs[i].minz and me.z <= text_inputs[i].maxz;
if(!(inside and controls.action_repeating("interact"))) continue;
if(text_inputs[i].spent)
{
if(text_inputs[i].exhausted_command != "")
comstack(expand_input_tokens(text_inputs[i].exhausted_command, "", "", -1, text_inputs[i].attempts_used, 0));
return;
}
pause_pools();
vd.set_disallowed_chars(text_inputs[i].char_filter, text_inputs[i].whitelist, "This character is not allowed.");
string typed;
while(true)
{
typed = vd.input_box(text_inputs[i].title, text_inputs[i].prompt, "", "", "This character is not allowed.", 0, text_inputs[i].secure, text_inputs[i].max_length);
if(typed == "" and text_inputs[i].escape_behavior == "reopen") continue;
break;
}
resume_pools();
if(typed == "")
{
speak("canceled");
if(text_inputs[i].cancel_command != "")
{
int crem = (text_inputs[i].max_attempts >= 1) ? (text_inputs[i].max_attempts - text_inputs[i].attempts_used) : 0;
if(crem < 0) crem = 0;
comstack(expand_input_tokens(text_inputs[i].cancel_command, "", "", -1, text_inputs[i].attempts_used, crem));
}
return;
}
int cur = text_inputs[i].attempts_used + 1;
int rem = (text_inputs[i].max_attempts >= 1) ? (text_inputs[i].max_attempts - cur) : 0;
if(rem < 0) rem = 0;
bool graded = (text_inputs[i].answer != "");
bool correct = false;
if(graded)
{
if(text_inputs[i].case_sensitive) correct = (typed == text_inputs[i].answer);
else correct = (typed.lower() == text_inputs[i].answer.lower());
}
if(!graded or correct)
{
if(text_inputs[i].submit_command != "")
comstack(expand_input_tokens(text_inputs[i].submit_command, typed, "", -1, cur, rem));
if(text_inputs[i].singleuse) @text_inputs[i] = null;
return;
}
bool exhausting = (text_inputs[i].max_attempts >= 1 and cur >= text_inputs[i].max_attempts);
if(!exhausting and text_inputs[i].incorrect_command != "")
comstack(expand_input_tokens(text_inputs[i].incorrect_command, typed, "", -1, cur, rem));
text_inputs[i].attempts_used = cur;
if(exhausting)
{
if(text_inputs[i].exhausted_command != "")
comstack(expand_input_tokens(text_inputs[i].exhausted_command, typed, "", -1, cur, rem));
if(text_inputs[i].exhaust_behavior == "reset")
text_inputs[i].attempts_used = 0;
else
text_inputs[i].spent = true;
}
if(text_inputs[i].singleuse) @text_inputs[i] = null;
return;
}
}

void build_text_input()
{
string disallowed_nums = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ `!@#$%^&*()[]{};:'\"\\|,<>?_/.+=~";
bool y_uses_back_front = mapmode != "2d";
string saved_x = sel_left_set ? sel_left : "";
string saved_y = y_uses_back_front ? (sel_back_set ? sel_back : "") : (sel_bottom_set ? sel_bottom : "");
string saved_z = sel_bottom_set ? sel_bottom : "";
string saved_mnx = sel_left_set ? sel_left : "";
string saved_mxx = sel_right_set ? sel_right : "";
string saved_mny = y_uses_back_front ? (sel_back_set ? sel_back : "") : (sel_bottom_set ? sel_bottom : "");
string saved_mxy = y_uses_back_front ? (sel_front_set ? sel_front : "") : (sel_top_set ? sel_top : "");
string saved_mnz = sel_bottom_set ? sel_bottom : "";
string saved_mxz = sel_top_set ? sel_top : "";
string saved_title = "";
string saved_prompt = "";
string saved_answer = "";
string saved_maxatt = "0";
string saved_maxlen = "0";
string saved_filter = "";
string saved_submit = "";
string saved_incorrect = "";
string saved_exhausted = "";
string saved_cancel = "";
int saved_escape_pos = 0;
int saved_exhaust_pos = 0;
bool saved_wl = false;
bool saved_secure = false;
bool saved_case = false;
bool saved_single = false;
int saved_mode_pos = 0;
int last_mode_pos = -2;
bool do_build = true;
int mode_list=-1, mx=-1, my=-1, mz=-1, mnx=-1, mxx=-1, mny=-1, mxy=-1, mnz=-1, mxz=-1, title_box=-1, prompt_box=-1, answer_box=-1, maxatt_box=-1, maxlen_box=-1, filter_box=-1, submit_box=-1, incorrect_box=-1, exhausted_box=-1, cancel_box=-1, escape_list=-1, exhaust_list=-1, wl_cb=-1, secure_cb=-1, case_cb=-1, single_cb=-1, ok=-1, cn=-1;
while(true)
{
if(do_build)
{
do_build = false;
if(last_mode_pos != -2)
{
saved_title = form.get_text(title_box);
saved_prompt = form.get_text(prompt_box);
saved_answer = form.get_text(answer_box);
saved_maxatt = form.get_text(maxatt_box);
saved_maxlen = form.get_text(maxlen_box);
saved_filter = form.get_text(filter_box);
saved_submit = form.get_text(submit_box);
saved_incorrect = form.get_text(incorrect_box);
saved_exhausted = form.get_text(exhausted_box);
saved_cancel = form.get_text(cancel_box);
saved_escape_pos = form.get_list_position(escape_list);
saved_exhaust_pos = form.get_list_position(exhaust_list);
saved_wl = form.is_checked(wl_cb);
saved_secure = form.is_checked(secure_cb);
saved_case = form.is_checked(case_cb);
saved_single = form.is_checked(single_cb);
if(last_mode_pos == 1)
{
saved_mnx = form.get_text(mnx);
saved_mxx = form.get_text(mxx);
saved_mny = form.get_text(mny);
saved_mxy = form.get_text(mxy);
if(mnz != -1) saved_mnz = form.get_text(mnz);
if(mxz != -1) saved_mxz = form.get_text(mxz);
}
else
{
saved_x = form.get_text(mx);
saved_y = form.get_text(my);
if(mz != -1) saved_z = form.get_text(mz);
}
}
form.reset();
form.create_window("text input", false, true, last_mode_pos != -2);
mode_list = form.create_list("build mode");
form.add_list_item(mode_list, "single - one tile at a single position", "single");
form.add_list_item(mode_list, "ranged - a rectangular area between a minimum and maximum axes", "ranged");
form.set_list_position(mode_list, saved_mode_pos, false);
mx = -1; my = -1; mz = -1; mnx = -1; mxx = -1; mny = -1; mxy = -1; mnz = -1; mxz = -1;
if(saved_mode_pos == 1)
{
mnx = form.create_input_box("minimum x", saved_mnx);
mxx = form.create_input_box("maximum x", saved_mxx);
mny = form.create_input_box("minimum y", saved_mny);
mxy = form.create_input_box("maximum y", saved_mxy);
if(mapmode == "3d")
{
mnz = form.create_input_box("minimum z", saved_mnz);
mxz = form.create_input_box("maximum z", saved_mxz);
}
}
else
{
mx = form.create_input_box("x", saved_x);
my = form.create_input_box("y", saved_y);
if(mapmode == "3d") mz = form.create_input_box("z", saved_z);
}
title_box = form.create_input_box("title: shown on the input box, leave blank to skip", saved_title);
prompt_box = form.create_input_box("prompt", saved_prompt);
answer_box = form.create_input_box("answer: leave blank for no grading", saved_answer);
maxatt_box = form.create_input_box("max attempts: 0 for unlimited", saved_maxatt);
maxlen_box = form.create_input_box("max length: 0 for no limit", saved_maxlen);
filter_box = form.create_input_box("character filter: characters to allow or block, leave blank for no restriction", saved_filter);
submit_box = form.create_input_box("submit command: runs on submit or a correct answer, leave blank to skip", saved_submit);
incorrect_box = form.create_input_box("incorrect command: runs on a wrong answer, leave blank to skip", saved_incorrect);
exhausted_box = form.create_input_box("exhausted command: runs when attempts run out, leave blank to skip", saved_exhausted);
cancel_box = form.create_input_box("cancel command: runs if backed out, leave blank to skip", saved_cancel);
if(saved_mode_pos == 1)
{
form.set_disallowed_chars(mnx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(mxx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(mny, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(mxy, disallowed_nums, false, "This character is not allowed.");
if(mnz != -1) form.set_disallowed_chars(mnz, disallowed_nums, false, "This character is not allowed.");
if(mxz != -1) form.set_disallowed_chars(mxz, disallowed_nums, false, "This character is not allowed.");
}
else
{
form.set_disallowed_chars(mx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(my, disallowed_nums, false, "This character is not allowed.");
if(mz != -1) form.set_disallowed_chars(mz, disallowed_nums, false, "This character is not allowed.");
}
form.set_disallowed_chars(maxatt_box, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(maxlen_box, disallowed_nums, false, "This character is not allowed.");
escape_list = form.create_list("escape behavior");
form.add_list_item(escape_list, "cancel", "cancel");
form.add_list_item(escape_list, "reopen", "reopen");
form.set_list_position(escape_list, saved_escape_pos, false);
exhaust_list = form.create_list("exhaust behavior");
form.add_list_item(exhaust_list, "lock", "lock");
form.add_list_item(exhaust_list, "reset", "reset");
form.set_list_position(exhaust_list, saved_exhaust_pos, false);
wl_cb = form.create_checkbox("enable whitelist", saved_wl);
secure_cb = form.create_checkbox("secure", saved_secure);
case_cb = form.create_checkbox("case sensitive", saved_case);
single_cb = form.create_checkbox("single use", saved_single);
ok = form.create_button("&okay", true);
cn = form.create_button("&cancel");
if(last_mode_pos == -2) form.focus(mode_list);
else form.focus_silently(mode_list);
last_mode_pos = saved_mode_pos;
}
wait(5);
form.monitor();
int cur_mode_pos = form.get_list_position(mode_list);
if(cur_mode_pos != -1 && cur_mode_pos != last_mode_pos)
{
saved_mode_pos = cur_mode_pos;
do_build = true;
continue;
}
if(key_pressed(KEY_ESCAPE))
{
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(cn))
{
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(ok))
{
bool ranged = (saved_mode_pos == 1);
if(ranged)
{
if(form.get_text(mnx) == "") { speak("Minimum X is required."); form.focus(mnx); continue; }
if(form.get_text(mxx) == "") { speak("Maximum X is required."); form.focus(mxx); continue; }
if(form.get_text(mny) == "") { speak("Minimum Y is required."); form.focus(mny); continue; }
if(form.get_text(mxy) == "") { speak("Maximum Y is required."); form.focus(mxy); continue; }
if(mnz != -1 && form.get_text(mnz) == "") { speak("Minimum Z is required."); form.focus(mnz); continue; }
if(mxz != -1 && form.get_text(mxz) == "") { speak("Maximum Z is required."); form.focus(mxz); continue; }
}
else
{
if(form.get_text(mx) == "") { speak("X is required."); form.focus(mx); continue; }
if(form.get_text(my) == "") { speak("Y is required."); form.focus(my); continue; }
if(mz != -1 && form.get_text(mz) == "") { speak("Z is required."); form.focus(mz); continue; }
}
if(form.get_text(prompt_box) == "") { speak("Prompt is required."); form.focus(prompt_box); continue; }
int bx = 0, by = 0, bz = 0;
double bmnx = 0, bmxx = 0, bmny = 0, bmxy = 0, bmnz = 0, bmxz = 0;
if(ranged)
{
bmnx = string_to_number(form.get_text(mnx));
bmxx = string_to_number(form.get_text(mxx));
bmny = string_to_number(form.get_text(mny));
bmxy = string_to_number(form.get_text(mxy));
bmnz = (mnz != -1) ? string_to_number(form.get_text(mnz)) : 0;
bmxz = (mxz != -1) ? string_to_number(form.get_text(mxz)) : 0;
}
else
{
bx = string_to_number(form.get_text(mx));
by = string_to_number(form.get_text(my));
bz = (mz != -1) ? string_to_number(form.get_text(mz)) : 0;
}
string b_title = form.get_text(title_box);
string b_prompt = form.get_text(prompt_box);
string b_answer = form.get_text(answer_box);
int b_maxatt = (form.get_text(maxatt_box) == "") ? 0 : string_to_number(form.get_text(maxatt_box));
int b_maxlen = (form.get_text(maxlen_box) == "") ? 0 : string_to_number(form.get_text(maxlen_box));
string b_filter = form.get_text(filter_box);
string b_submit = form.get_text(submit_box);
string b_incorrect = form.get_text(incorrect_box);
string b_exhausted = form.get_text(exhausted_box);
string b_cancel = form.get_text(cancel_box);
int ep = form.get_list_position(escape_list);
string b_escape = (ep == 1) ? "reopen" : "cancel";
int xp = form.get_list_position(exhaust_list);
string b_exhaust = (xp == 1) ? "reset" : "lock";
bool b_wl = form.is_checked(wl_cb);
bool b_secure = form.is_checked(secure_cb);
bool b_case = form.is_checked(case_cb);
bool b_single = form.is_checked(single_cb);
resume_pools();
if(ranged)
{
write_ranged_text_input(bmnx, bmxx, bmny, bmxy, b_title, b_prompt, b_answer, b_filter, b_submit, b_incorrect, b_exhausted, b_cancel, b_maxatt, b_maxlen, b_wl, b_secure, b_case, b_escape, b_exhaust, b_single, bmnz, bmxz);
spawn_text_input(bmnx, bmxx, bmny, bmxy, b_title, b_prompt, b_answer, b_filter, b_submit, b_incorrect, b_exhausted, b_cancel, b_maxatt, b_maxlen, b_wl, b_secure, b_case, b_escape, b_exhaust, b_single, bmnz, bmxz);
}
else
{
write_text_input(bx, by, b_title, b_prompt, b_answer, b_filter, b_submit, b_incorrect, b_exhausted, b_cancel, b_maxatt, b_maxlen, b_wl, b_secure, b_case, b_escape, b_exhaust, b_single, bz);
spawn_text_input(bx, bx, by, by, b_title, b_prompt, b_answer, b_filter, b_submit, b_incorrect, b_exhausted, b_cancel, b_maxatt, b_maxlen, b_wl, b_secure, b_case, b_escape, b_exhaust, b_single, bz, bz);
}
load_map(mapname, mapowner);
mpool.play_stationary(get_pack_sound("main/characters/"+chartype+"/map/*update*"), false);
speak("Map updated.");
return;
}
}
}

void read_text_input(string[] sd)
{
int qidx = -1;
for(uint i=1; i<sd.length(); i++)
if(sd[i].length() > 0 && sd[i].substr(0,1) == "\"") { qidx = int(i); break; }
bool ranged = false;
if(qidx != -1)
{
int numcount = qidx - 1;
ranged = (mapmode == "3d") ? (numcount >= 5) : (numcount >= 4);
}
double mnx=0, mxx=0, mny=0, mxy=0, mnz=0, mxz=0;
int o;
if(ranged)
{
mnx=stn(sd[1]);
mxx=stn(sd[2]);
mny=stn(sd[3]);
mxy=stn(sd[4]);
o=5;
if(mapmode == "3d") { mnz=stn(sd[5]); mxz=stn(sd[6]); o=7; }
}
else
{
mnx=stn(sd[1]); mxx=mnx;
mny=stn(sd[2]); mxy=mny;
o=3;
if(mapmode == "3d") { mnz=stn(sd[3]); mxz=mnz; o=4; }
}
string title="", prompt="", answer="", char_filter="", submit="", incorrect="", exhausted="", cancel="";
int max_attempts=0, max_length=0;
bool whitelist=false, secure=false, case_sensitive=false, singleuse=false;
string escape_behavior="cancel";
string exhaust_behavior="lock";
string combined = join_string_array(sd, o, sd.length());
string remainder;
array<string> quoted = extract_quoted(combined, remainder);
if(quoted.length() >= 1) title = quoted[0];
if(quoted.length() >= 2) prompt = quoted[1];
if(quoted.length() >= 3) answer = quoted[2];
if(quoted.length() >= 4) char_filter = quoted[3];
if(quoted.length() >= 5) submit = quoted[4];
if(quoted.length() >= 6) incorrect = quoted[5];
if(quoted.length() >= 7) exhausted = quoted[6];
if(quoted.length() >= 8) cancel = quoted[7];
array<string> tail = string_split(string_trim_sides(remainder), " ");
if(tail.length() >= 8)
{
max_attempts = stn(tail[0]);
max_length = stn(tail[1]);
whitelist = string_to_bool(tail[2]);
secure = string_to_bool(tail[3]);
case_sensitive = string_to_bool(tail[4]);
escape_behavior = tail[5];
exhaust_behavior = tail[6];
singleuse = string_to_bool(tail[7]);
}
else if(tail.length() >= 7)
{
max_attempts = stn(tail[0]);
max_length = stn(tail[1]);
whitelist = string_to_bool(tail[2]);
secure = string_to_bool(tail[3]);
case_sensitive = string_to_bool(tail[4]);
escape_behavior = tail[5];
singleuse = string_to_bool(tail[6]);
}
spawn_text_input(mnx, mxx, mny, mxy, title, prompt, answer, char_filter, submit, incorrect, exhausted, cancel, max_attempts, max_length, whitelist, secure, case_sensitive, escape_behavior, exhaust_behavior, singleuse, mnz, mxz);
}

void write_text_input(int x, int y, string title, string prompt, string answer, string char_filter, string submit_command, string incorrect_command, string exhausted_command, string cancel_command, int max_attempts, int max_length, bool whitelist, bool secure, bool case_sensitive, string escape_behavior, string exhaust_behavior, bool singleuse, int z=0)
{
string c_title = string_replace(title, "\"", "", true);
string c_prompt = string_replace(prompt, "\"", "", true);
string c_answer = string_replace(answer, "\"", "", true);
string c_filter = string_replace(char_filter, "\"", "", true);
string c_submit = string_replace(submit_command, "\"", "", true);
string c_incorrect = string_replace(incorrect_command, "\"", "", true);
string c_exhausted = string_replace(exhausted_command, "\"", "", true);
string c_cancel = string_replace(cancel_command, "\"", "", true);
string quoted = " \""+c_title+"\" \""+c_prompt+"\" \""+c_answer+"\" \""+c_filter+"\" \""+c_submit+"\" \""+c_incorrect+"\" \""+c_exhausted+"\" \""+c_cancel+"\"";
string tail = " "+max_attempts+" "+max_length+" "+whitelist+" "+secure+" "+case_sensitive+" "+escape_behavior+" "+exhaust_behavior+" "+singleuse;
mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
mapdata=mapper.read();
if(mapmode == "3d")
mapper.write("\r\n"+"text_input "+x+" "+y+" "+z+quoted+tail);
else
mapper.write("\r\n"+"text_input "+x+" "+y+quoted+tail);
mapper.close();
bump_map_modified();
}

void write_ranged_text_input(double mnx, double mxx, double mny, double mxy, string title, string prompt, string answer, string char_filter, string submit_command, string incorrect_command, string exhausted_command, string cancel_command, int max_attempts, int max_length, bool whitelist, bool secure, bool case_sensitive, string escape_behavior, string exhaust_behavior, bool singleuse, double mnz=0, double mxz=0)
{
string c_title = string_replace(title, "\"", "", true);
string c_prompt = string_replace(prompt, "\"", "", true);
string c_answer = string_replace(answer, "\"", "", true);
string c_filter = string_replace(char_filter, "\"", "", true);
string c_submit = string_replace(submit_command, "\"", "", true);
string c_incorrect = string_replace(incorrect_command, "\"", "", true);
string c_exhausted = string_replace(exhausted_command, "\"", "", true);
string c_cancel = string_replace(cancel_command, "\"", "", true);
string quoted = " \""+c_title+"\" \""+c_prompt+"\" \""+c_answer+"\" \""+c_filter+"\" \""+c_submit+"\" \""+c_incorrect+"\" \""+c_exhausted+"\" \""+c_cancel+"\"";
string tail = " "+max_attempts+" "+max_length+" "+whitelist+" "+secure+" "+case_sensitive+" "+escape_behavior+" "+exhaust_behavior+" "+singleuse;
mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
mapdata=mapper.read();
if(mapmode == "3d")
mapper.write("\r\n"+"text_input "+mnx+" "+mxx+" "+mny+" "+mxy+" "+mnz+" "+mxz+quoted+tail);
else
mapper.write("\r\n"+"text_input "+mnx+" "+mxx+" "+mny+" "+mxy+quoted+tail);
mapper.close();
bump_map_modified();
}
