/* Records a performance played on an instrument and plays it back within the session. It captures note-ons
(with the category and starting pitch), note-offs, and pitch bends, each stamped with the gap since the last
event, so articulation and bends reproduce on playback. Recordings are session-only: there is no save or load. */

class inst_recorder
{
    bool recording = false;
    bool playing   = false;
    bool suppress_recording = false;
    dictionary record;
    int counter = 0;
    timer recordtimer;
    bool is_playing()
    {
        return playing;
    }
    bool is_recording()
    {
        return recording;
    }
    void recordcheck()
    {
        if (!is_playing() && alt_is_down() && key_pressed(KEY_P))
        {
            if (record.get_size() <= 0)
            {
                speak("Nothing recorded");
                return;
            }
            recording = false;
            playing = true;
            speak("playing");
            play_record();
        }
        if (!is_recording() && alt_is_down() && key_pressed(KEY_R))
        {
            for (uint i = 3; i >= 1; i--)
            {
beep_percentage(50);
speak(i);
                wait(1000);
                if (i == 1) break;
            }
beep_percentage(100);
            speak("recording!");
            recording = true;
            playing = false;
            recordtimer.restart();
            counter = 0;
            record.delete_all();
        }
        if (is_recording() && alt_is_down() && key_pressed(KEY_RETURN))
        {
            speak("recording stopped");
            recording = false;
        }
    }
    // Note-on: store the gap since the last event, the category (1 piano, 2 drum, 3 other), the pitch the
    // note starts at, and the clip to play.
    void record_note(const string &in path, int cad, int pitch)
    {
        if (!is_recording() || suppress_recording)
            return;
        counter++;
        int el = recordtimer.elapsed;
        recordtimer.restart();
        record.set("" + counter, "" + el + ":P:" + cad + ":" + pitch + ":" + path);
    }
    // Pitch bend: store the gap and the new pitch to apply to whatever notes are ringing on playback.
    void record_bend(int pitch)
    {
        if (!is_recording() || suppress_recording)
            return;
        counter++;
        int el = recordtimer.elapsed;
        recordtimer.restart();
        record.set("" + counter, "" + el + ":B:" + pitch);
    }
    // Note-off: store the gap and the category whose ringing note should be cut on playback.
    void record_stop(int cad)
    {
        if (!is_recording() || suppress_recording)
            return;
        counter++;
        int el = recordtimer.elapsed;
        recordtimer.restart();
        record.set("" + counter, "" + el + ":S:" + cad);
    }
    void play_record()
    {
        suppress_recording = true;
        int play_pianoslot = -1;
        int play_drumslot = -1;
        int play_otherslot = -1;
        for (int i = 1; i <= counter; i++)
        {
            string info;
            if (!record.get("" + i, info))
                continue;
            string[] parts = string_split(info, ":", false);
            if (parts.length() < 2)
                continue;
            int delay_ms = string_to_int(parts[0]);
            recordtimer.restart();
            bool breakout = false;
            while (recordtimer.elapsed < delay_ms)
            {
                wait(5);
                if (is_playing() && (key_pressed(KEY_RETURN) || key_pressed(KEY_R)))
                {
                    instpool.destroy_all();
                    speak("stopped");
                    breakout = true;
                    break;
                }
            }
            if (breakout)
                break;
            string type = parts[1];
            if (type == "P" && parts.length() >= 5)
            {
                // Note-on: delay:P:cad:pitch:path.
                int pitchval = string_to_int(parts[3]);
                string path = parts[4];
                // The clip path never contains a colon, but rejoin defensively in case a folder ever does.
                for (uint k = 5; k < parts.length(); k++)
                    path += ":" + parts[k];
                int slot = instpool.play_stationary(path, false);
                instpool.update_sound_start_values(slot, 0, 0, pitchval);
                if (parts[2] == "1")
                    play_pianoslot = slot;
                else if (parts[2] == "2")
                    play_drumslot = slot;
                else
                    play_otherslot = slot;
            }
            else if (type == "S" && parts.length() >= 3)
            {
                if (parts[2] == "1")
                {
                    if (play_pianoslot != -1) { instpool.destroy_sound(play_pianoslot); play_pianoslot = -1; }
                }
                else if (parts[2] == "2")
                {
                    if (play_drumslot != -1) { instpool.destroy_sound(play_drumslot); play_drumslot = -1; }
                }
                else
                {
                    if (play_otherslot != -1) { instpool.destroy_sound(play_otherslot); play_otherslot = -1; }
                }
            }
            else if (type == "B" && parts.length() >= 3)
            {
                // Apply the recorded pitch to whatever notes are currently ringing, as the live bend did.
                int pitchval = string_to_int(parts[2]);
                if (play_pianoslot != -1) instpool.update_sound_start_values(play_pianoslot, 0, 0, pitchval);
                if (play_drumslot != -1) instpool.update_sound_start_values(play_drumslot, 0, 0, pitchval);
                if (play_otherslot != -1) instpool.update_sound_start_values(play_otherslot, 0, 0, pitchval);
            }
        }
        suppress_recording = false;
        playing = false;
    }
}
