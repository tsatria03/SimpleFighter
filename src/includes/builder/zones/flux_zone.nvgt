/*
Flux zone -- a ranged region that nudges the player's own stats a little with EACH STEP taken on a
matching tile inside it. Unlike a tile zone (which SETS a value while you stand on it and reverts
when you leave), a flux zone PERMANENTLY accumulates: the change moves your real value and sticks
after you step off (the "faster the more I walk" idea). Four independent signed per-step amounts --
speed, health, stamina, shield -- each a whole number; positive ramps up, negative drains, 0 = off.
Silent (the ground's own step sounds play). No jump/fall knobs (jump is an odd fit, fall is landing-time).

Fully wired and live: data, lifecycle, read/write, the build form, the per-step apply logic
(fluxzone_step in playstep), and the menu/parser/clearmap wiring are all in place. Only the §5 help
topic + changelog remain.

On-disk map line (space-delimited, mode-dependent length; min/max y always present like the other zones):
  2d / topdown (10 tokens): flux_zone minx maxx miny maxy  surface speed_amount health_amount stamina_amount shield_amount
  3d          (12 tokens): flux_zone minx maxx miny maxy minz maxz  surface speed_amount health_amount stamina_amount shield_amount
surface is "any" or a platform tile name; each amount is a signed whole number, 0 = off. At step time
(a later section) the values apply to the player's own globals: player_own_speed (floor 1), health,
stamina, and shieldstrength (only while a shield is raised). Zone arrays are compacted (no null-guard),
like heal/safe zones.
*/
fluxzone@[] fluxzones(0);

class fluxzone
{
double minx, maxx, miny, maxy;
double minz, maxz;
string surface;
double speed_amount;
double health_amount;
double stamina_amount;
double shield_amount;
fluxzone(double mx, double mx2, double my, double my2, string surf, double sp, double hp, double st, double sh, double mnz=0, double mxz=0)
{
minx=mx;
maxx=mx2;
miny=my;
maxy=my2;
minz=mnz;
maxz=mxz;
surface=surf;
speed_amount=sp;
health_amount=hp;
stamina_amount=st;
shield_amount=sh;
}
}
// Is the player inside this zone's box? (z is only bounded on 3d.) The surface filter -- whether the
// tile underfoot actually matches -- is applied at step time, not here, so this stays pure geometry.
bool player_in_fluxzone(uint i)
{
if(!(fluxzones[i].minx<=me.x and fluxzones[i].maxx>=me.x and fluxzones[i].miny<=me.y and fluxzones[i].maxy>=me.y)) return false;
if(mapmode == "3d" and (me.z < fluxzones[i].minz or me.z > fluxzones[i].maxz)) return false;
return true;
}
void spawn_fluxzone(double x1, double x2, double y1, double y2, string surf, double sp, double hp, double st, double sh, double minz=0, double maxz=0)
{
fluxzone fz1(x1, x2, y1, y2, surf, sp, hp, st, sh, minz, maxz);
fluxzones.insert_last(fz1);
}
void destroy_all_fluxzones()
{
fluxzones.resize(0);
}

/*
Per-step stat accumulator. Called from playstep() once per real step onto walkable ground, using the
tile just stepped onto. For each flux zone the player stands in, apply the surface filter (the tile
underfoot must match the zone's surface unless that is "any"), then let the LATEST-built matching zone
win each knob -- the same layering as the tile zone, so you can carve a stronger or gentler pocket
inside a larger zone; a knob a zone leaves at 0 doesn't override the outer zone's value for that knob.
The winning amounts are added to the player's OWN values and STICK. Speed floors at 1 HERE (nothing else
floors player_own_speed, and modspeed<1 freezes movement); health/stamina/shield just take the delta
and let the game loop's existing clamps cap them, fire death at 0 health, and break the shield at 0
strength. The shield amount only acts while a shield is raised.
*/
void fluxzone_step()
{
if(fluxzones.length() == 0) return;
string underfoot = (mapmode == "3d") ? gmt(me.x, me.y, me.z) : gmt(me.x, me.y);
double eff_speed = 0, eff_health = 0, eff_stamina = 0, eff_shield = 0;   // 0 = no matching zone set this knob (0 is also "off")
for(uint i = 0; i < fluxzones.length(); i++)
{
if(!player_in_fluxzone(i)) continue;
if(fluxzones[i].surface != "any" && underfoot != fluxzones[i].surface) continue;
if(fluxzones[i].speed_amount != 0) eff_speed = fluxzones[i].speed_amount;
if(fluxzones[i].health_amount != 0) eff_health = fluxzones[i].health_amount;
if(fluxzones[i].stamina_amount != 0) eff_stamina = fluxzones[i].stamina_amount;
if(fluxzones[i].shield_amount != 0) eff_shield = fluxzones[i].shield_amount;
}
if(eff_speed != 0)
{
player_own_speed = int(player_own_speed + eff_speed);
if(player_own_speed < 1) player_own_speed = 1;
}
if(eff_health != 0) health += eff_health;
if(eff_stamina != 0) stamina += eff_stamina;
if(eff_shield != 0 && shieldon == 1) shieldstrength += eff_shield;
}

void read_flux_zone(string[] sd)
{
double mx=stn(sd[1]);
double mx2=stn(sd[2]);
double my=stn(sd[3]);
double my2=stn(sd[4]);
double mnz=0, mxz=0;
int o=5;
if(sd.length()==12)
{
mnz=stn(sd[5]);
mxz=stn(sd[6]);
o=7;
}
string surf=sd[o];
double sp=stn(sd[o+1]);
double hp=stn(sd[o+2]);
double st=stn(sd[o+3]);
double sh=stn(sd[o+4]);
spawn_fluxzone(mx, mx2, my, my2, surf, sp, hp, st, sh, mnz, mxz);
}
/* Tier 2 semantic check: flux_zone is a ranged box, a surface tile that exists (or "any"), and four
signed per-step numbers (speed, health, stamina, shield). Length-keyed z. */
string flux_zone_semantic_error(string[] sd, string mode, int &out col)
{
string e = coord_token_error(sd[1], "x", mode);
if(e != "") { col=1; return "the minimum x "+e+"."; }
e = coord_token_error(sd[2], "x", mode);
if(e != "") { col=2; return "the maximum x "+e+"."; }
if(range_token_error(sd[1], sd[2]) != "") { col=2; return "the maximum x is less than the minimum x."; }
e = coord_token_error(sd[3], "y", mode);
if(e != "") { col=3; return "the minimum y "+e+"."; }
e = coord_token_error(sd[4], "y", mode);
if(e != "") { col=4; return "the maximum y "+e+"."; }
if(range_token_error(sd[3], sd[4]) != "") { col=4; return "the maximum y is less than the minimum y."; }
int o = 5;
if(sd.length() == 12)
{
e = coord_token_error(sd[5], "z", mode);
if(e != "") { col=5; return "the minimum z "+e+"."; }
e = coord_token_error(sd[6], "z", mode);
if(e != "") { col=6; return "the maximum z "+e+"."; }
if(range_token_error(sd[5], sd[6]) != "") { col=6; return "the maximum z is less than the minimum z."; }
o = 7;
}
string surf = sd[o];
if(surf != "any" && !tile_exists(surf)) { col=o; return "the surface tile '"+surf+"' does not exist."; }
if(!is_number_token(sd[o+1])) { col=o+1; return "the speed step must be a number."; }
if(!is_number_token(sd[o+2])) { col=o+2; return "the health step must be a number."; }
if(!is_number_token(sd[o+3])) { col=o+3; return "the stamina step must be a number."; }
if(!is_number_token(sd[o+4])) { col=o+4; return "the shield step must be a number."; }
return "";
}

void write_flux_zone(double x1, double x2, double y1, double y2, string surface, double speed_amount, double health_amount, double stamina_amount, double shield_amount, double minz=0, double maxz=0)
{
mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
mapdata=mapper.read();
string coords=x1+" "+x2+" "+y1+" "+y2;
if(mapmode=="3d") coords+=" "+minz+" "+maxz;
mapper.write("\r\n"+"flux_zone "+coords+" "+surface+" "+speed_amount+" "+health_amount+" "+stamina_amount+" "+shield_amount);
mapper.close();
bump_map_modified();
}

void build_flux_zone()
{
string[] tiles_list = get_map_sound_folders("builder/construction/platforms/*");
if(tiles_list.length() == 0)
{
dlg("Error. There are no platforms available to view. Press enter to continue.");
resume_pools();
return;
}
// The minus sign is NOT in this set, so negative (draining) amount values can be typed; "." is in it,
// so only whole numbers are possible. Every amount field defaults to 0 (off), and all four show in
// every mode -- speed/health/stamina/shield aren't altitude-based, so nothing is hidden on topdown.
string disallowed_nums = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ `!@#$%^&*()[]{};:'\"\\|,<>?_/.+=~";
form.reset();
form.create_window("flux zone", false);
bool y_uses_back_front = mapmode != "2d";
string saved_my = y_uses_back_front ? (sel_back_set ? sel_back : "") : (sel_bottom_set ? sel_bottom : "");
string saved_my2 = y_uses_back_front ? (sel_front_set ? sel_front : "") : (sel_top_set ? sel_top : "");
int mx = form.create_input_box("minimum x", sel_left_set ? sel_left : "");
int mx2 = form.create_input_box("maximum x", sel_right_set ? sel_right : "");
int my = form.create_input_box("minimum y", saved_my);
int my2 = form.create_input_box("maximum y", saved_my2);
int mnz = -1, mxz = -1;
if(mapmode == "3d")
{
mnz = form.create_input_box("minimum z", sel_bottom_set ? sel_bottom : "");
mxz = form.create_input_box("maximum z", sel_top_set ? sel_top : "");
}
int sp = form.create_input_box("speed amount", "0");
int hp = form.create_input_box("health amount", "0");
int st = form.create_input_box("stamina amount", "0");
int sh = form.create_input_box("shield amount", "0");
form.set_disallowed_chars(mx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(mx2, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(my, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(my2, disallowed_nums, false, "This character is not allowed.");
if(mnz != -1) form.set_disallowed_chars(mnz, disallowed_nums, false, "This character is not allowed.");
if(mxz != -1) form.set_disallowed_chars(mxz, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(sp, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(hp, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(st, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(sh, disallowed_nums, false, "This character is not allowed.");
int surf_list = form.create_list("surface");
form.add_list_item(surf_list, "any", "any");
for(uint i = 0; i < tiles_list.length(); i++)
form.add_list_item(surf_list, tiles_list[i], tiles_list[i]);
form.set_list_position(surf_list, 0, false);
int ok = form.create_button("&okay", true);
int cn = form.create_button("&cancel");
form.focus(mx);
while(true)
{
wait(5);
form.monitor();
if(key_pressed(KEY_ESCAPE))
{
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(cn))
{
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(ok))
{
if(form.get_text(mx) == "")
{
speak("Minimum x is required.");
form.focus(mx);
continue;
}
if(form.get_text(mx2) == "")
{
speak("Maximum x is required.");
form.focus(mx2);
continue;
}
if(form.get_text(my) == "")
{
speak("Minimum y is required.");
form.focus(my);
continue;
}
if(form.get_text(my2) == "")
{
speak("Maximum y is required.");
form.focus(my2);
continue;
}
if(mnz != -1 && form.get_text(mnz) == "")
{
speak("Minimum z is required.");
form.focus(mnz);
continue;
}
if(mxz != -1 && form.get_text(mxz) == "")
{
speak("Maximum z is required.");
form.focus(mxz);
continue;
}
double bx = string_to_number(form.get_text(mx));
double bx2 = string_to_number(form.get_text(mx2));
double by = string_to_number(form.get_text(my));
double by2 = string_to_number(form.get_text(my2));
double bmnz = (mnz != -1) ? string_to_number(form.get_text(mnz)) : 0;
double bmxz = (mxz != -1) ? string_to_number(form.get_text(mxz)) : 0;
// Amounts are optional; an empty field means 0 (off).
double bsp = (form.get_text(sp) == "") ? 0 : string_to_number(form.get_text(sp));
double bhp = (form.get_text(hp) == "") ? 0 : string_to_number(form.get_text(hp));
double bst = (form.get_text(st) == "") ? 0 : string_to_number(form.get_text(st));
double bsh = (form.get_text(sh) == "") ? 0 : string_to_number(form.get_text(sh));
int p = form.get_list_position(surf_list);
string bsurf = (p > 0) ? tiles_list[p-1] : "any";
resume_pools();
write_flux_zone(bx, bx2, by, by2, bsurf, bsp, bhp, bst, bsh, bmnz, bmxz);
spawn_fluxzone(bx, bx2, by, by2, bsurf, bsp, bhp, bst, bsh, bmnz, bmxz);
load_map(mapname, mapowner);
mpool.play_stationary(get_pack_sound("main/characters/"+chartype+"/map/*update*"), false);
speak("Map updated.");
return;
}
}
}
