/*
Tile zone -- an invisible rectangular region that overrides how the ground underfoot
behaves. It has no sound and nothing to bump: it just quietly changes properties of the
tiles inside its box while the player stands on them. Every knob is optional, carrying a
-1 "leave unchanged" sentinel (or "any" for the surface filter) so a zone touches only
what the author actually set; a zone with everything left unchanged does nothing.

Knobs (all whole numbers, stored as double for uniformity with the double coords and
stn(); cast to int when applied to the int globals in the runtime loop):
  surface       -- which tile the overrides target: "any" = every tile in the box, or a
                   single platform tile name = only that tile type triggers them.
  speed         -- walk speed on those tiles, on the modspeed scale (normal 5). No upper
                   cap (a zone can exceed the player's own 1-20 keys); floor 1. -1 = unchanged.
  jump_height   -- jump height in the zone (normal 5). 0 = no jumping at all; no upper cap.
                   -1 = unchanged (distinct from the real value 0).
  fall_distance -- hard-landing threshold in squares (normal 8): a shorter drop is a free
                   soft landing, this or longer hurts. -1 = unchanged.
  fall_damage   -- the fallmod multiplier for how hard each fallen square hits past the
                   threshold (normal 21). -1 = unchanged.

Data, lifecycle, read/write, and the build form are in place; the per-frame
override/restore loop (tilezoneloop) and the menu/parser/clearmap wiring still come in a
later section, so nothing runs yet.
Zone arrays are compacted like the other zones (heal/safe): spawn appends, destroy_all
resizes to zero, and there is no per-element sentinel removal because zones aren't
destroyable.

On-disk map line (space-delimited, mode-dependent length), mirroring the other zones'
always-present min/max y:
  2d / topdown (10 tokens): tile_zone minx maxx miny maxy  surface speed jump_height fall_distance fall_damage
  3d          (12 tokens): tile_zone minx maxx miny maxy minz maxz  surface speed jump_height fall_distance fall_damage
surface is "any" or a platform tile name; each numeric knob is a whole number or the -1
"leave unchanged" sentinel.
*/
tilezone@[] tilezones(0);

class tilezone
{
bool in_zone;
double minx, maxx, miny, maxy;
double minz, maxz;
string surface;
double speed;
double jump_height;
double fall_distance;
double fall_damage;
tilezone(double mx, double mx2, double my, double my2, string surf, double spd, double jh, double fd, double fdmg, double mnz=0, double mxz=0)
{
minx=mx;
maxx=mx2;
miny=my;
maxy=my2;
minz=mnz;
maxz=mxz;
surface=surf;
speed=spd;
jump_height=jh;
fall_distance=fd;
fall_damage=fdmg;
}
}
// Is the player inside this zone's box? (z is only bounded on 3d.) The surface filter
// -- whether the tile underfoot actually matches -- is applied in the runtime loop, not
// here, so this stays pure geometry like player_in_healzone.
bool player_in_tilezone(uint i)
{
if(!(tilezones[i].minx<=me.x and tilezones[i].maxx>=me.x and tilezones[i].miny<=me.y and tilezones[i].maxy>=me.y)) return false;
if(mapmode == "3d" and (me.z < tilezones[i].minz or me.z > tilezones[i].maxz)) return false;
return true;
}
void spawn_tilezone(double x1, double x2, double y1, double y2, string surf, double spd, double jh, double fd, double fdmg, double minz=0, double maxz=0)
{
tilezone tz1(x1, x2, y1, y2, surf, spd, jh, fd, fdmg, minz, maxz);
tilezones.insert_last(tz1);
}
void destroy_all_tilezones()
{
tilezones.resize(0);
}

void read_tile_zone(string[] sd)
{
double mx=stn(sd[1]);
double mx2=stn(sd[2]);
double my=stn(sd[3]);
double my2=stn(sd[4]);
double mnz=0, mxz=0;
int o=5;
if(sd.length()==12)
{
mnz=stn(sd[5]);
mxz=stn(sd[6]);
o=7;
}
string surf=sd[o];
double spd=stn(sd[o+1]);
double jh=stn(sd[o+2]);
double fd=stn(sd[o+3]);
double fdmg=stn(sd[o+4]);
spawn_tilezone(mx, mx2, my, my2, surf, spd, jh, fd, fdmg, mnz, mxz);
}

void write_tile_zone(double x1, double x2, double y1, double y2, string surface, double speed, double jump_height, double fall_distance, double fall_damage, double minz=0, double maxz=0)
{
mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
mapdata=mapper.read();
string coords=x1+" "+x2+" "+y1+" "+y2;
if(mapmode=="3d") coords+=" "+minz+" "+maxz;
mapper.write("\r\n"+"tile_zone "+coords+" "+surface+" "+speed+" "+jump_height+" "+fall_distance+" "+fall_damage);
mapper.close();
bump_map_modified();
}

void build_tile_zone()
{
string[] tiles_list = get_map_sound_folders("builder/construction/platforms/*");
if(tiles_list.length() == 0)
{
dlg("Error. There are no platforms available to view. Press enter to continue.");
resume_pools();
return;
}
string disallowed_nums = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ `!@#$%^&*()[]{};:'\"\\|,<>?_/.+=~";
form.reset();
form.create_window("tile zone", false);
// A tile zone is offered in every mode. On topdown, only surface and speed apply --
// jump height and the two fall knobs are altitude-based, so they're hidden and written
// as -1. Every numeric knob is an input box (no cap = no slider) pre-filled with -1
// "leave unchanged"; surface is a list with "any" (every tile) at the top.
bool full_form = mapmode != "topdown";
bool y_uses_back_front = mapmode != "2d";
string saved_my = y_uses_back_front ? (sel_back_set ? sel_back : "") : (sel_bottom_set ? sel_bottom : "");
string saved_my2 = y_uses_back_front ? (sel_front_set ? sel_front : "") : (sel_top_set ? sel_top : "");
int mx = form.create_input_box("minimum x", sel_left_set ? sel_left : "");
int mx2 = form.create_input_box("maximum x", sel_right_set ? sel_right : "");
int my = form.create_input_box("minimum y", saved_my);
int my2 = form.create_input_box("maximum y", saved_my2);
int mnz = -1, mxz = -1;
if(mapmode == "3d")
{
mnz = form.create_input_box("minimum z", sel_bottom_set ? sel_bottom : "");
mxz = form.create_input_box("maximum z", sel_top_set ? sel_top : "");
}
int spd = form.create_input_box("speed", "-1");
int jh = -1, fd = -1, fdmg = -1;
if(full_form)
{
jh = form.create_input_box("jump height", "-1");
fd = form.create_input_box("fall distance", "-1");
fdmg = form.create_input_box("fall damage", "-1");
}
form.set_disallowed_chars(mx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(mx2, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(my, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(my2, disallowed_nums, false, "This character is not allowed.");
if(mnz != -1) form.set_disallowed_chars(mnz, disallowed_nums, false, "This character is not allowed.");
if(mxz != -1) form.set_disallowed_chars(mxz, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(spd, disallowed_nums, false, "This character is not allowed.");
if(full_form)
{
form.set_disallowed_chars(jh, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(fd, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(fdmg, disallowed_nums, false, "This character is not allowed.");
}
int surf_list = form.create_list("surface");
form.add_list_item(surf_list, "any", "any");
for(uint i = 0; i < tiles_list.length(); i++)
form.add_list_item(surf_list, tiles_list[i], tiles_list[i]);
form.set_list_position(surf_list, 0, false);
int ok = form.create_button("&okay", true);
int cn = form.create_button("&cancel");
form.focus(mx);
while(true)
{
wait(5);
form.monitor();
if(key_pressed(KEY_ESCAPE))
{
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(cn))
{
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(ok))
{
if(form.get_text(mx) == "")
{
speak("Minimum x is required.");
form.focus(mx);
continue;
}
if(form.get_text(mx2) == "")
{
speak("Maximum x is required.");
form.focus(mx2);
continue;
}
if(form.get_text(my) == "")
{
speak("Minimum y is required.");
form.focus(my);
continue;
}
if(form.get_text(my2) == "")
{
speak("Maximum y is required.");
form.focus(my2);
continue;
}
if(mnz != -1 && form.get_text(mnz) == "")
{
speak("Minimum z is required.");
form.focus(mnz);
continue;
}
if(mxz != -1 && form.get_text(mxz) == "")
{
speak("Maximum z is required.");
form.focus(mxz);
continue;
}
// Knobs are optional: an empty field means -1 "leave unchanged", never 0.
double bspd = (form.get_text(spd) == "") ? -1 : string_to_number(form.get_text(spd));
double bjh = (full_form && form.get_text(jh) != "") ? string_to_number(form.get_text(jh)) : -1;
double bfd = (full_form && form.get_text(fd) != "") ? string_to_number(form.get_text(fd)) : -1;
double bfdmg = (full_form && form.get_text(fdmg) != "") ? string_to_number(form.get_text(fdmg)) : -1;
if(bspd != -1 && bspd < 1)
{
speak("Speed must be at least 1, or -1 to leave it unchanged.");
form.focus(spd);
continue;
}
if(full_form && bjh != -1 && bjh < 0)
{
speak("Jump height must be 0 or higher, or -1 to leave it unchanged.");
form.focus(jh);
continue;
}
if(full_form && bfd != -1 && bfd < 0)
{
speak("Fall distance must be 0 or higher, or -1 to leave it unchanged.");
form.focus(fd);
continue;
}
if(full_form && bfdmg != -1 && bfdmg < 0)
{
speak("Fall damage must be 0 or higher, or -1 to leave it unchanged.");
form.focus(fdmg);
continue;
}
double bx = string_to_number(form.get_text(mx));
double bx2 = string_to_number(form.get_text(mx2));
double by = string_to_number(form.get_text(my));
double by2 = string_to_number(form.get_text(my2));
double bmnz = (mnz != -1) ? string_to_number(form.get_text(mnz)) : 0;
double bmxz = (mxz != -1) ? string_to_number(form.get_text(mxz)) : 0;
int p = form.get_list_position(surf_list);
string bsurf = (p > 0) ? tiles_list[p-1] : "any";
resume_pools();
write_tile_zone(bx, bx2, by, by2, bsurf, bspd, bjh, bfd, bfdmg, bmnz, bmxz);
spawn_tilezone(bx, bx2, by, by2, bsurf, bspd, bjh, bfd, bfdmg, bmnz, bmxz);
load_map(mapname, mapowner);
mpool.play_stationary(get_pack_sound("main/characters/"+chartype+"/map/*update*"), false);
speak("Map updated.");
return;
}
}
}
