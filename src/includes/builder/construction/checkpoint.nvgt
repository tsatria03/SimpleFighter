sound_pool checkpool;
checkpoint@[]checkpoints(0);
checkpoint@ last_checkpoint = null;

class checkpoint
{
int getsound, checksound;
bool looping;
int checkx;
int checky;
int checkz;
int checktime;
string checktype;
timer checktimer;
checkpoint(int ckx,int cky,int ckspeed,string cktype,int ckz=0,bool lps=false)
{
checkx=ckx;
checky=cky;
checkz=ckz;
checktime=ckspeed;
checktype=cktype;
looping=lps;
if(looping==true)
checksound=checkpool.play_extended_3d(get_map_sound("builder/construction/checkpoints/"+checktype+"/*loop*"),me.x,me.y,me.z,checkx,checky,checkz,calculate_theta(me_rotation),0,0,0,0,0,0,true,0,0,0,100,false);
}
}
void checkdeath()
{
if(health<=0 and lifecard<=1)
{
playerdeath();
}
}
// On a MAP death or checkpoint respawn, drop the player's movement stats back to their defaults.
// Speed and jump height can be pushed up by the player's own keys (and, once built, a tile zone's
// per-step ramp), and charparse() -- which resets the rest of the character -- deliberately doesn't
// touch them, so without this a jacked-up speed or jump would survive death. Arena deaths run their
// own reset (resetgame / save-slot restore), so this is only ever called on the map side.
void reset_move_stats()
{
player_own_speed = 5;
modspeed = 5;
player_own_jump = 5;
jumpheight = 5;
}
void playerdeath()
{
bool was_arena = arena_active;   // captured before clearmap() ends the arena
if(last_checkpoint!is null)
{
restore_last_checkpoint();
}
else if(lifecard<=1)
{
wepdef=0;
drawnshield=false;
fireable=true;
jumpable=true;
moveable=true;
shieldon=0;
shieldweight=1;
shieldtype="none";
shieldparse();
p.destroy_sound(painslot);
p.destroy_sound(refslot);
p.destroy_sound(shieldloop);
p.destroy_sound(shieldslot);
dlgplay(get_pack_sound("main/characters/"+chartype+"/general/*death*"), true, true, 30);
dlgplay(get_map_sound("builder/construction/platforms/"+gmt(me.x,me.y)+"/*fall*"));
clearmap(true);
if(!was_arena) reset_move_stats();   // map death: clear any ramped speed/jump back to 5 (the arena runs its own reset)
show_death_prompt(was_arena);
}
}
bool acquire_checkpoint()
{
for(uint i=0; i<checkpoints.length(); i++)
{
if(@checkpoints[i] == null) continue;
bool match = me.x==checkpoints[i].checkx and me.y==checkpoints[i].checky;
if(mapmode == "3d") match = match and me.z==checkpoints[i].checkz;
if(match)
{
checkpoints[i].getsound=checkpool.play_stationary_extended(get_map_sound("builder/construction/checkpoints/"+checkpoints[i].checktype+"/*get*"),false,0,0,0,100,false);
if(checkpoints[i].looping) checkpool.destroy_sound(checkpoints[i].checksound);
@last_checkpoint=checkpoints[i];
@checkpoints[i] = null;
return true;
}
}
return false;
}
void restore_last_checkpoint()
{
checkpool.play_stationary_extended(get_map_sound("builder/construction/checkpoints/"+last_checkpoint.checktype+"/*get*"),false,0,0,0,100,false);
me.x=last_checkpoint.checkx;
me.y=last_checkpoint.checky;
if(mapmode == "3d") me.z=last_checkpoint.checkz;
health=maxhealth;
reset_move_stats();   // a checkpoint respawn also clears a ramped speed/jump back to 5
load_map(mapname, mapowner, force_compiled:map_is_compiled, force_spawned:true);
}
void cploop()
{
for(uint i=0; i<checkpoints.length(); i++)
{
if(@checkpoints[i] == null) continue;
if(!checkpoints[i].looping and checkpoints[i].checktimer.elapsed>=checkpoints[i].checktime)
{
checkpoints[i].checksound=checkpool.play_extended_3d(get_map_sound("builder/construction/checkpoints/"+checkpoints[i].checktype+"/*loop*"),me.x,me.y,me.z,checkpoints[i].checkx,checkpoints[i].checky,checkpoints[i].checkz,calculate_theta(me_rotation),0,0,0,0,0,0,false,0,0,0,100,false);
checkpoints[i].checktimer.restart();
}
}
acquire_checkpoint();
}
void spawn_checkpoint(int x,int y,int speed,string checktype,int z=0,bool looping=false)
{
checkpoint cp1(x,y,speed,checktype,z,looping);
checkpoints.insert_last(cp1);
}
void destroy_all_checkpoints()
{
for(uint i=0; i<checkpoints.length(); i++)
{
if(@checkpoints[i] == null) continue;
checkpool.destroy_sound(checkpoints[i].checksound);
}
checkpoints.resize(0);
@last_checkpoint = null;
}

void build_checkpoint()
{
string[] checks_list = get_map_sound_folders("builder/construction/checkpoints/*");
if(checks_list.length() == 0)
{
dlg("Error. There are no checkpoints available to view. Press enter to continue.");
resume_pools();
return;
}
string disallowed_nums = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ `!@#$%^&*()[]{};:'\"\\|,<>?_/.+=~";
form.reset();
form.create_window("checkpoint", false);
bool y_uses_back_front = mapmode != "2d";
int mx = form.create_input_box("x", sel_left_set ? sel_left : "");
int my = form.create_input_box("y", y_uses_back_front ? (sel_back_set ? sel_back : "") : (sel_bottom_set ? sel_bottom : ""));
int mz = -1;
if(mapmode == "3d") mz = form.create_input_box("z", sel_bottom_set ? sel_bottom : "");
int sp = form.create_input_box("speed", "350");
form.set_disallowed_chars(mx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(my, disallowed_nums, false, "This character is not allowed.");
if(mz != -1) form.set_disallowed_chars(mz, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(sp, disallowed_nums, false, "This character is not allowed.");
int check_list = form.create_list("checkpoint sound");
form.add_list_item(check_list, "none", "none");
for(uint i = 0; i < checks_list.length(); i++)
form.add_list_item(check_list, checks_list[i], checks_list[i]);
form.set_list_position(check_list, 0, false);
int loop_cb = form.create_checkbox("looping sound", false);
int ok = form.create_button("&okay", true);
int cn = form.create_button("&cancel");
form.focus(mx);
while(true)
{
wait(5);
form.monitor();
int cur_focus = form.get_current_focus();
if(key_down(KEY_SPACE) && keytimer.elapsed >= keytime)
{
t.destroy_sound(prevslot);
if(cur_focus == check_list)
{
int p = form.get_list_position(check_list);
if(p > 0) prevslot = t.play_stationary(get_map_sound("builder/construction/checkpoints/"+checks_list[p-1]+"/*get*"), false);
}
keytimer.restart();
}
if(cur_focus == check_list && control_is_down() && key_repeating(KEY_L))
{
int p = form.get_list_position(check_list);
if(p > 0)
{
t.destroy_sound(prevslot);
prevslot = t.play_stationary(get_map_sound("builder/construction/checkpoints/"+checks_list[p-1]+"/*loop*"), false);
}
}
if(key_pressed(KEY_ESCAPE))
{
t.destroy_sound(prevslot);
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(cn))
{
t.destroy_sound(prevslot);
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(ok))
{
if(form.get_text(mx) == "")
{
speak("X is required.");
form.focus(mx);
continue;
}
if(form.get_text(my) == "")
{
speak("Y is required.");
form.focus(my);
continue;
}
if(mz != -1 && form.get_text(mz) == "")
{
speak("Z is required.");
form.focus(mz);
continue;
}
if(form.get_text(sp) == "")
{
speak("Speed is required.");
form.focus(sp);
continue;
}
int bx = string_to_number(form.get_text(mx));
int by = string_to_number(form.get_text(my));
int bz = (mz != -1) ? string_to_number(form.get_text(mz)) : 0;
int bsp = string_to_number(form.get_text(sp));
int p = form.get_list_position(check_list);
string btype = (p > 0) ? checks_list[p-1] : "none";
bool bloop = form.is_checked(loop_cb);
t.destroy_sound(prevslot);
resume_pools();
write_checkpoint(bx, by, bsp, btype, bz, bloop);
spawn_checkpoint(bx, by, bsp, btype, bz, bloop);
load_map(mapname, mapowner, force_compiled:map_is_compiled, force_spawned:true);
mpool.play_stationary(get_pack_sound("main/characters/"+chartype+"/map/*update*"), false);
speak("Map updated.");
return;
}
}
}

void read_checkpoint(string[] sd)
{
int x=stn(sd[1]);
int y=stn(sd[2]);
int z=0;
int o=3;
if(mapmode=="3d") { z=stn(sd[3]); o=4; }
int checktime=stn(sd[o]);
string checktype=sd[o+1];
bool lps=string_to_bool(sd[o+2]);
spawn_checkpoint(x, y, checktime, checktype, z, lps);
}
/* Tier 2 semantic check: coordinates in the map, a numeric speed, a checkpoint sound that exists
(or "none" for silent), and a true/false looping flag. Mirrors read_checkpoint's length-keyed z.
This is the first entity to use name_exists (its sound folder must be a real one on disk). */
string checkpoint_semantic_error(string[] sd, string mode, int &out col)
{
string e = coord_token_error(sd[1], "x", mode);
if(e != "") { col = 1; return "the x coordinate "+e+"."; }
e = coord_token_error(sd[2], "y", mode);
if(e != "") { col = 2; return "the y coordinate "+e+"."; }
int o = 3;
if(mode == "3d")
{
e = coord_token_error(sd[3], "z", mode);
if(e != "") { col = 3; return "the z coordinate "+e+"."; }
o = 4;
}
if(!is_number_token(sd[o])) { col = o; return "the speed must be a number."; }
string ctype = sd[o+1];
if(ctype != "none" && !name_exists("builder/construction/checkpoints/*", ctype)) { col = o+1; return "the checkpoint sound '"+ctype+"' does not exist."; }
if(!is_bool_token(sd[o+2])) { col = o+2; return "the looping value must be true or false."; }
return "";
}

void write_checkpoint(int x, int y, int speed, string checktype, int z=0, bool looping=false)
{
mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
mapdata=mapper.read();
if(mapmode == "3d")
mapper.write("\r\n"+"checkpoint "+x+" "+y+" "+z+" "+speed+" "+checktype+" "+looping);
else
mapper.write("\r\n"+"checkpoint "+x+" "+y+" "+speed+" "+checktype+" "+looping);
mapper.close();
bump_map_modified();
}
