/*
Slant -- a directional ramp. A horizontal footprint plus a single base height that
rises by step_height whole levels per tile along its direction. The bottom surface is
a diagonal run of floor tiles; the top surface is a flat landing at the high end.
The constructor lays the floor via spawn_surfaces(); slantcheck() -- run each frame
just BEFORE fallcheck() -- keeps the player glued to the ramp as they walk. Still to be
wired into the builder menu, the map parser, the game loop, and clearmap (Section 5),
so nothing runs yet.
*/
slant@[] slants(0);
int player_slant = -1;
class slant
{
double minx, maxx, miny, maxy;
double base_height;
double step_height;
string direction;
string bottom_tile;
double bottom_volume, bottom_pitch;
string top_tile;
double top_volume, top_pitch;
int[] platform_ids;
slant(double mnx, double mxx, double mny, double mxy, double bs, double sh, string dir, string btile, double bvol, double bpit, string ttile, double tvol, double tpit)
{
minx=mnx;
maxx=mxx;
miny=mny;
maxy=mxy;
base_height=bs;
step_height=sh;
direction=dir;
bottom_tile=btile;
bottom_volume=bvol;
bottom_pitch=bpit;
top_tile=ttile;
top_volume=tvol;
top_pitch=tpit;
spawn_surfaces();
}
// The ramp surface height at a horizontal position. axis is x for left/right ramps,
// y for forward/backward; the height rises step_height per tile from the low end.
// Passing the same axis coordinate in both slots (surface_height(p, p)) yields the
// height at column p regardless of which axis the ramp climbs.
double surface_height(double x, double y)
{
string d = string_replace(direction, "_", "", true);
bool axis_is_x = (d == "leftup" || d == "leftdown" || d == "rightup" || d == "rightdown");
bool rises_positive = (d == "rightup" || d == "leftdown" || d == "forwardup" || d == "backwarddown");
double axis_min = axis_is_x ? minx : miny;
double axis_max = axis_is_x ? maxx : maxy;
double p = axis_is_x ? x : y;
return rises_positive ? (base_height + step_height * (p - axis_min)) : (base_height + step_height * (axis_max - p));
}
// Is (x, y) inside the ramp's horizontal footprint? (y is only bounded on 3d.)
bool contains(double x, double y)
{
if(x < minx || x > maxx) return false;
if(mapmode == "3d" && (y < miny || y > maxy)) return false;
return true;
}
/*
Lay the ramp's floor. The bottom surface is a diagonal run of one floor tile per
column along the ramp axis, each at that column's computed height (base + step*n).
The top surface is a single flat landing one tile past the high end, at the top
height, spanning the ramp's width, so stepping off the top lands on ground. Either
surface is skipped when its tile is "none". All tiles are plain, non-destroyable,
non-overlap platforms. Heights are whole (base and step are whole numbers), so every
tile sits at a whole level. y/left-right ramps rise along x; forward/backward along y.
*/
void spawn_surfaces()
{
string d = string_replace(direction, "_", "", true);
bool axis_is_x = (d == "leftup" || d == "leftdown" || d == "rightup" || d == "rightdown");
bool rises_positive = (d == "rightup" || d == "leftdown" || d == "forwardup" || d == "backwarddown");
double axis_min = axis_is_x ? minx : miny;
double axis_max = axis_is_x ? maxx : maxy;
double top_height = base_height + step_height * (axis_max - axis_min);
if(bottom_tile != "none")
{
for(double p = axis_min; p <= axis_max; p++)
{
double h = surface_height(p, p);
if(axis_is_x)
{
if(mapmode == "3d")
platform_ids.insert_last(spawn_platform(p, p, miny, maxy, 1, 1, bottom_tile, bottom_volume, bottom_pitch, false, false, false, h));
else
platform_ids.insert_last(spawn_platform(p, p, h, h, 1, 1, bottom_tile, bottom_volume, bottom_pitch, false, false, false));
}
else
platform_ids.insert_last(spawn_platform(minx, maxx, p, p, 1, 1, bottom_tile, bottom_volume, bottom_pitch, false, false, false, h));
}
}
if(top_tile != "none")
{
if(axis_is_x)
{
double lx = rises_positive ? (axis_max + 1) : (axis_min - 1);
if(mapmode == "3d")
platform_ids.insert_last(spawn_platform(lx, lx, miny, maxy, 1, 1, top_tile, top_volume, top_pitch, false, false, false, top_height));
else
platform_ids.insert_last(spawn_platform(lx, lx, top_height, top_height, 1, 1, top_tile, top_volume, top_pitch, false, false, false));
}
else
{
double ly = rises_positive ? (axis_max + 1) : (axis_min - 1);
platform_ids.insert_last(spawn_platform(minx, maxx, ly, ly, 1, 1, top_tile, top_volume, top_pitch, false, false, false, top_height));
}
}
}
}
int spawn_slant(double mnx, double mxx, double mny, double mxy, double bs, double sh, string dir, string btile, double bvol, double bpit, string ttile, double tvol, double tpit)
{
slant s(mnx, mxx, mny, mxy, bs, sh, dir, btile, bvol, bpit, ttile, tvol, tpit);
slants.insert_last(s);
return slants.length() - 1;
}
void remove_slant(int id)
{
if(id >= 0 && id < slants.length() && @slants[id] != null)
{
@slants[id] = null;
}
}
void destroy_all_slants()
{
slants.resize(0);
player_slant = -1;
}

/*
Jump-landing predicates, the slant analogue of is_staircase_top / in_staircase_volume. A slant is a
diagonal wedge -- base_height up to the per-column surface_height -- not a solid box, so a jump arc can
sail over the thin surface tile without ever coinciding with it (staircase tiles are backing, hidden
from user_platform_at, which is why the staircase always needed these; the slant needs them for the
same "don't jump straight over me" reason). cur is the height axis: me.z on 3d, me.y on 2d.
slant_surface_at returns the covering slant's surface height at that column (-1 = none) so a landing
can SNAP to the ramp surface, since -- unlike the staircase's flat top -- each column sits at its own
height.
*/
double slant_surface_at(double x, double y)
{
for(uint i = 0; i < slants.length(); i++)
{
if(@slants[i] == null) continue;
if(slants[i].contains(x, y)) return slants[i].surface_height(x, y);
}
return -1;
}
bool is_slant_surface(double x, double y, double z)
{
double cur = (mapmode == "3d") ? z : y;
for(uint i = 0; i < slants.length(); i++)
{
if(@slants[i] == null) continue;
if(slants[i].contains(x, y) && cur == slants[i].surface_height(x, y)) return true;
}
return false;
}
bool in_slant_volume(double x, double y, double z)
{
double cur = (mapmode == "3d") ? z : y;
for(uint i = 0; i < slants.length(); i++)
{
if(@slants[i] == null) continue;
if(slants[i].contains(x, y) && cur >= slants[i].base_height && cur <= slants[i].surface_height(x, y)) return true;
}
return false;
}

/*
Called at the very top of playstep(). Runs the full slant attach/snap (slantcheck) so the
player is on the ramp surface BEFORE the footstep reads the tile underfoot. Running the
full logic (not just a snap) also covers the FIRST step onto a ramp: player_slant isn't
set until slantcheck runs later in the frame, so without detecting-and-snapping here that
first step would sound whatever floor sits underneath the ramp, not the ramp's own tile.
*/
void slant_snap_player()
{
slantcheck();
}

/*
Per-frame elevation follow. While the player is on a slant, force their vertical
coordinate (me.y on 2d, me.z on 3d) to the ramp surface under them and clear the fall
state, so walking along the ramp carries them up/down instead of falling between the
diagonal floor tiles. If a fall was already underway when the ramp re-catches them, its
fall sound is destroyed too (guarded on falling) so it doesn't keep playing after they land
back on -- mirroring the destroy in fallcheck's landing. MUST be called immediately BEFORE fallcheck() in the main loop:
otherwise the frame after a horizontal step leaves the player unsupported at the old
height and fallcheck starts a fall before this can correct it. The player counts as
"on" a slant when they are within the footprint at a height inside the ramp's body
(base..surface at their column) -- so you re-attach by walking into the footprint from
the side or below, not only when standing exactly on the surface tile; they come off by
walking out of the footprint. Guarded like fallcheck (skips hooks/vehicles/gliders/jumps).
*/
void slantcheck()
{
if(mapmode == "topdown") return;
if(onhook) return;
if(doormove || elvmove || invehicle || inplain) return;
if(glider_engine_on) return;
if(jumping != 0) return;
if(player_slant != -1)
{
if(player_slant >= 0 && player_slant < int(slants.length()) && @slants[player_slant] != null && slants[player_slant].contains(me.x, me.y))
{
double h = slants[player_slant].surface_height(me.x, me.y);
double cur = (mapmode == "3d") ? me.z : me.y;
if(cur != h)
{
if(mapmode == "3d") me.z = h;
else me.y = h;
if(falling) p.destroy_sound(fallslot);
falling = false;
fallcounter = 0;
}
return;
}
player_slant = -1;
}
for(uint i = 0; i < slants.length(); i++)
{
if(@slants[i] == null) continue;
if(!slants[i].contains(me.x, me.y)) continue;
double h = slants[i].surface_height(me.x, me.y);
double cur = (mapmode == "3d") ? me.z : me.y;
// Attach when the player is within the ramp's solid body at this column -- anywhere
// from its base height up to the surface -- so you get back onto the hill when you
// walk into its footprint from the side or from below, not only when standing exactly
// on the surface tile. Above the surface is a fall/jump landing, handled elsewhere.
if(cur >= slants[i].base_height && cur <= h)
{
player_slant = int(i);
if(cur != h)
{
if(mapmode == "3d") me.z = h;
else me.y = h;
if(falling) p.destroy_sound(fallslot);
falling = false;
fallcounter = 0;
}
return;
}
}
}

/*
Camera analog of the player's slant follow. While the camera sits horizontally over a
slant footprint, ride the ramp: force the camera's vertical coordinate (cam.y on 2d,
cam.z on 3d) to the ramp surface at that column, so the describe (G+R) and playback
(G+T) keys report and play the ramp's own surface tile and its climbing height, instead
of the flat plane the camera would otherwise sweep straight past the diagonal tiles.
Called at the top of playcam() and of the camera describe read. Unlike the player's
base..surface body test this snaps unconditionally over the footprint -- the camera
always rides the surface, so there is no empty height to hunt for.
*/
void slant_camera()
{
if(mapmode == "topdown") return;
for(uint i = 0; i < slants.length(); i++)
{
if(@slants[i] == null) continue;
if(!slants[i].contains(cam.x, cam.y)) continue;
double h = slants[i].surface_height(cam.x, cam.y);
if(mapmode == "3d") cam.z = h;
else cam.y = h;
return;
}
}

/*
On-disk map line (space-delimited, mode-dependent length):
  2d (12 tokens): slant minx maxx base direction step_height  bottomtile bottomvol bottompitch  toptile topvol toppitch
  3d (14 tokens): slant minx maxx miny maxy base direction step_height  bottomtile bottomvol bottompitch  toptile topvol toppitch
base is the low-end elevation; the top height is computed from step_height, not stored.
A surface's tile is the literal "none" to opt out. direction is an underscored token
(left_up/left_down/right_up/right_down/forward_up/forward_down/backward_up/backward_down);
comparisons strip underscores, so older no-underscore tokens (rightup) still load.
*/
void read_slant(string[] sd)
{
double mnx=stn(sd[1]);
double mxx=stn(sd[2]);
double mny=0, mxy=0;
int o=3;
if(sd.length()==14)
{
mny=stn(sd[3]);
mxy=stn(sd[4]);
o=5;
}
double base=stn(sd[o]);
string dir=sd[o+1];
double sh=stn(sd[o+2]);
string btile=sd[o+3];
double bvol=stn(sd[o+4]);
double bpit=stn(sd[o+5]);
string ttile=sd[o+6];
double tvol=stn(sd[o+7]);
double tpit=stn(sd[o+8]);
spawn_slant(mnx, mxx, mny, mxy, base, sh, dir, btile, bvol, bpit, ttile, tvol, tpit);
}
/* Tier 2 semantic check: slant has an x range (plus a y range on 3d), a base elevation, a direction
word, a slope amount, and two tile groups (bottom + top, each a tile-or-"none" with volume/pitch).
Length 12 (2d) / 14 (3d). The direction is a word like right_up; comparisons strip underscores. */
string slant_semantic_error(string[] sd, string mode, int &out col)
{
bool is3d = (sd.length() == 14);
string e = coord_token_error(sd[1], "x", mode);
if(e != "") { col=1; return "the minimum x "+e+"."; }
e = coord_token_error(sd[2], "x", mode);
if(e != "") { col=2; return "the maximum x "+e+"."; }
if(range_token_error(sd[1], sd[2]) != "") { col=2; return "the maximum x is less than the minimum x."; }
int o = 3;
if(is3d)
{
e = coord_token_error(sd[3], "y", mode);
if(e != "") { col=3; return "the minimum y "+e+"."; }
e = coord_token_error(sd[4], "y", mode);
if(e != "") { col=4; return "the maximum y "+e+"."; }
if(range_token_error(sd[3], sd[4]) != "") { col=4; return "the maximum y is less than the minimum y."; }
o = 5;
}
e = coord_token_error(sd[o], is3d ? "z" : "y", mode);
if(e != "") { col=o; return "the base height "+e+"."; }
string dstrip = string_replace(sd[o+1], "_", "", true);
bool validdir = (dstrip=="leftup"||dstrip=="leftdown"||dstrip=="rightup"||dstrip=="rightdown");
if(is3d) validdir = validdir || (dstrip=="forwardup"||dstrip=="forwarddown"||dstrip=="backwardup"||dstrip=="backwarddown");
if(!validdir) { col=o+1; return "the direction '"+sd[o+1]+"' is not a valid slant direction."; }
if(!is_number_token(sd[o+2])) { col=o+2; return "the slope amount must be a number."; }
string btile = sd[o+3];
if(btile != "none" && !name_exists("builder/construction/platforms/*", btile)) { col=o+3; return "the bottom tile '"+btile+"' does not exist."; }
if(!is_number_token(sd[o+4])) { col=o+4; return "the bottom volume must be a number."; }
if(!is_number_token(sd[o+5])) { col=o+5; return "the bottom pitch must be a number."; }
string ttile = sd[o+6];
if(ttile != "none" && !name_exists("builder/construction/platforms/*", ttile)) { col=o+6; return "the top tile '"+ttile+"' does not exist."; }
if(!is_number_token(sd[o+7])) { col=o+7; return "the top volume must be a number."; }
if(!is_number_token(sd[o+8])) { col=o+8; return "the top pitch must be a number."; }
return "";
}

void write_slant(double mnx, double mxx, double mny, double mxy, double base, double sh, string dir, string btile, double bvol, double bpit, string ttile, double tvol, double tpit)
{
mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
mapdata=mapper.read();
string coords=mnx+" "+mxx;
if(mapmode=="3d") coords+=" "+mny+" "+mxy;
coords+=" "+base;
mapper.write("\r\n"+"slant "+coords+" "+dir+" "+sh+" "+btile+" "+bvol+" "+bpit+" "+ttile+" "+tvol+" "+tpit);
mapper.close();
bump_map_modified();
}

void build_slant()
{
string[] tiles_list = get_map_sound_folders("builder/construction/platforms/*");
if(tiles_list.length() == 0)
{
dlg("Error. There are no platforms available to view. Press enter to continue.");
resume_pools();
return;
}
string disallowed_nums = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ `!@#$%^&*()[]{};:'\"\\|,<>?_/.+=~";
form.reset();
form.create_window("slant", false);
// Input boxes first: footprint, base height, step height.
int mx = form.create_input_box("minimum x", sel_left_set ? sel_left : "");
int mx2 = form.create_input_box("maximum x", sel_right_set ? sel_right : "");
int my=-1, my2=-1;
if(mapmode == "3d")
{
my = form.create_input_box("minimum y", sel_back_set ? sel_back : "");
my2 = form.create_input_box("maximum y", sel_front_set ? sel_front : "");
}
int bh = form.create_input_box("base height", sel_bottom_set ? sel_bottom : "0");
int sh = form.create_input_box("slope amount", "1");
form.set_disallowed_chars(mx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(mx2, disallowed_nums, false, "This character is not allowed.");
if(my != -1) form.set_disallowed_chars(my, disallowed_nums, false, "This character is not allowed.");
if(my2 != -1) form.set_disallowed_chars(my2, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(bh, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(sh, disallowed_nums, false, "This character is not allowed.");
// Direction list (mode-aware); dir_tokens mirrors the item order for retrieval by position.
string[] dir_tokens = {"left_up","left_down","right_up","right_down"};
int dir_list = form.create_list("direction");
form.add_list_item(dir_list, "left up", "left_up");
form.add_list_item(dir_list, "left down", "left_down");
form.add_list_item(dir_list, "right up", "right_up");
form.add_list_item(dir_list, "right down", "right_down");
if(mapmode == "3d")
{
form.add_list_item(dir_list, "forward up", "forward_up");
form.add_list_item(dir_list, "forward down", "forward_down");
form.add_list_item(dir_list, "backward up", "backward_up");
form.add_list_item(dir_list, "backward down", "backward_down");
dir_tokens.insert_last("forward_up");
dir_tokens.insert_last("forward_down");
dir_tokens.insert_last("backward_up");
dir_tokens.insert_last("backward_down");
}
form.set_list_position(dir_list, 0, false);
// Bottom surface group (the sloped ramp floor). "none" opts out.
int bottom_list = form.create_list("bottom surface");
form.add_list_item(bottom_list, "none", "none");
for(uint i = 0; i < tiles_list.length(); i++)
form.add_list_item(bottom_list, tiles_list[i], tiles_list[i]);
form.set_list_position(bottom_list, 0, false);
int bottom_vol = form.create_slider("bottom surface volume", 0, -100, 0, "", 5);
int bottom_pit = form.create_slider("bottom surface pitch", 100, sound_pitch_lower_limit*100, sound_pitch_upper_limit*100, "", 5);
// Top surface group (the landing at the high end). "none" opts out.
int top_list = form.create_list("top surface");
form.add_list_item(top_list, "none", "none");
for(uint i = 0; i < tiles_list.length(); i++)
form.add_list_item(top_list, tiles_list[i], tiles_list[i]);
form.set_list_position(top_list, 0, false);
int top_vol = form.create_slider("top surface volume", 0, -100, 0, "", 5);
int top_pit = form.create_slider("top surface pitch", 100, sound_pitch_lower_limit*100, sound_pitch_upper_limit*100, "", 5);
int ok = form.create_button("&okay", true);
int cn = form.create_button("&cancel");
form.focus(mx);
int active_group = 0;
while(true)
{
wait(5);
form.monitor();
int cur_focus = form.get_current_focus();
int cur_group = 0, active_list = -1, active_vol = -1, active_pit = -1;
if(cur_focus == bottom_list || cur_focus == bottom_vol || cur_focus == bottom_pit)
{
cur_group = 1; active_list = bottom_list; active_vol = bottom_vol; active_pit = bottom_pit;
}
else if(cur_focus == top_list || cur_focus == top_vol || cur_focus == top_pit)
{
cur_group = 2; active_list = top_list; active_vol = top_vol; active_pit = top_pit;
}
int cur_tile_pos = (cur_group > 0) ? form.get_list_position(active_list) : 0;
if(cur_group != active_group)
{
t.destroy_sound(prevslot);
prevslot = -1;
active_group = cur_group;
}
if(key_down(KEY_SPACE) && keytimer.elapsed >= keytime && cur_group > 0 && cur_tile_pos > 0)
{
t.destroy_sound(prevslot);
float v = form.get_slider(active_vol);
float pt = form.get_slider(active_pit);
prevslot = t.play_stationary_extended(get_map_sound("builder/construction/platforms/"+tiles_list[cur_tile_pos-1]+"/*step*"), false, 0, 0, v, pt, false);
keytimer.restart();
}
if(cur_group > 0 && control_is_down() && key_repeating(KEY_L) && cur_tile_pos > 0)
{
t.destroy_sound(prevslot);
float v = form.get_slider(active_vol);
float pt = form.get_slider(active_pit);
prevslot = t.play_stationary_extended(get_map_sound("builder/construction/platforms/"+tiles_list[cur_tile_pos-1]+"/*land*"), false, 0, 0, v, pt, false);
}
if(cur_group > 0 && control_is_down() && key_repeating(KEY_H) && cur_tile_pos > 0)
{
t.destroy_sound(prevslot);
float v = form.get_slider(active_vol);
float pt = form.get_slider(active_pit);
prevslot = t.play_stationary_extended(get_map_sound("builder/construction/platforms/"+tiles_list[cur_tile_pos-1]+"/*fall*"), false, 0, 0, v, pt, false);
}
if(prevslot != -1 && cur_group > 0)
{
float v = form.get_slider(active_vol);
float pt = form.get_slider(active_pit);
t.update_sound_start_values(prevslot, 0, v, pt);
}
if(key_pressed(KEY_ESCAPE))
{
t.destroy_sound(prevslot);
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(cn))
{
t.destroy_sound(prevslot);
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(ok))
{
if(form.get_text(mx).is_empty())
{
speak("Minimum x is required.");
form.focus(mx);
continue;
}
if(form.get_text(mx2).is_empty())
{
speak("Maximum x is required.");
form.focus(mx2);
continue;
}
if(my != -1 && form.get_text(my).is_empty())
{
speak("Minimum y is required.");
form.focus(my);
continue;
}
if(my2 != -1 && form.get_text(my2).is_empty())
{
speak("Maximum y is required.");
form.focus(my2);
continue;
}
if(form.get_text(bh).is_empty())
{
speak("Base height is required.");
form.focus(bh);
continue;
}
if(form.get_text(sh).is_empty())
{
speak("Slope amount is required.");
form.focus(sh);
continue;
}
double bstep = string_to_number(form.get_text(sh));
if(bstep < 1)
{
speak("Slope amount must be at least 1.");
form.focus(sh);
continue;
}
double bx = string_to_number(form.get_text(mx));
double bx2 = string_to_number(form.get_text(mx2));
double bmy = (my != -1) ? string_to_number(form.get_text(my)) : 0;
double bmy2 = (my2 != -1) ? string_to_number(form.get_text(my2)) : 0;
double bbase = string_to_number(form.get_text(bh));
string bdir = dir_tokens[form.get_list_position(dir_list)];
int bp = form.get_list_position(bottom_list);
string bbtile = (bp > 0) ? tiles_list[bp-1] : "none";
double bbvol = form.get_slider(bottom_vol);
double bbpit = form.get_slider(bottom_pit);
int tp = form.get_list_position(top_list);
string bttile = (tp > 0) ? tiles_list[tp-1] : "none";
double btvol = form.get_slider(top_vol);
double btpit = form.get_slider(top_pit);
t.destroy_sound(prevslot);
resume_pools();
write_slant(bx, bx2, bmy, bmy2, bbase, bstep, bdir, bbtile, bbvol, bbpit, bttile, btvol, btpit);
spawn_slant(bx, bx2, bmy, bmy2, bbase, bstep, bdir, bbtile, bbvol, bbpit, bttile, btvol, btpit);
load_map(mapname, mapowner);
mpool.play_stationary(get_pack_sound("main/characters/"+chartype+"/map/*update*"), false);
speak("Map updated.");
return;
}
}
}
