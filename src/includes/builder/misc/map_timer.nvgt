/* The map timer is a single, coordless, map-wide countdown. Unlike every other element it
is not a placed object and there is only ever one active at a time (the last map_timer line
parsed wins). It is silent on its own — all feedback comes from the three author commands,
which fire when the clock expires, at each periodic interval, and each second of the final
countdown. On-disk: map_timer "<time cmd>" "<period cmd>" "<count cmd>" <time> <period> <count> */

bool map_timer_active = false;
bool map_timer_done = false;
int map_timer_total = 0;
int map_timer_period = 0;
int map_timer_count = 0;
string map_timer_time_cmd = "";
string map_timer_period_cmd = "";
string map_timer_count_cmd = "";
double map_timer_elapsed = 0;
int map_timer_last_sec = -1;
timer map_timer_tick;

void arm_map_timer(string time_cmd, string period_cmd, string count_cmd, int total, int period, int count)
{
map_timer_time_cmd = time_cmd;
map_timer_period_cmd = period_cmd;
map_timer_count_cmd = count_cmd;
map_timer_total = total;
map_timer_period = period;
map_timer_count = count;
map_timer_elapsed = 0;
map_timer_done = false;
map_timer_last_sec = -1;
map_timer_tick.restart();
map_timer_active = (total > 0);
}

void destroy_map_timer()
{
map_timer_active = false;
map_timer_done = false;
map_timer_total = 0;
map_timer_period = 0;
map_timer_count = 0;
map_timer_time_cmd = "";
map_timer_period_cmd = "";
map_timer_count_cmd = "";
map_timer_elapsed = 0;
map_timer_last_sec = -1;
}

void read_map_timer(string[] sd)
{
string combined = join_string_array(sd, 1, sd.length());
string remainder;
array<string> quoted = extract_quoted(combined, remainder);
string time_cmd = quoted.length() >= 1 ? quoted[0] : "";
string period_cmd = quoted.length() >= 2 ? quoted[1] : "";
string count_cmd = quoted.length() >= 3 ? quoted[2] : "";
array<string> tail = string_split(string_trim_sides(remainder), " ");
int total = tail.length() >= 1 ? int(stn(tail[0])) : 0;
int period = tail.length() >= 2 ? int(stn(tail[1])) : 0;
int count = tail.length() >= 3 ? int(stn(tail[2])) : 0;
arm_map_timer(time_cmd, period_cmd, count_cmd, total, period, count);
}

void write_map_timer(string time_cmd, string period_cmd, string count_cmd, int total, int period, int count)
{
string ct = escape_quotes(time_cmd);
string cp = escape_quotes(period_cmd);
string cc = escape_quotes(count_cmd);
mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
mapdata=mapper.read();
mapper.write("\r\n"+"map_timer \""+ct+"\" \""+cp+"\" \""+cc+"\" "+total+" "+period+" "+count);
mapper.close();
bump_map_modified();
}

/* Advances the timer once per frame while the game world is running. Lives inside game.nvgt's
freezgame==false block, so a paused game does not tick. Each call adds the real time since the
last call (clamped to drop any freeze gap over one second) and, when a new whole-second boundary
is crossed, fires exactly one event: the time command at zero, a count command inside the final
countdown zone, or a period command on an interval multiple (never at the very start, and paused
while inside the count zone so the two don't stack). */
void map_timer_loop()
{
if(!map_timer_active or map_timer_done) return;
double d = map_timer_tick.elapsed;
map_timer_tick.restart();
if(d > 1000) d = 0;
map_timer_elapsed += d;
int remaining = map_timer_total - int(map_timer_elapsed / 1000);
if(remaining < 0) remaining = 0;
if(remaining == map_timer_last_sec) return;
map_timer_last_sec = remaining;
if(remaining <= 0)
{
if(map_timer_time_cmd != "") comstack(expand_time_tokens(map_timer_time_cmd, 0));
map_timer_done = true;
map_timer_active = false;
return;
}
if(map_timer_count > 0 and remaining <= map_timer_count)
{
if(map_timer_count_cmd != "") comstack(expand_time_tokens(map_timer_count_cmd, remaining));
return;
}
if(map_timer_period > 0 and remaining < map_timer_total and (remaining % map_timer_period) == 0)
{
if(map_timer_period_cmd != "") comstack(expand_time_tokens(map_timer_period_cmd, remaining));
}
}

void build_map_timer()
{
string disallowed_nums = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ `!@#$%^&*()[]{};:'\"\\|,<>?_/.+=~";
form.reset();
form.create_window("map timer", false, true, false);
int time_box = form.create_input_box("time: total seconds on the clock", "60");
int timecmd_box = form.create_input_box("time command: runs when the clock reaches zero, leave blank to skip", "");
int period_box = form.create_input_box("period: seconds between announcements, 0 to disable", "0");
int periodcmd_box = form.create_input_box("period command: runs at each announcement, leave blank to skip", "");
int count_box = form.create_input_box("count: seconds of final countdown, 0 to disable", "0");
int countcmd_box = form.create_input_box("count command: runs each second of the countdown, leave blank to skip", "");
form.set_disallowed_chars(time_box, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(period_box, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(count_box, disallowed_nums, false, "This character is not allowed.");
int ok = form.create_button("&okay", true);
int cn = form.create_button("&cancel");
form.focus(time_box);
while(true)
{
wait(5);
form.monitor();
if(key_pressed(KEY_ESCAPE))
{
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(cn))
{
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(ok))
{
if(form.get_text(time_box) == "") { speak("Time is required."); form.focus(time_box); continue; }
int b_time = string_to_number(form.get_text(time_box));
if(b_time <= 0) { speak("Time must be greater than zero."); form.focus(time_box); continue; }
int b_period = (form.get_text(period_box) == "") ? 0 : string_to_number(form.get_text(period_box));
int b_count = (form.get_text(count_box) == "") ? 0 : string_to_number(form.get_text(count_box));
string b_timecmd = form.get_text(timecmd_box);
string b_periodcmd = form.get_text(periodcmd_box);
string b_countcmd = form.get_text(countcmd_box);
resume_pools();
write_map_timer(b_timecmd, b_periodcmd, b_countcmd, b_time, b_period, b_count);
arm_map_timer(b_timecmd, b_periodcmd, b_countcmd, b_time, b_period, b_count);
load_map(mapname, mapowner);
mpool.play_stationary(get_pack_sound("main/characters/"+chartype+"/map/*update*"), false);
speak("Map updated.");
return;
}
}
}
