/*
Builder templates — §1: coordinate offsetter + geometry line-model.

A builder template is a hand-authored, geometry-only map fragment (plain platforms,
staircases, walls) that gets placed by reference and expanded at load. This file is the
foundation the rest of the feature builds on: it knows, for each geometry keyword in each
map mode, exactly which tokens of a line are coordinates, so template geometry can be
normalized to its own corner and re-offset to a placement anchor WITHOUT disturbing the
non-coordinate fields (health, tile, volume, pitch, destroyable, overlap, etc.).

The token layouts below mirror read_platform / read_staircase / read_wall EXACTLY. They key
on (keyword, mapmode, length) because a single length can mean different things per mode (a
length-11 platform is minx maxx miny maxy on topdown, but minx maxx y z on 3d). Do not diverge
from the read_ functions — see project_stability_rules (read_/write_ signatures, mode length cases).

axis codes returned per token: 0 = not a coordinate, 1 = x, 2 = y, 3 = z.
*/

// Returns an int[] the same length as sd, marking each token's axis (0/1/2/3).
// Returns an EMPTY array if the line is not a recognized, correctly-sized geometry line
// for this mode (unknown keyword, wrong length, or a non-template entity) — callers treat
// an empty result as "skip / invalid".
int[] template_line_axes(string[] sd, string mode)
{
int[] axes;
int len = int(sd.length());
if(len < 1)
return axes;
string kw = sd[0];
if(kw == "platform")
{
if(mode == "2d" && len == 10)
{
axes.resize(len);
axes[1] = 1; axes[2] = 1; axes[3] = 2;
return axes;
}
if(mode == "topdown" && len == 11)
{
axes.resize(len);
axes[1] = 1; axes[2] = 1; axes[3] = 2; axes[4] = 2;
return axes;
}
if(mode == "3d" && len == 11)
{
axes.resize(len);
axes[1] = 1; axes[2] = 1; axes[3] = 2; axes[4] = 3;
return axes;
}
if(mode == "3d" && len == 12)
{
axes.resize(len);
axes[1] = 1; axes[2] = 1; axes[3] = 2; axes[4] = 2; axes[5] = 3;
return axes;
}
return axes;
}
if(kw == "staircase")
{
if(len == 11)
{
axes.resize(len);
axes[1] = 1; axes[2] = 1; axes[3] = 2; axes[4] = 2;
return axes;
}
if(len == 13)
{
axes.resize(len);
axes[1] = 1; axes[2] = 1; axes[3] = 2; axes[4] = 2; axes[5] = 3; axes[6] = 3;
return axes;
}
return axes;
}
if(kw == "wall")
{
if(len == 12)
{
axes.resize(len);
axes[1] = 1; axes[2] = 1; axes[3] = 2; axes[4] = 2;
return axes;
}
if(len == 14)
{
axes.resize(len);
axes[1] = 1; axes[2] = 1; axes[3] = 2; axes[4] = 2; axes[5] = 3; axes[6] = 3;
return axes;
}
return axes;
}
return axes;
}

// True if a single line is a recognized, correctly-sized geometry line for the mode.
// Blank lines are treated as harmless (true). Used by the §5 save-validator.
bool template_valid_line(string line, string mode)
{
string trimmed = string_trim_sides(line);
if(trimmed == "")
return true;
string[] sd = string_split(trimmed, " ", true);
return template_line_axes(sd, mode).length() > 0;
}

// Shift one geometry line's coordinate tokens by (dx, dy, dz). A non-geometry line is
// returned unchanged (callers decide whether to keep or skip it).
string template_offset_line(string line, string mode, double dx, double dy, double dz)
{
string[] sd = string_split(string_trim_sides(line), " ", true);
int[] axes = template_line_axes(sd, mode);
if(axes.length() == 0)
return line;
for(uint j = 0; j < sd.length(); j++)
{
if(axes[j] == 1)
{
double nv = stn(sd[j]) + dx;
sd[j] = "" + nv;
}
else if(axes[j] == 2)
{
double nv = stn(sd[j]) + dy;
sd[j] = "" + nv;
}
else if(axes[j] == 3)
{
double nv = stn(sd[j]) + dz;
sd[j] = "" + nv;
}
}
return join_string_array(sd, 0, sd.length());
}

// Place a template's geometry: normalize every line to the template's own minimum corner
// (so the authored absolute position is irrelevant) and re-offset so that corner lands at
// the anchor (ax, ay, az). Returns ONLY the offset geometry lines — the mode header and any
// non-geometry line are dropped. This is the core transform shared by load-time expansion
// (§3) and compile-time bake (§6).
string[] template_place(string[] lines, string mode, double ax, double ay, double az)
{
// Pass 1: find the template's own minimum corner across every geometry line.
double minx = 0, miny = 0, minz = 0;
bool hx = false, hy = false, hz = false;
for(uint i = 0; i < lines.length(); i++)
{
string[] sd = string_split(string_trim_sides(lines[i]), " ", true);
int[] axes = template_line_axes(sd, mode);
if(axes.length() == 0)
continue;
for(uint j = 0; j < sd.length(); j++)
{
if(axes[j] == 0)
continue;
double v = stn(sd[j]);
if(axes[j] == 1)
{
if(!hx || v < minx) { minx = v; }
hx = true;
}
else if(axes[j] == 2)
{
if(!hy || v < miny) { miny = v; }
hy = true;
}
else if(axes[j] == 3)
{
if(!hz || v < minz) { minz = v; }
hz = true;
}
}
}
double dx = ax - minx;
double dy = ay - miny;
double dz = az - minz;
// Pass 2: emit each geometry line, offset; skip the header and anything non-geometry.
string[] result;
for(uint i = 0; i < lines.length(); i++)
{
string trimmed = string_trim_sides(lines[i]);
if(trimmed == "")
continue;
string[] sd = string_split(trimmed, " ", true);
if(template_line_axes(sd, mode).length() == 0)
continue;
result.insert_last(template_offset_line(trimmed, mode, dx, dy, dz));
}
return result;
}

/*
Builder templates — §2: resolution + I/O.

Two storage roots: the global library and the current map's own folder. A template lives at
<root>/<category>/<subtype>/ holding main.sif (mode header + geometry) and meta.sif (description).
Resolution honors the placement line's path token (global / map / any) with MAP-FIRST precedence,
mirroring read_npc_info (npc.nvgt): map/any try the map copy first; map alone fails if absent;
any/global fall back to the global library. So a map-local template of the same name shadows the
global one.
*/

string template_global_base()
{
return "data/builder/templates";
}

string template_map_base()
{
return "data/builder/maps/decompiled/" + mapname + "/templates/builder";
}

// Resolve the folder for (category, subtype) honoring path. Returns "" if not found.
string template_dir(string path, string category, string subtype)
{
string maplocal = template_map_base() + "/" + category + "/" + subtype;
if(path == "map" || path == "any")
{
if(file_exists(maplocal + "/main.sif"))
return maplocal;
if(path == "map")
return "";
}
string globaldir = template_global_base() + "/" + category + "/" + subtype;
if(file_exists(globaldir + "/main.sif"))
return globaldir;
return "";
}

// Raw contents of a resolved template's main.sif ("" on failure).
string template_main_content(string dir)
{
if(dir == "")
return "";
file f;
if(!f.open(dir + "/main.sif", "rb"))
return "";
string content = f.read();
f.close();
return content;
}

// The mode declared in a template's main.sif header ("mode 2d" -> "2d"); "" if none.
string template_header_mode(string dir)
{
string content = template_main_content(dir);
if(content == "")
return "";
string[] lines = split_lines(content);
for(uint i = 0; i < lines.length(); i++)
{
string[] sd = string_split(string_trim_sides(lines[i]), " ", true);
if(sd.length() >= 2 && sd[0] == "mode")
return string_trim_sides(sd[1]);
}
return "";
}

// The description from a template's meta.sif (quotes optional, like map meta); "" if none.
string template_description(string dir)
{
if(dir == "")
return "";
file f;
if(!f.open(dir + "/meta.sif", "rb"))
return "";
string content = f.read();
f.close();
string[] lines = split_lines(content);
for(uint i = 0; i < lines.length(); i++)
{
string line = lines[i];
int eq = string_find(line, "=");
if(eq < 0)
continue;
string key = string_trim_sides(line.substr(0, eq));
if(key == "description")
return strip_quotes(string_trim_sides(line.substr(eq + 1)));
}
return "";
}

// Category folder names available for the given path, deduped and naturally sorted.
string[] template_categories(string path)
{
string[] result;
if(path == "global" || path == "any")
{
string[] gd = find_directories(template_global_base() + "/*");
for(uint i = 0; i < gd.length(); i++)
{
if(result.find(gd[i]) < 0)
result.insert_last(gd[i]);
}
}
if(path == "map" || path == "any")
{
string[] md = find_directories(template_map_base() + "/*");
for(uint i = 0; i < md.length(); i++)
{
if(result.find(md[i]) < 0)
result.insert_last(md[i]);
}
}
if(result.length() > 0)
sort_naturally(result);
return result;
}

// Template (subtype) names within a category for the given path — only folders that actually
// hold a main.sif — deduped and naturally sorted.
string[] template_subtypes(string path, string category)
{
string[] result;
if(path == "global" || path == "any")
{
string base = template_global_base() + "/" + category;
string[] gd = find_directories(base + "/*");
for(uint i = 0; i < gd.length(); i++)
{
if(file_exists(base + "/" + gd[i] + "/main.sif") && result.find(gd[i]) < 0)
result.insert_last(gd[i]);
}
}
if(path == "map" || path == "any")
{
string base = template_map_base() + "/" + category;
string[] md = find_directories(base + "/*");
for(uint i = 0; i < md.length(); i++)
{
if(file_exists(base + "/" + md[i] + "/main.sif") && result.find(md[i]) < 0)
result.insert_last(md[i]);
}
}
if(result.length() > 0)
sort_naturally(result);
return result;
}

/*
Builder templates — §3: the tpl reference line.

On-disk line: tpl x y path category subtype   (2d / topdown, length 6)
              tpl x y z path category subtype (3d, length 7)

read_template resolves the referenced template (§2), offsets its geometry to the placed anchor
(§1 template_place), and spawns each resulting piece through the normal entity dispatcher
(dispatch_entity_line) — so plain-platform / staircase / wall spawn logic (incl. per-z walls) is
reused verbatim. A missing template is SILENTLY SKIPPED (dev decision 2026-08): players notice a
gap when navigating. No recursion risk: template geometry is platform/staircase/wall only, so the
expanded lines never re-enter the tpl branch.
*/
// Resolve a template's main.sif CONTENT honoring path (map-first). When the current map is
// compiled, a map-scoped template is read from the loaded map PACK (it travels inside the pack),
// so map-scoped tpl references stay LIVE in a compiled map instead of being baked. Global
// templates always come from disk. "" if not found.
string template_resolve_content(string path, string category, string subtype)
{
if(path == "map" || path == "any")
{
if(map_is_compiled && map_pack_loaded)
{
string pf = "templates/builder/" + category + "/" + subtype + "/main.sif";
if(map_pack.file_exists(pf))
return map_pack.read_file(pf, 0, map_pack.get_file_size(pf));
}
else
{
string maplocal = template_map_base() + "/" + category + "/" + subtype + "/main.sif";
file f;
if(file_exists(maplocal) && f.open(maplocal, "rb"))
{
string c = f.read();
f.close();
return c;
}
}
if(path == "map")
return "";
}
string globalmain = template_global_base() + "/" + category + "/" + subtype + "/main.sif";
file gf;
if(file_exists(globalmain) && gf.open(globalmain, "rb"))
{
string c = gf.read();
gf.close();
return c;
}
return "";
}

void read_template(string[] sd)
{
double ax = stn(sd[1]);
double ay = stn(sd[2]);
double az = 0;
int o = 3;
if(mapmode == "3d")
{
az = stn(sd[3]);
o = 4;
}
string path = sd[o];
string category = sd[o + 1];
string subtype = sd[o + 2];
string content = template_resolve_content(path, category, subtype);
if(content == "")
return;
string[] lines = split_lines(content);
string[] placed = template_place(lines, mapmode, ax, ay, az);
for(uint i = 0; i < placed.length(); i++)
{
string[] gsd = string_split(string_trim_sides(placed[i]), " ", true);
dispatch_entity_line(gsd);
}
}
/* Tier 2 semantic check: a tpl reference is an anchor position, a path (global/map/any), and a
category + subtype that must resolve to a real template. template_dir mirrors how load resolves it
(map-first-then-global), returning "" when nothing is found. */
string template_semantic_error(string[] sd, string mode, int &out col)
{
string e = coord_token_error(sd[1], "x", mode);
if(e != "") { col=1; return "the x coordinate "+e+"."; }
e = coord_token_error(sd[2], "y", mode);
if(e != "") { col=2; return "the y coordinate "+e+"."; }
int o = 3;
if(mode == "3d")
{
e = coord_token_error(sd[3], "z", mode);
if(e != "") { col=3; return "the z coordinate "+e+"."; }
o = 4;
}
string path = sd[o];
if(path != "global" && path != "map" && path != "any") { col=o; return "the path must be global, map, or any."; }
string category = sd[o+1];
string subtype = sd[o+2];
if(template_dir(path, category, subtype) == "") { col=o+1; return "the template '"+category+"/"+subtype+"' was not found."; }
return "";
}

// Write a tpl reference line to the current map's main.sif (used by placement, §4).
void write_template(double x, double y, string path, string category, string subtype, double z = 0)
{
mapper.open("data/builder/maps/decompiled/" + mapname + "/" + "data/main.sif", "ab");
mapdata = mapper.read();
string coords = x + " " + y;
if(mapmode == "3d")
coords += " " + z;
mapper.write("\r\n" + "tpl " + coords + " " + path + " " + category + " " + subtype);
mapper.close();
bump_map_modified();
}

/*
Builder templates — §4: placement form (build menu).

Modeled on build_npc (npc.nvgt): coordinate inputs prefilled from the camera markers, then a
path / category / subtype list trio. Differences from build_npc: categories are DYNAMIC (read
from the template folders via template_categories, so they change with the chosen path), there
is no preview audio and no "none" option (a real template must be picked), and okay writes a
single tpl reference line then reloads (read_template expands it on load).
*/
void build_template()
{
string disallowed_nums = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ `!@#$%^&*()[]{};:'\"\\|,<>?_/.+=~";
string[] paths = {"any", "global", "map"};
bool y_uses_back_front = mapmode != "2d";
string saved_x = sel_left_set ? sel_left : "";
string saved_y = y_uses_back_front ? (sel_back_set ? sel_back : "") : (sel_bottom_set ? sel_bottom : "");
string saved_z = sel_bottom_set ? sel_bottom : "";
int saved_path_pos = 0;
int saved_cat_pos = 0;
int saved_sub_pos = 0;
bool do_build = true;
int last_path_pos = -1;
int focus_after_build = 0;
int mx, my, mz, path_list, cat_list, sub_list, ok, cn;
string[] cats;
string[] subs;
while(true)
{
wait(5);
if(do_build)
{
do_build = false;
if(last_path_pos != -1)
{
saved_x = form.get_text(mx);
saved_y = form.get_text(my);
if(mapmode == "3d") saved_z = form.get_text(mz);
}
cats = template_categories(paths[saved_path_pos]);
if(saved_cat_pos < 0 || saved_cat_pos >= int(cats.length())) saved_cat_pos = 0;
string cur_category = (cats.length() > 0) ? cats[saved_cat_pos] : "";
subs = template_subtypes(paths[saved_path_pos], cur_category);
if(saved_sub_pos < 0 || saved_sub_pos >= int(subs.length())) saved_sub_pos = 0;
form.reset();
form.create_window("builder template", false, true, last_path_pos != -1);
mx = form.create_input_box("x", saved_x);
my = form.create_input_box("y", saved_y);
mz = -1;
if(mapmode == "3d") mz = form.create_input_box("z", saved_z);
form.set_disallowed_chars(mx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(my, disallowed_nums, false, "This character is not allowed.");
if(mz != -1) form.set_disallowed_chars(mz, disallowed_nums, false, "This character is not allowed.");
path_list = form.create_list("path");
for(uint i = 0; i < paths.length(); i++)
form.add_list_item(path_list, paths[i], paths[i]);
form.set_list_position(path_list, saved_path_pos, false);
cat_list = form.create_list("category");
for(uint i = 0; i < cats.length(); i++)
form.add_list_item(cat_list, cats[i], cats[i]);
if(cats.length() > 0) form.set_list_position(cat_list, saved_cat_pos, false);
sub_list = form.create_list("template");
for(uint i = 0; i < subs.length(); i++)
form.add_list_item(sub_list, subs[i], subs[i]);
if(subs.length() > 0) form.set_list_position(sub_list, saved_sub_pos, false);
ok = form.create_button("&okay", true);
cn = form.create_button("&cancel");
if(last_path_pos == -1)
form.focus(mx);
else if(focus_after_build == 1)
form.focus_silently(cat_list);
else
form.focus_silently(path_list);
last_path_pos = saved_path_pos;
}
form.monitor();
int cur_path = form.get_list_position(path_list);
if(cur_path != -1 && cur_path != saved_path_pos)
{
saved_path_pos = cur_path;
saved_cat_pos = 0;
saved_sub_pos = 0;
focus_after_build = 0;
do_build = true;
continue;
}
int cur_cat = form.get_list_position(cat_list);
if(cur_cat != -1 && cur_cat != saved_cat_pos)
{
saved_cat_pos = cur_cat;
saved_sub_pos = 0;
focus_after_build = 1;
do_build = true;
continue;
}
if(key_pressed(KEY_ESCAPE))
{
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(cn))
{
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(ok))
{
if(form.get_text(mx).is_empty())
{
speak("X is required.");
form.focus(mx);
continue;
}
if(form.get_text(my).is_empty())
{
speak("Y is required.");
form.focus(my);
continue;
}
if(mz != -1 && form.get_text(mz).is_empty())
{
speak("Z is required.");
form.focus(mz);
continue;
}
if(subs.length() == 0)
{
speak("There are no templates in this category.");
continue;
}
int p = form.get_list_position(sub_list);
if(p < 0 || p >= int(subs.length()))
{
speak("A template is required.");
form.focus(sub_list);
continue;
}
double bx = string_to_number(form.get_text(mx));
double by = string_to_number(form.get_text(my));
double bz = (mz != -1) ? string_to_number(form.get_text(mz)) : 0;
string bpath = paths[saved_path_pos];
string bcat = cats[saved_cat_pos];
string bsub = subs[p];
resume_pools();
write_template(bx, by, bpath, bcat, bsub, bz);
load_map(mapname, mapowner);
mpool.play_stationary(get_pack_sound("main/characters/"+chartype+"/map/*update*"), false);
speak("Map updated.");
return;
}
}
}

/*
Builder templates — §5: management UI (data manager -> "builder templates").

template_chooser() is the add/edit/remove/view hub (modeled on npc_chooser). The shared bits:
template_choose() runs a path/category/subtype picker used by edit/remove/view; template_write()
is the validate-on-save writer used by add/edit — it scans the box, and if ANY non-empty line
is not a well-formed platform/staircase/wall for this mode it NOTIFIES and refuses (rawdata-style),
otherwise writes main.sif (auto-prepended mode header + the lines) and meta.sif (description).
*/

class template_pick
{
string path;
string category;
string subtype;
bool ok = false;
}

// Path/category/subtype picker. Returns a template_pick with ok=false if cancelled.
template_pick@ template_choose(string title, string button_label)
{
string[] paths = {"any", "global", "map"};
int saved_path_pos = 0, saved_cat_pos = 0, saved_sub_pos = 0;
bool do_build = true;
int last_path_pos = -1;
int focus_after_build = 0;
int path_list, cat_list, sub_list, b_ok, b_cn;
string[] cats, subs;
template_pick pick;
while(true)
{
wait(5);
if(do_build)
{
do_build = false;
cats = template_categories(paths[saved_path_pos]);
if(saved_cat_pos < 0 || saved_cat_pos >= int(cats.length())) saved_cat_pos = 0;
string cc = (cats.length() > 0) ? cats[saved_cat_pos] : "";
subs = template_subtypes(paths[saved_path_pos], cc);
if(saved_sub_pos < 0 || saved_sub_pos >= int(subs.length())) saved_sub_pos = 0;
form.reset();
form.create_window(title, false, true, last_path_pos != -1);
path_list = form.create_list("path");
for(uint i = 0; i < paths.length(); i++)
form.add_list_item(path_list, paths[i], paths[i]);
form.set_list_position(path_list, saved_path_pos, false);
cat_list = form.create_list("category");
for(uint i = 0; i < cats.length(); i++)
form.add_list_item(cat_list, cats[i], cats[i]);
if(cats.length() > 0) form.set_list_position(cat_list, saved_cat_pos, false);
sub_list = form.create_list("template");
for(uint i = 0; i < subs.length(); i++)
form.add_list_item(sub_list, subs[i], subs[i]);
if(subs.length() > 0) form.set_list_position(sub_list, saved_sub_pos, false);
b_ok = form.create_button("&" + button_label, true);
b_cn = form.create_button("&cancel");
if(last_path_pos == -1) form.focus(path_list);
else if(focus_after_build == 1) form.focus_silently(cat_list);
else form.focus_silently(path_list);
last_path_pos = saved_path_pos;
}
form.monitor();
int cur_path = form.get_list_position(path_list);
if(cur_path != -1 && cur_path != saved_path_pos)
{
saved_path_pos = cur_path;
saved_cat_pos = 0;
saved_sub_pos = 0;
focus_after_build = 0;
do_build = true;
continue;
}
int cur_cat = form.get_list_position(cat_list);
if(cur_cat != -1 && cur_cat != saved_cat_pos)
{
saved_cat_pos = cur_cat;
saved_sub_pos = 0;
focus_after_build = 1;
do_build = true;
continue;
}
if(key_pressed(KEY_ESCAPE) || form.is_pressed(b_cn))
{
speak("canceled");
return pick;
}
if(form.is_pressed(b_ok))
{
if(subs.length() == 0)
{
speak("There are no templates in this category.");
continue;
}
int p = form.get_list_position(sub_list);
if(p < 0 || p >= int(subs.length()))
{
speak("A template is required.");
form.focus(sub_list);
continue;
}
pick.path = paths[saved_path_pos];
pick.category = cats[saved_cat_pos];
pick.subtype = subs[p];
pick.ok = true;
return pick;
}
}
return pick;
}

// Validate box content as geometry-only for the current mode; if clean, write main.sif (mode
// header + the geometry lines) and meta.sif (description) into dir. Returns true on save; on an
// invalid line it speaks the problem and returns false (caller keeps the form open to fix it).
bool template_write(string dir, string mode, string boxcontent, string description)
{
string[] lines = split_lines(boxcontent);
int bad = 0;
int firstbad = -1;
string[] keep;
for(uint i = 0; i < lines.length(); i++)
{
string t = string_trim_sides(lines[i]);
if(t == "")
continue;
if(!template_valid_line(t, mode))
{
bad++;
if(firstbad < 0) firstbad = int(i) + 1;
continue;
}
keep.insert_last(t);
}
if(bad > 0)
{
speak("" + bad + (bad == 1 ? " line is" : " lines are") + " not valid template geometry, first on line " + firstbad + ". A template may only contain platforms, staircases, and walls.");
return false;
}
if(keep.length() == 0)
{
speak("The template has no geometry.");
return false;
}
string maincontent = "mode " + mode;
for(uint i = 0; i < keep.length(); i++)
maincontent += "\r\n" + keep[i];
create_subfolders(dir + "/main.sif");
file f;
if(!f.open(dir + "/main.sif", "wb"))
{
speak("Failed to write the template.");
return false;
}
f.write(maincontent);
f.close();
file mf;
if(mf.open(dir + "/meta.sif", "wb"))
{
mf.write("description=" + quote_value(description) + "\r\n");
mf.close();
}
return true;
}

// Add: type name + description, pick path + (existing) category, paste/type geometry. Paste
// anything; validation happens on save (template_write).
void add_template()
{
string[] paths = {"global", "map"};
string[] modes = {"2d", "topdown", "3d"};
string saved_name = "";
string saved_desc = "";
string saved_box = "";
int saved_path_pos = 0;
int saved_cat_pos = 0;
int saved_mode_pos = 0;
bool do_build = true;
int last_path_pos = -1;
int focus_after_build = 0;
int in_name, in_desc, in_box, mode_list, path_list, cat_list, ok, cn;
string[] cats;
while(true)
{
wait(5);
if(do_build)
{
do_build = false;
if(last_path_pos != -1)
{
saved_name = form.get_text(in_name);
saved_desc = form.get_text(in_desc);
saved_box = form.get_text(in_box);
saved_mode_pos = form.get_list_position(mode_list);
if(saved_mode_pos < 0) saved_mode_pos = 0;
}
cats = template_categories(paths[saved_path_pos]);
if(saved_cat_pos < 0 || saved_cat_pos >= int(cats.length())) saved_cat_pos = 0;
form.reset();
form.create_window("add template", false, true, last_path_pos != -1);
in_name = form.create_input_box("name", saved_name);
in_desc = form.create_input_box("description", saved_desc);
in_box = form.create_input_box("geometry", saved_box, "", 0, false, true, false);
mode_list = form.create_list("mode");
for(uint i = 0; i < modes.length(); i++)
form.add_list_item(mode_list, modes[i], modes[i]);
form.set_list_position(mode_list, saved_mode_pos, false);
path_list = form.create_list("path");
for(uint i = 0; i < paths.length(); i++)
form.add_list_item(path_list, paths[i], paths[i]);
form.set_list_position(path_list, saved_path_pos, false);
cat_list = form.create_list("category");
for(uint i = 0; i < cats.length(); i++)
form.add_list_item(cat_list, cats[i], cats[i]);
if(cats.length() > 0) form.set_list_position(cat_list, saved_cat_pos, false);
ok = form.create_button("&okay", true);
cn = form.create_button("&cancel");
if(last_path_pos == -1) form.focus(in_name);
else if(focus_after_build == 1) form.focus_silently(path_list);
else form.focus_silently(in_name);
last_path_pos = saved_path_pos;
}
form.monitor();
int cur_path = form.get_list_position(path_list);
if(cur_path != -1 && cur_path != saved_path_pos)
{
saved_path_pos = cur_path;
saved_cat_pos = 0;
focus_after_build = 1;
do_build = true;
continue;
}
if(key_pressed(KEY_ESCAPE) || form.is_pressed(cn))
{
speak("canceled");
return;
}
if(form.is_pressed(ok))
{
string name = string_trim_sides(form.get_text(in_name));
if(name == "")
{
speak("A name is required.");
form.focus(in_name);
continue;
}
if(cats.length() == 0)
{
speak("No categories exist. Create a category folder first.");
continue;
}
if(paths[saved_path_pos] == "map" && mapname == "")
{
speak("No map is loaded, so a template can only be saved globally.");
continue;
}
int mp = form.get_list_position(mode_list);
if(mp < 0) mp = 0;
string mode = modes[mp];
string category = cats[saved_cat_pos];
string base = (paths[saved_path_pos] == "global") ? template_global_base() : template_map_base();
string dir = base + "/" + category + "/" + name;
if(file_exists(dir + "/main.sif"))
{
setupmenu();
m.add_item("Yes");
m.add_item("No");
m.intro_text = "A template named " + name + " already exists in " + category + ". Overwrite it?";
int overres = m.run();
if(overres != 0)
{
speak("canceled");
continue;
}
}
if(template_write(dir, mode, form.get_text(in_box), string_trim_sides(form.get_text(in_desc))))
{
speak("Template saved.");
return;
}
}
}
}

// Edit an existing template's geometry and description in place.
void edit_template()
{
template_pick@ pick = template_choose("edit template", "edit");
if(pick is null || !pick.ok)
return;
string dir = template_dir(pick.path, pick.category, pick.subtype);
if(dir == "")
{
speak("That template could not be found.");
return;
}
string[] lines = split_lines(template_main_content(dir));
string body = "";
for(uint i = 0; i < lines.length(); i++)
{
string[] sd = string_split(string_trim_sides(lines[i]), " ", true);
if(sd.length() >= 1 && sd[0] == "mode")
continue;
if(body != "") body += "\r\n";
body += lines[i];
}
string saved_desc = template_description(dir);
string emode = template_header_mode(dir);
if(emode == "") emode = "2d";
bool do_build = true;
int in_desc, in_box, ok, cn;
while(true)
{
wait(5);
if(do_build)
{
do_build = false;
form.reset();
form.create_window("edit " + pick.subtype, false, true, false);
in_desc = form.create_input_box("description", saved_desc);
in_box = form.create_input_box("geometry", body, "", 0, false, true, false);
ok = form.create_button("&save", true);
cn = form.create_button("&cancel");
form.focus(in_desc);
}
form.monitor();
if(key_pressed(KEY_ESCAPE) || form.is_pressed(cn))
{
speak("canceled");
return;
}
if(form.is_pressed(ok))
{
if(template_write(dir, emode, form.get_text(in_box), string_trim_sides(form.get_text(in_desc))))
{
if(mapname != "") load_map(mapname, mapowner);
speak("Template saved.");
return;
}
}
}
}

// Remove a template (deletes its folder), then reload so any placed instances drop out.
void remove_template()
{
template_pick@ pick = template_choose("remove template", "remove");
if(pick is null || !pick.ok)
return;
string dir = template_dir(pick.path, pick.category, pick.subtype);
if(dir == "")
{
speak("That template could not be found.");
return;
}
setupmenu();
m.add_item("Yes");
m.add_item("No");
m.intro_text = "Are you sure you want to remove the template " + pick.subtype + " from " + pick.category + "?";
int mres = m.run();
if(mres != 0)
{
speak("canceled");
return;
}
directory_delete(dir);
if(mapname != "") load_map(mapname, mapowner);
speak("Template removed.");
}

// View a template's geometry read-only.
void view_template()
{
template_pick@ pick = template_choose("view template", "view");
if(pick is null || !pick.ok)
return;
string dir = template_dir(pick.path, pick.category, pick.subtype);
if(dir == "")
{
speak("That template could not be found.");
return;
}
string content = template_main_content(dir);
string desc = template_description(dir);
bool do_build = true;
int in_desc, in_box, b_back;
while(true)
{
wait(5);
if(do_build)
{
do_build = false;
form.reset();
form.create_window("view " + pick.subtype, false, true, false);
in_desc = form.create_input_box("description", desc, "", 0, true, false, false);
in_box = form.create_input_box("geometry", content, "", 0, true, true, false);
b_back = form.create_button("&back", false, true);
form.focus(in_desc);
}
form.monitor();
if(key_pressed(KEY_ESCAPE) || form.is_pressed(b_back))
return;
}
}

/*
Builder templates — §6: compile-time bake.

When a map compiles to a .map pack, every tpl reference must be replaced by its expanded raw
geometry so the pack is self-contained (the templates live outside the pack, and the recipient
may not have them). compile_map (packfuncts.nvgt) calls template_bake_main() to get the baked
main.sif to pack in place of the original — the decompiled source keeps its compact tpl lines.
These are keyed on an explicit map name + the map's own header mode, because compile does NOT
load the map, so the globals mapname/mapmode are not the chosen map.
*/

// Resolve a template folder for the bake, using an explicit map name (not the global mapname).
string template_bake_dir(string map_name, string path, string category, string subtype)
{
string maplocal = "data/builder/maps/decompiled/" + map_name + "/templates/builder/" + category + "/" + subtype;
if(path == "map" || path == "any")
{
if(file_exists(maplocal + "/main.sif"))
return maplocal;
if(path == "map")
return "";
}
string globaldir = template_global_base() + "/" + category + "/" + subtype;
if(file_exists(globaldir + "/main.sif"))
return globaldir;
return "";
}

// Return a copy of map_name's main.sif with every tpl reference expanded into raw geometry.
// Non-tpl lines pass through unchanged; a dangling reference is silently dropped (as at load).
string template_bake_main(string map_name)
{
string path = "data/builder/maps/decompiled/" + map_name + "/data/main.sif";
file f;
if(!f.open(path, "rb"))
return "";
string content = f.read();
f.close();
string[] lines = split_lines(content);
string mode = "";
for(uint i = 0; i < lines.length(); i++)
{
string[] hs = string_split(string_trim_sides(lines[i]), " ", true);
if(hs.length() >= 2 && hs[0] == "mode")
{
mode = string_trim_sides(hs[1]);
break;
}
}
string baked = "";
bool first = true;
for(uint i = 0; i < lines.length(); i++)
{
string line = lines[i];
string[] sd = string_split(string_trim_sides(line), " ", true);
bool is_tpl = (sd.length() >= 1 && sd[0] == "tpl" && ((mode == "3d" && sd.length() == 7) || (mode != "3d" && sd.length() == 6)));
if(!is_tpl)
{
if(!first) baked += "\r\n";
baked += line;
first = false;
continue;
}
int o = (mode == "3d") ? 4 : 3;
string tpath = sd[o];
string tcat = sd[o + 1];
string tsub = sd[o + 2];
bool has_maplocal = file_exists("data/builder/maps/decompiled/" + map_name + "/templates/builder/" + tcat + "/" + tsub + "/main.sif");
if(tpath == "map" || (tpath == "any" && has_maplocal))
{
// A map-scoped template travels inside the pack, so keep the reference LIVE instead of
// baking it — the pack resolves it from its own embedded template at play time.
if(!first) baked += "\r\n";
baked += line;
first = false;
continue;
}
// Global (or "any" with no map-local copy) -> bake, since the template won't travel with the pack.
double ax = stn(sd[1]);
double ay = stn(sd[2]);
double az = 0;
if(mode == "3d") az = stn(sd[3]);
string dir = template_bake_dir(map_name, tpath, tcat, tsub);
if(dir == "")
continue;
string tcontent = template_main_content(dir);
if(tcontent == "")
continue;
string[] placed = template_place(split_lines(tcontent), mode, ax, ay, az);
for(uint j = 0; j < placed.length(); j++)
{
if(!first) baked += "\r\n";
baked += placed[j];
first = false;
}
}
return baked;
}

// The data-manager hub for builder templates: add / edit / remove / view.
void template_chooser()
{
bool do_build = true;
int b_add, b_edit, b_remove, b_view, b_back;
while(true)
{
wait(5);
if(do_build)
{
do_build = false;
form.reset();
form.create_window("builder templates", false, true, false);
b_add = form.create_button("&add template");
b_edit = form.create_button("&edit template");
b_remove = form.create_button("&remove template");
b_view = form.create_button("&view template");
b_back = form.create_button("&back", false, true);
form.focus(b_add);
}
form.monitor();
if(key_pressed(KEY_ESCAPE) || form.is_pressed(b_back))
return;
if(form.is_pressed(b_add)) { add_template(); do_build = true; continue; }
if(form.is_pressed(b_edit)) { edit_template(); do_build = true; continue; }
if(form.is_pressed(b_remove)) { remove_template(); do_build = true; continue; }
if(form.is_pressed(b_view)) { view_template(); do_build = true; continue; }
}
}
