return types;
}

/* Play one clip out of the folder `base` (ends with "/") if its key is currently pressed. A ctrl
   clip needs control held; a Space clip (with or without ctrl) is level-triggered and throttled by
   keytimer; a ctrl+letter clip uses key_repeating. A plain (non-ctrl) clip requires control to be
   UP, so Ctrl+Space (a surface's move) never also triggers a plain-Space main clip. */
void gallery_try_clip(gallery_clip@ c, const string&in base)
{
bool pressed;
if(c.ctrl)
{
if(!control_is_down()) return;
pressed = (c.key == KEY_SPACE) ? (key_down(c.key) && keytimer.elapsed >= keytime) : key_repeating(c.key);
}
else
pressed = !control_is_down() && key_down(c.key) && keytimer.elapsed >= keytime;
if(!pressed) return;
t.destroy_sound(prevslot);
string clip = get_map_sound(base + c.glob);
if(clip == "")
{
string missing_name = c.label != "" ? c.label : string_replace(c.glob, "*", "", true);
speak("No " + missing_name + " sound specified.");
}
else
prevslot = t.play_stationary(clip, false);
if(c.key == KEY_SPACE) keytimer.restart();
}

/* Runs every monitor() tick while the variant browser is open. Stops the preview when the cursor
   moves, plays the focused variant's clips, and (for a type with a surface axis, i.e. bikes) lets
   Ctrl+; / Ctrl+' cycle the focused variant's surfaces while Ctrl+Space/K/J preview them. */
void gallery_callback(form_menu@ m, string data)
{
int tab = m.active_tab;
int idx = m.focused_item;
if(tab < 0 || tab >= int(g_tabs.length())) return;
if(idx < 0) return;
gallery_tab@ tb = g_tabs[tab];
string variant = m.get_item_id(idx);
if(variant == "") return;
if(tab != g_last_tab || idx != g_last_idx)
{
t.destroy_sound(prevslot);
prevslot = -1;
g_last_tab = tab;
g_last_idx = idx;
// Rebuild the surface list for the newly focused variant, if this tab has a surface axis.
g_surface_idx = 0;
g_surfaces.resize(0);
if(tb.surface_folder != "")
g_surfaces = get_map_sound_folders("builder/" + tb.path + "/" + variant + "/" + tb.surface_folder + "/*");
}
// Secondary surface axis (bikes): cycle with Ctrl+' (next) / Ctrl+; (prev), preview with the
// surface clips. key_pressed advances one surface per press.
if(tb.surface_folder != "" && g_surfaces.length() > 0)
{
// Any arrow (list navigation, with or without control) snaps the surface selection back to the
// first one. Use key_down (a side-effect-free state query) NOT key_repeating here: key_repeating
// consumes the repeat event, which would starve the form's own list navigation and freeze the arrows.
if(key_down(KEY_UP) || key_down(KEY_DOWN) || key_down(KEY_LEFT) || key_down(KEY_RIGHT))
g_surface_idx = 0;
bool cycled = false;
if(control_is_down() && key_pressed(KEY_APOSTROPHE))
{
g_surface_idx = (g_surface_idx + 1) % int(g_surfaces.length());
cycled = true;
}
else if(control_is_down() && key_pressed(KEY_SEMICOLON))
{
g_surface_idx = (g_surface_idx - 1 + int(g_surfaces.length())) % int(g_surfaces.length());
cycled = true;
}
if(cycled)
{
t.destroy_sound(prevslot);
prevslot = -1;
speak(g_surfaces[g_surface_idx]);
}
string sbase = "builder/" + tb.path + "/" + variant + "/" + tb.surface_folder + "/" + g_surfaces[g_surface_idx] + "/";
for(uint si = 0; si < tb.surface_clips.length(); si++)
gallery_try_clip(tb.surface_clips[si], sbase);
}
// Main clips (the element's own sounds).
string base = "builder/" + tb.path + "/" + variant + "/";
if(tb.subpath != "") base += tb.subpath + "/";
for(uint i = 0; i < tb.clips.length(); i++)
gallery_try_clip(tb.clips[i], base);
}

/* The variant browser for one category: a tabbed menu, one tab per declared type, each listing
   the type's variants from disk. Escape (or the OK button) returns to the category menu; the
   preview is driven by gallery_callback. */
void gallery_browse(string category)
{
gallery_type@[] types = gallery_types_for(category);
if(types.length() == 0) return;
/* Expand the authored types into concrete tabs. A single-level type is one tab; a two-step type
   (items, npc) becomes one tab per sub-category folder found on disk. */
g_tabs.resize(0);
for(uint i = 0; i < types.length(); i++)
{
gallery_type@ ty = types[i];
if(!ty.two_step)
{
gallery_tab tab;
tab.name = ty.folder;
tab.path = category + "/" + ty.folder;
tab.subpath = ty.subpath;
tab.clips = ty.clips;
tab.surface_folder = ty.surface_folder;
tab.surface_clips = ty.surface_clips;
g_tabs.insert_last(tab);
}
else
{
string[] subs = get_map_sound_folders("builder/" + category + "/" + ty.folder + "/*");
for(uint s = 0; s < subs.length(); s++)
{
gallery_tab tab;
tab.name = ty.folder + " " + subs[s];
tab.path = category + "/" + ty.folder + "/" + subs[s];
tab.subpath = ty.subpath;
tab.clips = ty.clips;
tab.surface_folder = ty.surface_folder;
tab.surface_clips = ty.surface_clips;
g_tabs.insert_last(tab);
}
}
}
if(g_tabs.length() == 0) return;
g_last_tab = -999;
g_last_idx = -999;
int saved_tab = 0;
int saved_pos = 0;
bool first = true;
while(true)
{
setupmenu();
@m.background_callback = @gallery_callback;
m.tab_caption = "Category";
m.intro_text = first ? (category + " sounds.") : "";
for(uint i = 0; i < g_tabs.length(); i++)
{
int t_idx = m.add_tab(g_tabs[i].name);
string[] variants = get_map_sound_folders("builder/" + g_tabs[i].path + "/*");
for(uint j = 0; j < variants.length(); j++)
m.add_item_to_tab(t_idx, variants[j], variants[j]);
}
if(saved_tab >= 0 && saved_tab < int(g_tabs.length())) m.set_active_tab_silent(saved_tab);
int mres = m.run(saved_pos, true, false);
if(m.active_tab >= 0) saved_tab = m.active_tab;
if(mres >= 0) saved_pos = mres;
t.destroy_sound(prevslot);
prevslot = -1;
if(mres < 0) return;
first = false;
}
}

/* Entry point, dispatched from buildobj on the "gallery" build-menu item (the builder gallery). Pools are already
   paused by the build-menu handler, so resume only on the final exit. Lists the categories that
   have at least one declared type, then hands off to the browser. */
void sound_gallery()
{
string[] categories = get_map_sound_folders("builder/*");
while(true)
{
setupmenu();
m.intro_text = "Builder gallery. Choose a sound category to view.";
int shown = 0;
for(uint i = 0; i < categories.length(); i++)
{
if(gallery_types_for(categories[i]).length() > 0)
{
m.add_item(categories[i], categories[i]);
shown++;
}
}
if(shown == 0)
{
resume_pools();
dlg("Error. There are no sound categories available to view. Press enter to continue.", dlgsound:true);
return;
}
m.add_item("back", "*gallery_back*");
int mres = m.run();
if(mres < 0 || m.selected_item_id == "*gallery_back*")
{
resume_pools();
speak("canceled");
return;
}
gallery_browse(m.selected_item_id);
}
}
