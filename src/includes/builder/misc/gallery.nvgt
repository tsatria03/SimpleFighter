/* gallery.nvgt - builder sound gallery.
 *
 * A browse-only preview of every builder element's sounds, opened from the build menu (the
 * "gallery" entry sits on every tab, just before "template"). Three levels: category -> type ->
 * variant, with a live audio preview on each variant. No placing, no volume/pitch controls.
 *
 * Every folder list is read from disk with get_map_sound_folders, so new variants and a map's
 * own custom sounds appear automatically. The only authored data is the per-type clip table in
 * gallery_types_for() below; a category with no declared types is hidden, and we fill the table
 * in one category at a time. Full per-category clip tables live in aidocks/project_sound_gallery_plan.md.
 *
 * Preview reuses the global preview pool t (dec.nvgt) with prevslot / keytimer, exactly like the
 * build forms and weaponsmenu: Space plays a type's main clip, Ctrl+<letter> plays its extras,
 * and moving the cursor stops the current clip. The background_callback drives all of this; it is
 * a free function, so it reads the current browse state from the module-level globals below.
*/

/* One previewable clip: the key that plays it, whether Ctrl must be held, the glob used to find
   the file, and the spoken label (empty for the Space/main clip, which isn't announced). */
class gallery_clip
{
int key;
bool ctrl;
string glob;
string label;
gallery_clip(int the_key, bool needs_ctrl, string the_glob, string the_label)
{
key = the_key;
ctrl = needs_ctrl;
glob = the_glob;
label = the_label;
}
}

/* One type within a category (e.g. audio's "musics"). folder is its on-disk name; subpath is an
   extra folder between the variant and its clips ("general" for npc, "misc" for bikes, empty for
   most); two_step marks types that nest an extra sub-category level (items, npc), expanded into one
   tab per sub-category. clips lists the previewable sounds, main first. */
class gallery_type
{
string folder;
string subpath;
bool two_step;
gallery_clip@[] clips;
gallery_type(string the_folder, string the_subpath = "", bool is_two_step = false)
{
folder = the_folder;
subpath = the_subpath;
two_step = is_two_step;
}
void add(int the_key, bool needs_ctrl, string the_glob, string the_label)
{
clips.insert_last(gallery_clip(the_key, needs_ctrl, the_glob, the_label));
}
}

/* One resolved tab in the browser: its label, the folder that directly holds the variants (a
   category/type, or category/type/sub-category for a two-step type), an optional subpath after
   the variant ("general" for npc, "misc" for bikes, empty for most), and the clips. gallery_browse
   expands the authored gallery_types into these, so a single-level type makes one tab and a
   two-step type makes one tab per sub-category. */
class gallery_tab
{
string name;
string path;
string subpath;
gallery_clip@[] clips;
}

/* Browse state read by the background_callback (funcdefs can't capture locals). gallery_browse
   fills g_tabs before each run; the callback indexes it by the menu's active tab. */
gallery_tab@[] g_tabs;
int g_last_tab = -999;
int g_last_idx = -999;

/* The declared types for a category, main clip first. An empty result hides the category from the
   menu and skips it in browse, so undeclared categories stay hidden until spec'd. Fill this in one
   category at a time - see the plan memory for the remaining clip tables. */
gallery_type@[] gallery_types_for(string category)
{
gallery_type@[] types;
if(category == "audio")
{
gallery_type musics("musics");
musics.add(KEY_SPACE, false, "*loop*", "");
types.insert_last(musics);
gallery_type sources("sources");
sources.add(KEY_SPACE, false, "*loop*", "");
types.insert_last(sources);
}
else if(category == "construction")
{
gallery_type belts("belts");
belts.add(KEY_SPACE, false, "*loop*", "");
types.insert_last(belts);
gallery_type checkpoints("checkpoints");
checkpoints.add(KEY_SPACE, false, "*get*", "");
checkpoints.add(KEY_L, true, "*loop*", "loop");
types.insert_last(checkpoints);
gallery_type moving_platforms("moving platforms");
moving_platforms.add(KEY_SPACE, false, "*loop*", "");
types.insert_last(moving_platforms);
gallery_type platforms("platforms");
platforms.add(KEY_SPACE, false, "*step*", "");
platforms.add(KEY_L, true, "*land*", "land");
platforms.add(KEY_H, true, "*fall*", "hard land");
types.insert_last(platforms);
gallery_type vanishing_platforms("vanishing platforms");
vanishing_platforms.add(KEY_SPACE, false, "*loop*", "");
types.insert_last(vanishing_platforms);
gallery_type walls("walls");
walls.add(KEY_SPACE, false, "*bump*", "");
walls.add(KEY_L, true, "*hurt*", "hit");
walls.add(KEY_H, true, "*death*", "death");
types.insert_last(walls);
}
else if(category == "interaction")
{
gallery_type calendars("calendars");
calendars.add(KEY_SPACE, false, "*press*", "");
calendars.add(KEY_L, true, "*loop*", "loop");
types.insert_last(calendars);
gallery_type clocks("clocks");
clocks.add(KEY_SPACE, false, "*press*", "");
clocks.add(KEY_L, true, "*loop*", "loop");
types.insert_last(clocks);
gallery_type items("items", "", true);
items.add(KEY_SPACE, false, "*get*", "");
items.add(KEY_L, true, "*loop*", "loop");
types.insert_last(items);
gallery_type sensors("sensors");
sensors.add(KEY_SPACE, false, "*loop*", "");
sensors.add(KEY_N, true, "*on*", "on");
sensors.add(KEY_O, true, "*off*", "off");
types.insert_last(sensors);
gallery_type signs("signs");
signs.add(KEY_SPACE, false, "*press*", "");
signs.add(KEY_L, true, "*loop*", "loop");
signs.add(KEY_H, true, "*break*", "break");
types.insert_last(signs);
gallery_type switches("switches");
switches.add(KEY_SPACE, false, "*press*", "");
switches.add(KEY_L, true, "*loop*", "loop");
types.insert_last(switches);
}
else if(category == "kombat")
{
gallery_type npc("npc", "general", true);
npc.add(KEY_SPACE, false, "*hurt*", "");
npc.add(KEY_L, true, "*taunt*", "taunt");
npc.add(KEY_H, true, "*death*", "death");
types.insert_last(npc);
gallery_type projectiles("projectiles");
projectiles.add(KEY_SPACE, false, "*hit*", "");
projectiles.add(KEY_L, true, "*loop*", "loop");
projectiles.add(KEY_H, true, "*death*", "death");
types.insert_last(projectiles);
}
else if(category == "transitions")
{
gallery_type doors("doors");
doors.add(KEY_SPACE, false, "*loop*", "");
doors.add(KEY_M, true, "*move*", "move");
doors.add(KEY_C, true, "*close*", "close");
doors.add(KEY_O, true, "*open*", "open");
doors.add(KEY_D, true, "*death*", "death");
doors.add(KEY_H, true, "*hurt*", "hurt");
doors.add(KEY_N, true, "*deny*", "deny");
doors.add(KEY_R, true, "*grant*", "grant");
types.insert_last(doors);
gallery_type elevators("elevators");
elevators.add(KEY_SPACE, false, "*loop*", "");
elevators.add(KEY_M, true, "*move*", "move");
elevators.add(KEY_C, true, "*close*", "close");
elevators.add(KEY_O, true, "*open*", "open");
elevators.add(KEY_B, true, "*beep*", "beep");
types.insert_last(elevators);
gallery_type lifts("lifts");
lifts.add(KEY_SPACE, false, "*loop*", "");
types.insert_last(lifts);
gallery_type teleporters("teleporters");
teleporters.add(KEY_SPACE, false, "*move*", "");
teleporters.add(KEY_L, true, "*loop*", "loop");
types.insert_last(teleporters);
gallery_type trampolines("trampolines");
trampolines.add(KEY_SPACE, false, "*land*", "");
trampolines.add(KEY_L, true, "*rise*", "rise");
trampolines.add(KEY_H, true, "*spawn*", "spawn");
types.insert_last(trampolines);
}
else if(category == "transportation")
{
gallery_type aircrafts("aircrafts");
aircrafts.add(KEY_SPACE, false, "*flight*", "");
aircrafts.add(KEY_L, true, "*loop*", "loop");
aircrafts.add(KEY_H, true, "*death*", "death");
types.insert_last(aircrafts);
gallery_type bikes("bikes", "misc");
bikes.add(KEY_SPACE, false, "*hurt*", "");
bikes.add(KEY_L, true, "*beacon*", "beacon");
bikes.add(KEY_H, true, "*death*", "death");
types.insert_last(bikes);
gallery_type vehicles("vehicles");
vehicles.add(KEY_SPACE, false, "*motor*", "");
vehicles.add(KEY_L, true, "*beacon*", "beacon");
vehicles.add(KEY_H, true, "*death*", "death");
types.insert_last(vehicles);
}
else if(category == "traps")
{
gallery_type bombs("bombs");
bombs.add(KEY_SPACE, false, "*land*", "");
bombs.add(KEY_L, true, "*fall*", "fall");
types.insert_last(bombs);
gallery_type fires("fires");
fires.add(KEY_SPACE, false, "*hit*", "");
fires.add(KEY_L, true, "*loop*", "loop");
types.insert_last(fires);
gallery_type floor_breakers("floor breakers");
floor_breakers.add(KEY_SPACE, false, "*spawn*", "");
types.insert_last(floor_breakers);
gallery_type force_fields("force fields");
force_fields.add(KEY_SPACE, false, "*hit*", "");
force_fields.add(KEY_N, true, "*on*", "on");
force_fields.add(KEY_O, true, "*off*", "off");
types.insert_last(force_fields);
gallery_type hazards("hazards");
hazards.add(KEY_SPACE, false, "*fall*", "");
hazards.add(KEY_L, true, "*loop*", "loop");
types.insert_last(hazards);
gallery_type mines("mines");
mines.add(KEY_SPACE, false, "*spawn*", "");
mines.add(KEY_L, true, "*loop*", "loop");
mines.add(KEY_H, true, "*explode*", "explode");
types.insert_last(mines);
gallery_type security_cameras("security cameras");
security_cameras.add(KEY_SPACE, false, "*hurt*", "");
security_cameras.add(KEY_L, true, "*turn*", "turn");
security_cameras.add(KEY_H, true, "*alert*", "alert");
types.insert_last(security_cameras);
gallery_type spikes("spikes");
spikes.add(KEY_SPACE, false, "*hit*", "");
spikes.add(KEY_L, true, "*loop*", "loop");
spikes.add(KEY_H, true, "*death*", "death");
types.insert_last(spikes);
gallery_type time_bombs("time bombs");
time_bombs.add(KEY_SPACE, false, "*land*", "");
time_bombs.add(KEY_L, true, "*tick*", "tick");
types.insert_last(time_bombs);
gallery_type winds("winds");
winds.add(KEY_SPACE, false, "*hit*", "");
winds.add(KEY_L, true, "*loop*", "loop");
types.insert_last(winds);
}
else if(category == "zones")
{
gallery_type heal_zones("heal zones");
heal_zones.add(KEY_SPACE, false, "*heal*", "");
heal_zones.add(KEY_L, true, "*take*", "take");
types.insert_last(heal_zones);
gallery_type safe_zones("safe zones");
safe_zones.add(KEY_SPACE, false, "*out*", "");
safe_zones.add(KEY_L, true, "*in*", "in");
types.insert_last(safe_zones);
gallery_type story_zones("story zones");
story_zones.add(KEY_SPACE, false, "*scroll*", "");
story_zones.add(KEY_L, true, "*open*", "open");
story_zones.add(KEY_H, true, "*close*", "close");
types.insert_last(story_zones);
}
return types;
}

/* Runs every monitor() tick while the variant browser is open. Stops the preview when the cursor
   moves, then plays the focused variant's clip for whichever preview key is down. */
void gallery_callback(form_menu@ m, string data)
{
int tab = m.active_tab;
int idx = m.focused_item;
if(tab < 0 || tab >= int(g_tabs.length())) return;
if(idx < 0) return;
if(tab != g_last_tab || idx != g_last_idx)
{
t.destroy_sound(prevslot);
prevslot = -1;
g_last_tab = tab;
g_last_idx = idx;
}
string variant = m.get_item_id(idx);
if(variant == "") return;
gallery_tab@ tb = g_tabs[tab];
string base = "builder/" + tb.path + "/" + variant + "/";
if(tb.subpath != "") base += tb.subpath + "/";
for(uint i = 0; i < tb.clips.length(); i++)
{
gallery_clip@ c = tb.clips[i];
bool play = false;
if(c.ctrl)
{
if(control_is_down() && key_repeating(c.key)) play = true;
}
else
{
if(key_down(c.key) && keytimer.elapsed >= keytime) play = true;
}
if(!play) continue;
t.destroy_sound(prevslot);
string clip = get_map_sound(base + c.glob);
if(clip == "")
{
string missing_name = c.label != "" ? c.label : string_replace(c.glob, "*", "", true);
speak("No " + missing_name + " sound specified.");
}
else
prevslot = t.play_stationary(clip, false);
if(!c.ctrl) keytimer.restart();
}
}

/* The variant browser for one category: a tabbed menu, one tab per declared type, each listing
   the type's variants from disk. Escape (or the OK button) returns to the category menu; the
   preview is driven by gallery_callback. */
void gallery_browse(string category)
{
gallery_type@[] types = gallery_types_for(category);
if(types.length() == 0) return;
/* Expand the authored types into concrete tabs. A single-level type is one tab; a two-step type
   (items, npc) becomes one tab per sub-category folder found on disk. */
g_tabs.resize(0);
for(uint i = 0; i < types.length(); i++)
{
gallery_type@ ty = types[i];
if(!ty.two_step)
{
gallery_tab tab;
tab.name = ty.folder;
tab.path = category + "/" + ty.folder;
tab.subpath = ty.subpath;
tab.clips = ty.clips;
g_tabs.insert_last(tab);
}
else
{
string[] subs = get_map_sound_folders("builder/" + category + "/" + ty.folder + "/*");
for(uint s = 0; s < subs.length(); s++)
{
gallery_tab tab;
tab.name = ty.folder + " " + subs[s];
tab.path = category + "/" + ty.folder + "/" + subs[s];
tab.subpath = ty.subpath;
tab.clips = ty.clips;
g_tabs.insert_last(tab);
}
}
}
if(g_tabs.length() == 0) return;
g_last_tab = -999;
g_last_idx = -999;
int saved_tab = 0;
int saved_pos = 0;
bool first = true;
while(true)
{
setupmenu();
@m.background_callback = @gallery_callback;
m.tab_caption = "Category";
m.intro_text = first ? (category + " sounds. Arrow keys to move, space to play a sound, control plus a letter for extra sounds, escape to go back.") : "";
for(uint i = 0; i < g_tabs.length(); i++)
{
int t_idx = m.add_tab(g_tabs[i].name);
string[] variants = get_map_sound_folders("builder/" + g_tabs[i].path + "/*");
for(uint j = 0; j < variants.length(); j++)
m.add_item_to_tab(t_idx, variants[j], variants[j]);
}
if(saved_tab >= 0 && saved_tab < int(g_tabs.length())) m.set_active_tab_silent(saved_tab);
int mres = m.run(saved_pos, true, false);
if(m.active_tab >= 0) saved_tab = m.active_tab;
if(mres >= 0) saved_pos = mres;
t.destroy_sound(prevslot);
prevslot = -1;
if(mres < 0) return;
first = false;
}
}

/* Entry point, dispatched from buildobj on the "sound gallery" build-menu item. Pools are already
   paused by the build-menu handler, so resume only on the final exit. Lists the categories that
   have at least one declared type, then hands off to the browser. */
void sound_gallery()
{
string[] categories = get_map_sound_folders("builder/*");
while(true)
{
setupmenu();
m.intro_text = "Sound gallery. Choose a category.";
int shown = 0;
for(uint i = 0; i < categories.length(); i++)
{
if(gallery_types_for(categories[i]).length() > 0)
{
m.add_item(categories[i], categories[i]);
shown++;
}
}
if(shown == 0)
{
resume_pools();
dlg("Error. There are no sound categories available to view. Press enter to continue.", dlgsound:true);
return;
}
m.add_item("back", "*gallery_back*");
int mres = m.run(-1, true, false);
if(mres < 0 || m.selected_item_id == "*gallery_back*")
{
resume_pools();
speak("canceled");
return;
}
gallery_browse(m.selected_item_id);
}
}
