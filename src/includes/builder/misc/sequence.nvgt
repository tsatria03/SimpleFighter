/*
Sequence -- a coordless combination-puzzle element (14.9). It holds an ordered list of step tokens and
fires a command when they are entered in order. Ordinary switches feed it one token at a time with the
/seqstep command (section 2); it is NOT tied to a position and does not watch anything on its own -- it
only reacts when fed. Adapted from an external reference game's ID-based "sequence trigger": SF has no
entity IDs, so instead of the sequence watching triggers by ID, the triggers FEED the sequence by name.

A sequence is an ELEMENT instance found by name (like the map timer), not a bare store: each `sequence`
map line spawns one instance holding its definition plus a current_step counter. Feeding advances the
counter when the token matches the next step; any wrong token runs the fail command and (if reset-on-fail)
restarts; completing runs the complete command and re-arms unless single-use. Session-scoped: instances
re-spawn fresh (current_step 0) on every map load. This file has the data, engine, read/write, teardown,
and the %seq:name% progress token; the /seqstep + /seqreset commands, build form, and map-error checks
arrive in later sections.
*/

class sequence
{
string seqname;
string mode;         // "custom" (match the typed tokens in order), "ascending", or "descending"
string[] steps;      // custom mode: the ordered tokens to match
uint count;          // ascending/descending: how many numbers must be entered in order
double last_value;   // ascending/descending: the last number fed, for the greater/less comparison
string complete_command;
string fail_command;
bool reset_on_fail;
bool single_use;
uint current_step;   // how many correct steps have been entered so far
bool dormant;        // set once a single-use sequence has completed; ignores further input
sequence(string nm, string md, string[]@ stps, uint cnt, string comp, string fail, bool rof, bool su)
{
seqname=nm;
mode=md;
steps=stps;
count=cnt;
complete_command=comp;
fail_command=fail;
reset_on_fail=rof;
single_use=su;
current_step=0;
last_value=0;
dormant=false;
}
}

sequence@[] sequences(0);

// The live sequence with this name, or null. Names are unique per map by convention.
sequence@ find_sequence(string name)
{
for(uint i=0; i<sequences.length(); i++)
{
if(@sequences[i] == null) continue;
if(sequences[i].seqname == name) return @sequences[i];
}
return null;
}

/* Feed one token to the named sequence (the /seqstep command's engine). If the token is the next
expected step, advance; if that was the last step, run the complete command and either re-arm (reset to 0)
or, for single-use, go dormant. Any other token is a wrong entry: run the fail command and, when
reset-on-fail is on, restart from the beginning. Commands run trusted so they work on compiled maps. */
void feed_sequence(string name, string token)
{
sequence@ s = find_sequence(name);
if(@s == null) return;
if(s.dormant) return;
bool matched = false;
uint target = 0;
if(s.mode == "ascending" or s.mode == "descending")
{
if(s.count == 0) return;
target = s.count;
// A non-numeric token, or one not further in the sorted direction, is a wrong entry. The first
// number is always accepted; each later one must be greater (ascending) or less (descending).
if(logic_is_number(token))
{
double v = stn(token);
bool ok;
if(s.current_step == 0) ok = true;
else if(s.mode == "ascending") ok = (v > s.last_value);
else ok = (v < s.last_value);
if(ok) { s.last_value = v; matched = true; }
}
}
else
{
if(s.steps.length() == 0) return;
target = s.steps.length();
if(s.current_step < s.steps.length() and token == s.steps[s.current_step]) matched = true;
}
if(matched)
{
s.current_step += 1;
if(s.current_step >= target)
{
string cmd = s.complete_command;
if(s.single_use) s.dormant = true;
else { s.current_step = 0; s.last_value = 0; }
if(cmd != "") comstack(cmd, true);
}
}
else
{
string cmd = s.fail_command;
if(s.reset_on_fail) { s.current_step = 0; s.last_value = 0; }
if(cmd != "") comstack(cmd, true);
}
}

// Clear a sequence's progress to zero (the /seqreset command). A spent single-use sequence stays spent.
void reset_sequence(string name)
{
sequence@ s = find_sequence(name);
if(@s == null) return;
s.current_step = 0;
s.last_value = 0;
}

void spawn_sequence(string name, string mode, string[]@ steps, uint count, string complete_command, string fail_command, bool reset_on_fail, bool single_use)
{
sequence s(name, mode, steps, count, complete_command, fail_command, reset_on_fail, single_use);
sequences.insert_last(s);
}

/* Parse one sequence line: sequence <name> "<steps>" "<complete cmd>" "<fail cmd>" <reset_on_fail>
<single_use>. name is a bare token; the three quoted fields are the comma-separated steps and the two
commands; the two trailing bare tokens are the bools. Steps are split on commas and trimmed; empty ones
are dropped. A line missing the quoted block is ignored (permit-what-loads). */
void read_sequence(string[] sd)
{
if(sd.length() < 3) return;
string name = sd[1];
// The mode is required and sits right after the name; a line without a valid mode does not load.
string mode = sd[2];
if(mode != "custom" and mode != "ascending" and mode != "descending") return;
string combined = join_string_array(sd, 3, sd.length());
string remainder;
array<string> quoted = extract_quoted(combined, remainder);
if(quoted.length() < 3) return;
string[] steps;
uint count = 0;
if(mode == "ascending" or mode == "descending")
count = uint(stn(quoted[0]));   // in a sort mode the first quoted field is the count, not a token list
else
{
array<string> raw = string_split(quoted[0], ",");
for(uint i=0; i<raw.length(); i++)
{
string t = string_trim_sides(raw[i]);
if(t.length() > 0) steps.insert_last(t);
}
}
bool rof = true;
bool su = false;
array<string> tail = string_split(string_trim_sides(remainder), " ");
string[] bools;
for(uint i=0; i<tail.length(); i++)
if(tail[i].length() > 0) bools.insert_last(tail[i]);
if(bools.length() >= 1) rof = string_to_bool(bools[0]);
if(bools.length() >= 2) su = string_to_bool(bools[1]);
spawn_sequence(name, mode, steps, count, quoted[1], quoted[2], rof, su);
}

/* Write a sequence line. steps_or_count is the first quoted field: the comma-separated tokens in custom
mode, or the count number (as text) in ascending/descending mode. The mode is always written as a bare
token after the name (new format); old mode-less lines still read as custom. */
void write_sequence(string name, string mode, string steps_or_count, string complete_command, string fail_command, bool reset_on_fail, bool single_use)
{
mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
mapdata=mapper.read();
mapper.write("\r\n"+"sequence "+name+" "+mode+" \""+escape_quotes(steps_or_count)+"\" \""+escape_quotes(complete_command)+"\" \""+escape_quotes(fail_command)+"\" "+reset_on_fail+" "+single_use);
mapper.close();
bump_map_modified();
}

void destroy_all_sequences()
{
sequences.resize(0);
}

/* Coordless build form (misc category). A required mode list (custom / ascending / descending) drives
which field appears next, sensor-style: custom shows the steps box (the token combination), while
ascending and descending show a count box (how many numbers must be entered in order). Shared fields are
the name, the two commands, and the reset-on-fail / single-use checkboxes. Appends the line and reloads,
so the loader spawns it. The name box is whitelisted to identifier characters and the count box to
numbers; the steps and command boxes accept anything. */
void build_sequence()
{
string disallowed_nums = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ `!@#$%^&*()[]{};:'\"\\|,<>?_/.+=~";
string saved_name = "";
string saved_steps = "";
string saved_count = "";
string saved_complete = "";
string saved_fail = "";
bool saved_rof = true;
bool saved_su = false;
int saved_mode_pos = 0;
int last_mode_pos = -2;
bool do_build = true;
int mode_list=-1, name_box=-1, steps_box=-1, count_box=-1, complete_box=-1, fail_box=-1, rof_cb=-1, su_cb=-1, ok=-1, cn=-1;
while(true)
{
if(do_build)
{
do_build = false;
if(last_mode_pos != -2)
{
saved_name = form.get_text(name_box);
saved_complete = form.get_text(complete_box);
saved_fail = form.get_text(fail_box);
saved_rof = form.is_checked(rof_cb);
saved_su = form.is_checked(su_cb);
if(last_mode_pos == 0) saved_steps = form.get_text(steps_box);
else saved_count = form.get_text(count_box);
}
form.reset();
form.create_window("sequence", false, true, last_mode_pos != -2);
mode_list = form.create_list("mode");
form.add_list_item(mode_list, "custom", "custom");
form.add_list_item(mode_list, "ascending", "ascending");
form.add_list_item(mode_list, "descending", "descending");
form.set_list_position(mode_list, saved_mode_pos, false);
name_box = form.create_input_box("name: must start with a letter, then letters, digits, and underscores only", saved_name);
steps_box = -1; count_box = -1;
if(saved_mode_pos == 0)
steps_box = form.create_input_box("steps: the combination as tokens separated by commas", saved_steps);
else
count_box = form.create_input_box("count: how many numbers must be entered in order", saved_count);
complete_box = form.create_input_box("on complete command: leave blank to skip", saved_complete);
fail_box = form.create_input_box("on fail command: leave blank to skip", saved_fail);
rof_cb = form.create_checkbox("reset on fail", saved_rof);
su_cb = form.create_checkbox("single use", saved_su);
form.set_disallowed_chars(name_box, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", true, "This character is not allowed.");
if(count_box != -1) form.set_disallowed_chars(count_box, disallowed_nums, false, "This character is not allowed.");
ok = form.create_button("&okay", true);
cn = form.create_button("&cancel");
if(last_mode_pos == -2) form.focus(mode_list);
else form.focus_silently(mode_list);
last_mode_pos = saved_mode_pos;
}
wait(5);
form.monitor();
int cur_mode_pos = form.get_list_position(mode_list);
if(cur_mode_pos != -1 and cur_mode_pos != last_mode_pos)
{
saved_mode_pos = cur_mode_pos;
do_build = true;
continue;
}
if(key_pressed(KEY_ESCAPE)) { resume_pools(); speak("canceled"); return; }
if(form.is_pressed(cn)) { resume_pools(); speak("canceled"); return; }
if(form.is_pressed(ok))
{
string name = string_trim_sides(form.get_text(name_box));
string ne = map_variable_name_error(name);
if(ne != "") { speak(ne); form.focus(name_box); continue; }
string mode = (saved_mode_pos == 1) ? "ascending" : ((saved_mode_pos == 2) ? "descending" : "custom");
string steps_or_count;
if(saved_mode_pos == 0)
{
steps_or_count = string_trim_sides(form.get_text(steps_box));
if(steps_or_count == "") { speak("The steps are required."); form.focus(steps_box); continue; }
}
else
{
steps_or_count = string_trim_sides(form.get_text(count_box));
if(steps_or_count == "" or string_to_number(steps_or_count) < 1) { speak("The count must be a number of at least one."); form.focus(count_box); continue; }
}
string comp = form.get_text(complete_box);
string fail = form.get_text(fail_box);
bool rof = form.is_checked(rof_cb);
bool su = form.is_checked(su_cb);
resume_pools();
write_sequence(name, mode, steps_or_count, comp, fail, rof, su);
load_map(mapname, mapowner);
mpool.play_stationary(get_pack_sound("main/characters/"+chartype+"/map/*update*"), false);
speak("Map updated.");
return;
}
}
}

/* Universal %seq:name% token: replaced with how many steps of that sequence have been entered correctly
so far (0 if the sequence isn't found or hasn't been started). Parameterized scan-and-replace like
%flag:name% / %item:name%, read from after "seq:" to the closing "%"; called in comparse after the item
tokens. */
string expand_seq_tokens(string cmd)
{
if(string_contains(cmd, "%seq:", 1) < 0) return cmd;
string result = "";
int n = int(cmd.length());
int i = 0;
while(i < n)
{
if(cmd.substr(i, 5) == "%seq:")
{
int j = i + 5;
string name = "";
bool closed = false;
while(j < n)
{
string c = cmd.substr(j, 1);
if(c == "%") { closed = true; break; }
name += c;
j++;
}
if(closed and name.length() > 0)
{
sequence@ s = find_sequence(name);
uint prog = (@s != null) ? s.current_step : 0;
result += ("" + prog);
i = j + 1;
continue;
}
}
result += cmd.substr(i, 1);
i++;
}
return result;
}

/* Tier 2 semantic check for a sequence line: the name is a valid identifier (letter-led,
letters/digits/underscores, like a map variable), the quoted block has the three fields (steps, complete
command, fail command), the steps list at least one token, and any trailing reset-on-fail / single-use
token is a real bool. The commands themselves are free text and aren't validated. */
string sequence_semantic_error(string[] sd, string mode, int &out col)
{
if(sd.length() < 3) { col=-1; return "a sequence needs a name and a mode."; }
string name = sd[1];
if(name.length() == 0 or !mv_is_letter(name.substr(0,1))) { col=1; return "the sequence name must start with a letter."; }
for(uint i=0; i<name.length(); i++)
if(!mv_is_name_char(name.substr(i,1))) { col=1; return "the sequence name may only contain letters, digits, and underscores."; }
string smode = sd[2];
if(smode != "custom" and smode != "ascending" and smode != "descending") { col=2; return "the mode must be custom, ascending, or descending."; }
string combined = join_string_array(sd, 3, sd.length());
string remainder;
array<string> quoted = extract_quoted(combined, remainder);
if(quoted.length() < 3) { col=3; return "a sequence needs its steps or count, an on complete command, and an on fail command, all in quotes."; }
if(smode == "custom")
{
int stepcount = 0;
array<string> raw = string_split(quoted[0], ",");
for(uint i=0; i<raw.length(); i++)
if(string_trim_sides(raw[i]).length() > 0) stepcount += 1;
if(stepcount == 0) { col=3; return "the steps must list at least one token separated by commas."; }
}
else
{
if(!is_number_token(quoted[0]) or stn(quoted[0]) < 1) { col=3; return "the count must be a number of at least one."; }
}
array<string> tail = string_split(string_trim_sides(remainder), " ");
for(uint i=0; i<tail.length(); i++)
if(tail[i].length() > 0 and !is_bool_token(tail[i])) { col=-1; return "the reset on fail and single use values must be true or false."; }
return "";
}
