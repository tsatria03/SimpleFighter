/*
Wind -- a placed trap modeled on the fire trap (fire.nvgt): an emitter with a per-axis seeing range
that wakes when the player enters range and homes toward them one tile per speed tick, playing a
looping gust. Unlike fire, wind does NOT kill on contact. When it reaches the player it PUSHES them a
set number of tiles in the direction it faces and, only if a health value of 1 or higher was given,
plays its *hit* sound and chips that much health. A wind with health 0 is a silent gust that only
shoves. Contact repeats (after a push the player is off its tile, so it re-approaches) -- a
chase-and-knockback rhythm, not fire's one-and-done kill. The push is wall-aware (stops against a
wall, never through it) -- that logic and the homing loop arrive in a later section.

Sounds: builder/traps/winds/<type>/{loop,hit}. Direction is an int 1-6, the SAME scheme the conveyor
belt uses (1 left, 2 right, 3 = down in 2d / backward otherwise = y-, 4 = up in 2d / forward otherwise
= y+, and on 3d only 5 = down = z-, 6 = up = z+). The numbers dodge the "up" ambiguity -- "up" is the
y axis in 2d but the z axis in 3d. push is a tile count; windhealth is the per-strike chip (0 = no
damage, no hit sound). Coordinates and ranges are double per the coord stability rule
(fire's ints are legacy). The winds array is COMPACTED like the zones -- entries are never nulled at
runtime, so no null-sentinel guards are needed.

This section (data + lifecycle) defines the class, array, pool, geometry helpers, spawn, and
destroy-all only. The runtime loop (windloop), map read/write, and the build form come in later
sections; nothing here references them, so the build is unaffected.
*/
sound_pool windpool;
wind@[]winds(0);

class wind
{
bool moveable, moveable2, moveable3, spotted;
int windsound;
double windx, windy, windz;
double windrange, windrange2, windrange3;
double windtime;
string windtype;
int direction;
double push;
double windhealth;
timer windtimer;
wind(double wx, double wy, double wrange, double wrange2, double sp, string wt, bool wm, bool wm2, int dir, double psh, double hp, double wz=0, double wrange3=0, bool wm3=false)
{
windx=wx;
windy=wy;
windz=wz;
windrange=wrange;
windrange2=wrange2;
windrange3=wrange3;
windtime=sp;
windtype=wt;
moveable=wm;
moveable2=wm2;
moveable3=wm3;
direction=dir;
push=psh;
windhealth=hp;
spotted=false;
double sz = (mapmode == "3d") ? windz : 0;
windsound=windpool.play_extended_3d(get_map_sound("builder/traps/winds/"+windtype+"/*loop*"),me.x,me.y,me.z,windx,windy,sz,calculate_theta(me_rotation),0,0,0,0,0,0,true,0,0,0,100,false);
}
}
// Is the player inside this wind's seeing box? (z bounded only on 3d.) Mirrors fire's in-range test.
bool player_in_wind_range(uint i)
{
bool in_spot = absolute(me.x-winds[i].windx)<=winds[i].windrange and absolute(me.y-winds[i].windy)<=winds[i].windrange2;
if(mapmode == "3d") in_spot = in_spot and absolute(me.z-winds[i].windz)<=winds[i].windrange3;
return in_spot;
}
// Is the wind sitting on the player's exact tile? (The strike condition.)
bool wind_on_player(uint i)
{
bool hit = me.x==winds[i].windx and me.y==winds[i].windy;
if(mapmode == "3d") hit = hit and me.z==winds[i].windz;
return hit;
}
void spawn_wind(double x, double y, double windrange, double windrange2, double windtime, string windtype, bool moveable, bool moveable2, int direction, double push, double windhealth, double z=0, double windrange3=0, bool moveable3=false)
{
wind w1(x, y, windrange, windrange2, windtime, windtype, moveable, moveable2, direction, push, windhealth, z, windrange3, moveable3);
winds.insert_last(w1);
}
void destroy_all_winds()
{
for(uint i=0; i<winds.length(); i++)
windpool.destroy_sound(winds[i].windsound);
winds.resize(0);
}

/*
Shove the player up to push tiles in the wind's faced direction, one tile at a time, stopping the
instant the next tile is a wall or would leave the map -- "into a wall, but not past it". Direction is
a fixed WORLD axis via the conveyor-belt int scheme (1 left = x-, 2 right = x+, 3 = y-, 4 = y+, 5 = z-,
6 = z+), NOT relative to which way the player is facing. dir 5/6 only ever occur on 3d maps (the form
gates them). Uses wall_blocks() (wall.nvgt) -- the same canonical wall test the player's own walking
uses, so passages and platform-over-wall resolve correctly. A silent gust (health 0) still pushes;
only the *hit* sound and damage are gated on health.
*/
void wind_push_player(uint i)
{
double dx=0, dy=0, dz=0;
int dir = winds[i].direction;
if(dir==1) dx=-1;
else if(dir==2) dx=1;
else if(dir==3) dy=-1;
else if(dir==4) dy=1;
else if(dir==5) dz=-1;
else if(dir==6) dz=1;
int tiles = int(winds[i].push);
for(int s=0; s<tiles; s++)
{
double nx = me.x + dx;
double ny = me.y + dy;
double nz = (mapmode=="3d") ? me.z + dz : me.z;
if(nx < minx or nx > maxx or ny < miny or ny > maxy) break;
if(mapmode=="3d" and (nz < minz or nz > maxz)) break;
if(wall_blocks(nx, ny, nz)) break;
me.x = nx;
me.y = ny;
if(mapmode=="3d") me.z = nz;
}
}

/*
On-disk line (space-delimited). Distinguished by mapmode (like read_mhazard), which matches the
length gate in map_parser (2d/topdown = 12 tokens, 3d = 15). The three new fields -- direction (an
int 1-6, the conveyor-belt scheme), push, health -- sit right after windtype, so the moveable bools
still trail at the very end exactly like fire's line:
  2d / topdown: wind x y  xrange yrange  speed windtype  direction push health  moveable moveable2
  3d          : wind x y z  xrange yrange zrange  speed windtype  direction push health  moveable moveable2 moveable3
*/
void read_wind(string[] sd)
{
double wx=stn(sd[1]);
double wy=stn(sd[2]);
double wz=0;
int o=3;
if(mapmode == "3d")
{
wz=stn(sd[3]);
o=4;
}
double wrange=stn(sd[o]);
double wrange2=stn(sd[o+1]);
double wrange3=0;
if(mapmode == "3d") { wrange3=stn(sd[o+2]); o+=3; } else o+=2;
double sp=stn(sd[o]);
string wt=sd[o+1];
int dir=stn(sd[o+2]);
double psh=stn(sd[o+3]);
double hp=stn(sd[o+4]);
bool wm=string_to_bool(sd[o+5]);
bool wm2=string_to_bool(sd[o+6]);
bool wm3=false;
if(mapmode == "3d") wm3=string_to_bool(sd[o+7]);
spawn_wind(wx, wy, wrange, wrange2, sp, wt, wm, wm2, dir, psh, hp, wz, wrange3, wm3);
}

void write_wind(double x, double y, double windrange, double windrange2, double speed, string windtype, bool moveable, bool moveable2, int direction, double push, double windhealth, double z=0, double windrange3=0, bool moveable3=false)
{
mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
mapdata=mapper.read();
string zsrc = (mapmode == "3d") ? (" "+z) : "";
string zrng = (mapmode == "3d") ? (" "+windrange3) : "";
string zmov = (mapmode == "3d") ? (" "+moveable3) : "";
mapper.write("\r\n"+"wind "+x+" "+y+zsrc+" "+windrange+" "+windrange2+zrng+" "+speed+" "+windtype+" "+direction+" "+push+" "+windhealth+" "+moveable+" "+moveable2+zmov);
mapper.close();
bump_map_modified();
}

/*
Runtime for winds, called each frame from the game loop (game.nvgt, right after fireloop). Throttled
to each wind's own windtime tick so it pulses rather than firing every frame: once the player enters
the seeing box the wind latches spotted, then per tick it homes one tile toward the player on its
enabled axes and, if it is standing on the player's tile, strikes. A strike PUSHES the player
(wall-aware) and -- only when windhealth >= 1 -- plays the *hit* sound and subtracts that health; a
health of 0 is a silent gust that only shoves. Throttling to windtime (unlike fire's per-frame kill)
keeps a wind that has pinned the player against a wall from draining them every single frame -- it
buffets at its own cadence instead. Death, if health reaches 0, is left to the game loop's existing
clamp, exactly like other chip damage. winds is compacted, so no null guards.
*/
void windloop()
{
for(uint i=0; i<winds.length(); i++)
{
if(winds[i].windtimer.elapsed < winds[i].windtime) continue;
if(player_in_wind_range(i)) winds[i].spotted=true;
if(!winds[i].spotted) continue;
winds[i].windtimer.restart();
if(paused==0)
{
if(winds[i].windx<me.x and winds[i].moveable) winds[i].windx += 1;
if(winds[i].windx>me.x and winds[i].moveable) winds[i].windx -= 1;
if(winds[i].windy<me.y and winds[i].moveable2) winds[i].windy += 1;
if(winds[i].windy>me.y and winds[i].moveable2) winds[i].windy -= 1;
if(mapmode=="3d" and winds[i].windz<me.z and winds[i].moveable3) winds[i].windz += 1;
if(mapmode=="3d" and winds[i].windz>me.z and winds[i].moveable3) winds[i].windz -= 1;
}
double usz = (mapmode=="3d") ? winds[i].windz : 0;
windpool.update_sound_3d(winds[i].windsound, winds[i].windx, winds[i].windy, usz);
if(wind_on_player(i) and paused==0 and !glider_engine_on)
{
if(winds[i].windhealth>=1)
{
dlgplay(get_map_sound("builder/traps/winds/"+winds[i].windtype+"/*hit*"));
health-=winds[i].windhealth;
}
wind_push_player(i);
}
}
}

void build_wind()
{
string[] winds_list = get_map_sound_folders("builder/traps/winds/*");
if(winds_list.length() == 0)
{
dlg("Error. There are no winds available to view. Press enter to continue.");
resume_pools();
return;
}
string disallowed_nums = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ `!@#$%^&*()[]{};:'\"\\|,<>?_/.+=~";
form.reset();
form.create_window("wind", false);
bool y_uses_back_front = mapmode != "2d";
int sx = form.create_input_box("x", sel_left_set ? sel_left : "");
int sy = form.create_input_box("y", y_uses_back_front ? (sel_back_set ? sel_back : "") : (sel_bottom_set ? sel_bottom : ""));
int sz = -1;
if(mapmode == "3d") sz = form.create_input_box("z", sel_bottom_set ? sel_bottom : "");
int rng = form.create_input_box("x seeing range", "" + maxx);
int rng2 = form.create_input_box("y seeing range", "" + maxy);
int rng3 = -1;
if(mapmode == "3d") rng3 = form.create_input_box("z seeing range", "" + maxz);
int sp = form.create_input_box("speed");
int pu = form.create_input_box("push distance", "1");
int hp = form.create_input_box("health", "0");
form.set_disallowed_chars(sx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(sy, disallowed_nums, false, "This character is not allowed.");
if(sz != -1) form.set_disallowed_chars(sz, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(rng, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(rng2, disallowed_nums, false, "This character is not allowed.");
if(rng3 != -1) form.set_disallowed_chars(rng3, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(sp, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(pu, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(hp, disallowed_nums, false, "This character is not allowed.");
int wind_list = form.create_list("wind sound");
form.add_list_item(wind_list, "none", "none");
for(uint i = 0; i < winds_list.length(); i++)
form.add_list_item(wind_list, winds_list[i], winds_list[i]);
form.set_list_position(wind_list, 0, false);
int dir_list = form.create_list("direction");
form.add_list_item(dir_list, "left", "1");
form.add_list_item(dir_list, "right", "2");
if(mapmode == "2d")
{
form.add_list_item(dir_list, "down", "3");
form.add_list_item(dir_list, "up", "4");
}
else
{
form.add_list_item(dir_list, "backward", "3");
form.add_list_item(dir_list, "forward", "4");
}
if(mapmode == "3d")
{
form.add_list_item(dir_list, "down", "5");
form.add_list_item(dir_list, "up", "6");
}
form.set_list_position(dir_list, 0, false);
int movex_cb = form.create_checkbox("move on x axis", false);
int movey_cb = form.create_checkbox("move on y axis", false);
int movez_cb = -1;
if(mapmode == "3d") movez_cb = form.create_checkbox("move on z axis", false);
int ok = form.create_button("&okay", true);
int cn = form.create_button("&cancel");
form.focus(sx);
while(true)
{
wait(5);
form.monitor();
int cur_focus = form.get_current_focus();
if(key_down(KEY_SPACE) && keytimer.elapsed >= keytime)
{
t.destroy_sound(prevslot);
if(cur_focus == wind_list)
{
int p = form.get_list_position(wind_list);
if(p > 0) prevslot = t.play_stationary(get_map_sound("builder/traps/winds/"+winds_list[p-1]+"/*hit*"), false);
}
keytimer.restart();
}
if(cur_focus == wind_list && control_is_down() && key_repeating(KEY_L))
{
int p = form.get_list_position(wind_list);
if(p > 0)
{
t.destroy_sound(prevslot);
prevslot = t.play_stationary(get_map_sound("builder/traps/winds/"+winds_list[p-1]+"/*loop*"), false);
}
}
if(key_pressed(KEY_ESCAPE))
{
t.destroy_sound(prevslot);
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(cn))
{
t.destroy_sound(prevslot);
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(ok))
{
if(form.get_text(sx) == "")
{
speak("X is required.");
form.focus(sx);
continue;
}
if(form.get_text(sy) == "")
{
speak("Y is required.");
form.focus(sy);
continue;
}
if(sz != -1 && form.get_text(sz) == "")
{
speak("Z is required.");
form.focus(sz);
continue;
}
if(form.get_text(rng) == "")
{
speak("X seeing range is required.");
form.focus(rng);
continue;
}
if(form.get_text(rng2) == "")
{
speak("Y seeing range is required.");
form.focus(rng2);
continue;
}
if(rng3 != -1 && form.get_text(rng3) == "")
{
speak("Z seeing range is required.");
form.focus(rng3);
continue;
}
if(form.get_text(sp) == "")
{
speak("Speed is required.");
form.focus(sp);
continue;
}
if(form.get_text(pu) == "")
{
speak("Push distance is required.");
form.focus(pu);
continue;
}
double bpush = string_to_number(form.get_text(pu));
if(bpush < 1)
{
speak("Push distance must be at least 1.");
form.focus(pu);
continue;
}
double bsx = string_to_number(form.get_text(sx));
double bsy = string_to_number(form.get_text(sy));
double bsz = (sz != -1) ? string_to_number(form.get_text(sz)) : 0;
double brng = string_to_number(form.get_text(rng));
double brng2 = string_to_number(form.get_text(rng2));
double brng3 = (rng3 != -1) ? string_to_number(form.get_text(rng3)) : 0;
double bsp = string_to_number(form.get_text(sp));
double bhp = (form.get_text(hp) == "") ? 0 : string_to_number(form.get_text(hp));
int wp = form.get_list_position(wind_list);
string btype = (wp > 0) ? winds_list[wp-1] : "none";
int bdir = string_to_number(form.get_list_item_id(dir_list, form.get_list_position(dir_list)));
bool bmx = form.is_checked(movex_cb);
bool bmy = form.is_checked(movey_cb);
bool bmz = (movez_cb != -1) ? form.is_checked(movez_cb) : false;
t.destroy_sound(prevslot);
resume_pools();
write_wind(bsx, bsy, brng, brng2, bsp, btype, bmx, bmy, bdir, bpush, bhp, bsz, brng3, bmz);
spawn_wind(bsx, bsy, brng, brng2, bsp, btype, bmx, bmy, bdir, bpush, bhp, bsz, brng3, bmz);
load_map(mapname, mapowner, force_compiled:map_is_compiled, force_spawned:true);
mpool.play_stationary(get_pack_sound("main/characters/"+chartype+"/map/*update*"), false);
speak("Map updated.");
return;
}
}
}
