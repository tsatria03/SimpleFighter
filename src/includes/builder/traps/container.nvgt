/* A container is a roaming trap: it homes at the player like a fire (live-leash sight), and on reaching
their tile it CATCHES them -- locking their movement (they can still aim/fire) -- carries them up to a
configurable drop height, hovers, then drops them so the normal fall system does the damage. The player
destroys it with weapons (camera-style health + level + xp reward) to avoid being lifted. One-shot: it
removes itself after dropping. 2d + 3d only (topdown has no fall). Models: fire (seek), teleporter
(coordinate move), security_camera (reward). Section 1: the class, globals, and lifecycle helpers only --
the containerloop() state machine, build form, reader/writer, destroy/reward, gallery, and docs come later.
loopsound is the ambient looping slot (the rolling loop, later swapped to the flight loop while lifting);
it must be destroyed on despawn or it leaks. wepsound holds one-shot cues (spawn/catch/hover/drop/etc). */
sound_pool containerpool;
container@[] containers(0);
/* True while a container is carrying the player (FLIGHT or HOVER). Gates catching to one container at a
time, suppresses the player's fallcheck while carried (fallcheck early-returns on it, like glider_engine_on),
and is cleared on drop / death / map-clear so the player falls and regains control. */
bool player_caught = false;
/* Index of the container currently carrying the player (-1 = none). Lets the weapon code (container_autohit)
land the player's shots on the right container while caught, since a thing on the player's own tile can't be
hit by normal aim/collision. Set at catch, cleared on release. */
int container_catcher = -1;

// phase constants for the container state machine (used from containerloop, section 4)
const int CONTAINER_ROLLING = 0;   // seeking the player on the ground
const int CONTAINER_FLIGHT = 1;    // caught the player, carrying them up toward drop height
const int CONTAINER_HOVER = 2;     // holding at the top before the drop

class container
{
bool moveable, moveable2, moveable3, spotted;
int loopsound, wepsound;
int containerx;
int containery;
int containerz;
int crange;
int crange2;
int crange3;
int speed;
double health, maxhealth;
double level, xp;
int dropheight;
int hovertime;
int phase;
string containertype;
timer movetimer, hovertimer;
container(int cx,int cy,int crng,int crng2,int sp,double chp,double cmhp,double clv,double cxp,int cdh,int cht,string ctype,bool cm,bool cm2,int cz=0,int crng3=0,bool cm3=false)
{
containerx=cx;
containery=cy;
containerz=cz;
crange=crng;
crange2=crng2;
crange3=crng3;
speed=sp;
health=chp;
maxhealth=cmhp;
level=clv;
xp=cxp;
dropheight=cdh;
hovertime=cht;
containertype=ctype;
moveable=cm;
moveable2=cm2;
moveable3=cm3;
spotted=false;
phase=CONTAINER_ROLLING;
double sz = (mapmode == "3d") ? containerz : 0;
wepsound=containerpool.play_extended_3d(get_map_sound("builder/traps/containers/"+containertype+"/*spawn*"),me.x,me.y,me.z,containerx,containery,sz,calculate_theta(me_rotation),0,0,0,0,0,0,false,0,0,0,100,false);
loopsound=containerpool.play_extended_3d(get_map_sound("builder/traps/containers/"+containertype+"/*loop*"),me.x,me.y,me.z,containerx,containery,sz,calculate_theta(me_rotation),0,0,0,0,0,0,true,0,0,0,100,false);
}
}
void spawn_container(int x,int y,int crange,int crange2,int speed,double health,double maxhealth,double level,double xp,int dropheight,int hovertime,string containertype,bool moveable,bool moveable2,int z=0,int crange3=0,bool moveable3=false)
{
container ct1(x,y,crange,crange2,speed,health,maxhealth,level,xp,dropheight,hovertime,containertype,moveable,moveable2,z,crange3,moveable3);
containers.insert_last(ct1);
}
/* Non-standard coords (containerx/y/z, int, and mutable as the container roams). Stops the always-looping
loopsound before nulling. A container roams at runtime, so a coord match uses its CURRENT (drifted)
position -- bare form is more reliable for a moving one, like fire/teleporter. */
bool despawn_container(bool by_coord, double gx, double gy, double gz)
{
int target = -1;
for(uint i=0; i<containers.length(); i++)
{
if(@containers[i]==null) continue;
if(!by_coord || (containers[i].containerx==gx && containers[i].containery==gy && (mapmode!="3d" || containers[i].containerz==gz))) target = int(i);
}
if(target < 0) return false;
if(containers[target].phase != CONTAINER_ROLLING) container_release_player();   // it was carrying the player -> release so they can move/fall again
double usz = (mapmode == "3d") ? containers[target].containerz : 0;
containers[target].wepsound = containerpool.play_extended_3d(get_map_sound("builder/traps/containers/"+containers[target].containertype+"/*remove*"),me.x,me.y,me.z,containers[target].containerx,containers[target].containery,usz,calculate_theta(me_rotation),0,0,0,0,0,0,false,0,0,0,100,false);   // despawn is in-memory (no reload), so play the remove cue here like despawn_floorbreaker
containerpool.destroy_sound(containers[target].loopsound);
@containers[target] = null;
return true;
}
/* Map-clear teardown (runs on every load/reload/leave). Like floor breakers (destroy_all_floorbreakers),
each container plays its remove cue as it's torn down, so removing a container line -- which reloads the map
-- makes the removed one (and every other container) sound its removal. despawn (section 6) is in-memory
with no reload, so it plays the cue itself. */
void destroy_all_containers()
{
for(uint i=0; i<containers.length(); i++)
{
if(@containers[i] == null) continue;
containerpool.destroy_sound(containers[i].loopsound);
double usz = (mapmode == "3d") ? containers[i].containerz : 0;
containers[i].wepsound = containerpool.play_extended_3d(get_map_sound("builder/traps/containers/"+containers[i].containertype+"/*remove*"),me.x,me.y,me.z,containers[i].containerx,containers[i].containery,usz,calculate_theta(me_rotation),0,0,0,0,0,0,false,0,0,0,100,false);
}
containers.resize(0);
container_release_player();   // map cleared/reloaded -> nothing is carrying the player anymore
}

/* On-disk: container x y [z] xrange yrange [zrange] speed health level xp dropheight hovertime containertype
movex movey [movez]. 14 tokens on 2d/topdown, 17 on 3d (z after y, zrange after yrange, movez after movey) --
the o-offset walks past each optional 3d field, mirroring read_fire/read_camera. health is written once and
handed to spawn as both current and max. */
void read_container(string[] sd)
{
bool is_3d = sd.length() == 17;
int o = 1;
int cx = stn(sd[o]);
int cy = stn(sd[o+1]);
int cz = 0;
if(is_3d) { cz = stn(sd[o+2]); o += 3; } else o += 2;
int crange = stn(sd[o]);
int crange2 = stn(sd[o+1]);
int crange3 = 0;
if(is_3d) { crange3 = stn(sd[o+2]); o += 3; } else o += 2;
int sp = stn(sd[o]);
double hp = stn(sd[o+1]);
double lv = stn(sd[o+2]);
double xpv = stn(sd[o+3]);
int dh = stn(sd[o+4]);
int ht = stn(sd[o+5]);
string ctype = sd[o+6];
bool cm = string_to_bool(sd[o+7]);
bool cm2 = string_to_bool(sd[o+8]);
bool cm3 = false;
if(is_3d) cm3 = string_to_bool(sd[o+9]);
spawn_container(cx, cy, crange, crange2, sp, hp, hp, lv, xpv, dh, ht, ctype, cm, cm2, cz, crange3, cm3);
}

void write_container(int x, int y, int crange, int crange2, int speed, double health, double level, double xp, int dropheight, int hovertime, string containertype, bool moveable, bool moveable2, int z=0, int crange3=0, bool moveable3=false)
{
mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
mapdata=mapper.read();
string zsrc = (mapmode == "3d") ? (" "+z) : "";
string zrng = (mapmode == "3d") ? (" "+crange3) : "";
string zmov = (mapmode == "3d") ? (" "+moveable3) : "";
mapper.write("\r\n"+"container "+x+" "+y+zsrc+" "+crange+" "+crange2+zrng+" "+speed+" "+health+" "+level+" "+xp+" "+dropheight+" "+hovertime+" "+containertype+" "+moveable+" "+moveable2+zmov);
mapper.close();
bump_map_modified();
}

/* Build form. Field order per the builder-form control convention: inputs, then the sound list, then the
move-axis checkboxes, then okay/cancel. Seeing ranges + drop height default to the map's max extent; drop
height is validated to be at least 10 (a shorter lift wouldn't be a real fall). Audition keys on the sound
list: Space hurt, Ctrl+L loop, Ctrl+N spawn, Ctrl+C catch, Ctrl+I flight, Ctrl+O hover, Ctrl+D drop,
Ctrl+R remove, Ctrl+H death -- the same set wired into the gallery and containers.txt. */
void build_container()
{
string[] conts_l = get_map_sound_folders("builder/traps/containers/*");
if(conts_l.length() == 0)
{
dlg("Error. There are no containers available to view. Press enter to continue.", dlgsound:true);
resume_pools();
return;
}
string disallowed_nums = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ `!@#$%^&*()[]{};:'\"\\|,<>?_/.+=~";
form.reset();
form.create_window("container", false);
bool y_uses_back_front = mapmode != "2d";
int sx = form.create_input_box("x", sel_left_set ? sel_left : "");
int sy = form.create_input_box("y", y_uses_back_front ? (sel_back_set ? sel_back : "") : (sel_bottom_set ? sel_bottom : ""));
int sz = -1;
if(mapmode == "3d") sz = form.create_input_box("z", sel_bottom_set ? sel_bottom : "");
int rng = form.create_input_box("x seeing range", "" + maxx);
int rng2 = form.create_input_box("y seeing range", "" + maxy);
int rng3 = -1;
if(mapmode == "3d") rng3 = form.create_input_box("z seeing range", "" + maxz);
int sp = form.create_input_box("speed");
int hp = form.create_input_box("health", "1");
int lev = form.create_input_box("level");
int exper = form.create_input_box("xp");
int dh = form.create_input_box("drop height", "" + ((mapmode == "3d") ? maxz : maxy));
int ht = form.create_input_box("hover time", "2500");
form.set_disallowed_chars(sx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(sy, disallowed_nums, false, "This character is not allowed.");
if(sz != -1) form.set_disallowed_chars(sz, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(rng, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(rng2, disallowed_nums, false, "This character is not allowed.");
if(rng3 != -1) form.set_disallowed_chars(rng3, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(sp, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(hp, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(lev, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(exper, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(dh, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(ht, disallowed_nums, false, "This character is not allowed.");
int cont_list = form.create_list("container sound");
form.add_list_item(cont_list, "none", "none");
for(uint i = 0; i < conts_l.length(); i++)
form.add_list_item(cont_list, conts_l[i], conts_l[i]);
form.set_list_position(cont_list, 0, false);
int movex_cb = form.create_checkbox("move on x axis", false);
int movey_cb = form.create_checkbox("move on y axis", false);
int movez_cb = -1;
if(mapmode == "3d") movez_cb = form.create_checkbox("move on z axis", false);
int ok = form.create_button("&okay", true);
int cn = form.create_button("&cancel");
form.focus(sx);
while(true)
{
wait(5);
form.monitor();
int cur_focus = form.get_current_focus();
if(key_down(KEY_SPACE) && keytimer.elapsed >= keytime)
{
t.destroy_sound(prevslot);
if(cur_focus == cont_list)
{
int p = form.get_list_position(cont_list);
if(p > 0) prevslot = t.play_stationary(get_map_sound("builder/traps/containers/"+conts_l[p-1]+"/*hurt*"), false);
}
keytimer.restart();
}
if(cur_focus == cont_list && control_is_down() && key_repeating(KEY_L))
{
int p = form.get_list_position(cont_list);
if(p > 0) { t.destroy_sound(prevslot); prevslot = t.play_stationary(get_map_sound("builder/traps/containers/"+conts_l[p-1]+"/*loop*"), false); }
}
if(cur_focus == cont_list && control_is_down() && key_repeating(KEY_N))
{
int p = form.get_list_position(cont_list);
if(p > 0) { t.destroy_sound(prevslot); prevslot = t.play_stationary(get_map_sound("builder/traps/containers/"+conts_l[p-1]+"/*spawn*"), false); }
}
if(cur_focus == cont_list && control_is_down() && key_repeating(KEY_C))
{
int p = form.get_list_position(cont_list);
if(p > 0) { t.destroy_sound(prevslot); prevslot = t.play_stationary(get_map_sound("builder/traps/containers/"+conts_l[p-1]+"/*catch*"), false); }
}
if(cur_focus == cont_list && control_is_down() && key_repeating(KEY_I))
{
int p = form.get_list_position(cont_list);
if(p > 0) { t.destroy_sound(prevslot); prevslot = t.play_stationary(get_map_sound("builder/traps/containers/"+conts_l[p-1]+"/*flight*"), false); }
}
if(cur_focus == cont_list && control_is_down() && key_repeating(KEY_O))
{
int p = form.get_list_position(cont_list);
if(p > 0) { t.destroy_sound(prevslot); prevslot = t.play_stationary(get_map_sound("builder/traps/containers/"+conts_l[p-1]+"/*hover*"), false); }
}
if(cur_focus == cont_list && control_is_down() && key_repeating(KEY_D))
{
int p = form.get_list_position(cont_list);
if(p > 0) { t.destroy_sound(prevslot); prevslot = t.play_stationary(get_map_sound("builder/traps/containers/"+conts_l[p-1]+"/*drop*"), false); }
}
if(cur_focus == cont_list && control_is_down() && key_repeating(KEY_R))
{
int p = form.get_list_position(cont_list);
if(p > 0) { t.destroy_sound(prevslot); prevslot = t.play_stationary(get_map_sound("builder/traps/containers/"+conts_l[p-1]+"/*remove*"), false); }
}
if(cur_focus == cont_list && control_is_down() && key_repeating(KEY_H))
{
int p = form.get_list_position(cont_list);
if(p > 0) { t.destroy_sound(prevslot); prevslot = t.play_stationary(get_map_sound("builder/traps/containers/"+conts_l[p-1]+"/*death*"), false); }
}
if(key_pressed(KEY_ESCAPE))
{
t.destroy_sound(prevslot);
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(cn))
{
t.destroy_sound(prevslot);
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(ok))
{
if(form.get_text(sx) == "") { speak("X is required."); form.focus(sx); continue; }
if(form.get_text(sy) == "") { speak("Y is required."); form.focus(sy); continue; }
if(sz != -1 && form.get_text(sz) == "") { speak("Z is required."); form.focus(sz); continue; }
if(form.get_text(sp) == "") { speak("Speed is required."); form.focus(sp); continue; }
if(form.get_text(hp) == "") { speak("Health is required."); form.focus(hp); continue; }
if(form.get_text(lev) == "") { speak("Level is required."); form.focus(lev); continue; }
if(form.get_text(exper) == "") { speak("XP is required."); form.focus(exper); continue; }
if(form.get_text(dh) == "") { speak("Drop height is required."); form.focus(dh); continue; }
if(form.get_text(ht) == "") { speak("Hover time is required."); form.focus(ht); continue; }
int bdh = string_to_number(form.get_text(dh));
if(bdh < 10) { speak("Drop height cannot be lower than 10."); form.focus(dh); continue; }
int bsx = string_to_number(form.get_text(sx));
int bsy = string_to_number(form.get_text(sy));
int bsz = (sz != -1) ? string_to_number(form.get_text(sz)) : 0;
int brng = string_to_number(form.get_text(rng));
int brng2 = string_to_number(form.get_text(rng2));
int brng3 = (rng3 != -1) ? string_to_number(form.get_text(rng3)) : 0;
int bsp = string_to_number(form.get_text(sp));
double bhp = string_to_number(form.get_text(hp));
double blev = string_to_number(form.get_text(lev));
double bxp = string_to_number(form.get_text(exper));
int bht = string_to_number(form.get_text(ht));
int p = form.get_list_position(cont_list);
string btype = (p > 0) ? conts_l[p-1] : "none";
bool bmx = form.is_checked(movex_cb);
bool bmy = form.is_checked(movey_cb);
bool bmz = (movez_cb != -1) ? form.is_checked(movez_cb) : false;
t.destroy_sound(prevslot);
resume_pools();
write_container(bsx, bsy, brng, brng2, bsp, bhp, blev, bxp, bdh, bht, btype, bmx, bmy, bsz, brng3, bmz);
spawn_container(bsx, bsy, brng, brng2, bsp, bhp, bhp, blev, bxp, bdh, bht, btype, bmx, bmy, bsz, brng3, bmz);
load_map(mapname, mapowner);
mpool.play_stationary(get_pack_sound("main/characters/"+chartype+"/map/*update*"), false);
speak("Map updated.");
return;
}
}
}

/* Release the carried player: just clear the caught flag. Walking is blocked while caught by a
player_caught guard in the key_step/key_strafe movers -- NOT by freezing `moveable`, because moveable
ALSO gates aiming (the face_* keys), so freezing it would stop the player aiming at the container. jumpable
and speedable are held false each frame during the carry and auto-restore via update_character_settings once
player_caught is false, so nothing needs restoring here. Called from every release path -- drop,
destruction-while-caught, despawn, and map-clear. */
void container_release_player()
{
player_caught = false;
container_catcher = -1;
}

/* The state machine, run every frame from the game loop (after update_character_settings + stuncheck,
before game_input -- which is why re-asserting jumpable/speedable=false here actually freezes them). Walking
is blocked separately by a player_caught guard in the key_step/key_strafe movers; moveable is left TRUE
so the alt+shift face_* aiming keys (which moveable gates) still work while caught, so the player can aim.
DEATH (health<=0, set by weapons in the hit loops, section 5): death cue + camera-style xp reward, release
the player if it was carrying them (they fall from the current height), remove. ROLLING: live-leash seek
(spotted recomputed each tick from the seeing-range box), home per move flags at 1 tile/speed, catch on
coincidence -- ON FOOT ONLY (not gliding/vehicle/bike, and not mid-fall). FLIGHT: hold the player's
movement flags (leave fireable/turnable so they can still aim/shoot), lift them 1 tile/speed toward drop
height, then HOVER. HOVER: hold at the top for hover time, then DROP -- stationary drop cue + 3d remove
cue, release the player so fallcheck takes over, and remove the one-shot container. */
void containerloop()
{
for(uint i=0; i<containers.length(); i++)
{
if(@containers[i] == null) continue;
double usz = (mapmode == "3d") ? containers[i].containerz : 0;
if(containers[i].health <= 0)
{
containerpool.destroy_sound(containers[i].loopsound);
containers[i].wepsound = containerpool.play_extended_3d(get_map_sound("builder/traps/containers/"+containers[i].containertype+"/*death*"),me.x,me.y,me.z,containers[i].containerx,containers[i].containery,usz,calculate_theta(me_rotation),0,0,0,0,0,0,false,0,0,0,100,false);
if(xpmod >= 1)
{
double gained_xp = containers[i].xp * containers[i].level * xpmod;
xp += gained_xp;
kombatlog.insert_last(gained_xp + " experience gained. Defeated " + containers[i].containertype + " level " + containers[i].level + ".");
}
if(containers[i].phase != CONTAINER_ROLLING) container_release_player();
@containers[i] = null;
continue;
}
if(containers[i].phase == CONTAINER_ROLLING)
{
if(containers[i].movetimer.elapsed >= containers[i].speed)
{
bool in_spot = absolute(me.x-containers[i].containerx)<=containers[i].crange and absolute(me.y-containers[i].containery)<=containers[i].crange2;
if(mapmode == "3d") in_spot = in_spot and absolute(me.z-containers[i].containerz)<=containers[i].crange3;
containers[i].spotted = in_spot;
if(containers[i].spotted)
{
containerpool.update_sound_3d(containers[i].loopsound, containers[i].containerx, containers[i].containery, usz);
containers[i].movetimer.restart();
if(containers[i].containerx<me.x and containers[i].moveable and paused==0) containers[i].containerx++;
if(containers[i].containerx>me.x and containers[i].moveable and paused==0) containers[i].containerx--;
if(containers[i].containery<me.y and containers[i].moveable2 and paused==0) containers[i].containery++;
if(containers[i].containery>me.y and containers[i].moveable2 and paused==0) containers[i].containery--;
if(mapmode=="3d" and containers[i].containerz<me.z and containers[i].moveable3 and paused==0) containers[i].containerz++;
if(mapmode=="3d" and containers[i].containerz>me.z and containers[i].moveable3 and paused==0) containers[i].containerz--;
}
}
bool caught_now = me.x==containers[i].containerx and me.y==containers[i].containery and (mapmode!="3d" or me.z==containers[i].containerz);
if(caught_now and !player_caught and paused==0 and !glider_engine_on and invehicle==false and onbike==false and inplain==false and falling==false)
{
player_caught = true;
container_catcher = int(i);
containers[i].phase = CONTAINER_FLIGHT;
containerpool.destroy_sound(containers[i].loopsound);
containers[i].wepsound = containerpool.play_stationary_extended(get_map_sound("builder/traps/containers/"+containers[i].containertype+"/*catch*"),false,0,0,0,100,false);
containers[i].loopsound = containerpool.play_stationary_extended(get_map_sound("builder/traps/containers/"+containers[i].containertype+"/*flight*"),true,0,0,0,100,false);
containers[i].movetimer.restart();
}
}
else if(containers[i].phase == CONTAINER_FLIGHT)
{
jumpable=false; speedable=false;   // freeze jump/run while caught; NOT moveable (it also gates aiming -- walking is blocked in the key_step/key_strafe movers instead)
if(paused==0 and containers[i].movetimer.elapsed >= containers[i].speed)
{
containers[i].movetimer.restart();
if(mapmode == "3d")
{
if(int(me.z) < containers[i].dropheight) me.z += 1;
containers[i].containerz = int(me.z);
}
else
{
if(int(me.y) < containers[i].dropheight) me.y += 1;
containers[i].containery = int(me.y);
}
containers[i].containerx = int(me.x);
double fsz = (mapmode == "3d") ? containers[i].containerz : 0;
int height = (mapmode == "3d") ? int(me.z) : int(me.y);
if(height >= containers[i].dropheight)
{
containers[i].phase = CONTAINER_HOVER;
containerpool.destroy_sound(containers[i].loopsound);
containers[i].loopsound = containerpool.play_extended_3d(get_map_sound("builder/traps/containers/"+containers[i].containertype+"/*hover*"),me.x,me.y,me.z,containers[i].containerx,containers[i].containery,fsz,calculate_theta(me_rotation),0,0,0,0,0,0,false,0,0,0,100,false);
containers[i].hovertimer.restart();
}
}
}
else if(containers[i].phase == CONTAINER_HOVER)
{
jumpable=false; speedable=false;   // freeze jump/run while caught; NOT moveable (it also gates aiming -- walking is blocked in the key_step/key_strafe movers instead)
containers[i].containerx = int(me.x);
if(paused==0 and containers[i].hovertimer.elapsed >= containers[i].hovertime)
{
containerpool.destroy_sound(containers[i].loopsound);
containerpool.play_stationary_extended(get_map_sound("builder/traps/containers/"+containers[i].containertype+"/*drop*"),false,0,0,0,100,false);
container_release_player();
@containers[i] = null;
continue;
}
}
}
}
