/* A security jet is an enemy plane with a two-state machine: on the ground it homes at the player like a
tts enemie and melee-strikes on contact, and the instant the player lands a weapon hit while it's grounded
it takes off to a flight height and cruises back and forth across the map like a projectile, landing again
after a flight-time timer to resume homing. Rinse and repeat until its health hits 0 (camera-style health +
level + xp reward). 2d + 3d only (topdown has no height). Passes through walls in both states. Models:
tts_enemie (ground homing + melee), projectile (edge-bouncing air patrol + reward helper), container (state
machine + form + integration points). Section 1: the class, globals, pool, and spawn/despawn/destroy-all
lifecycle only -- jetloop (the state machine), build form, reader/writer, destroy+reward, gallery, and docs
come later. loopsound is the always-looping ambient slot (the ground loop, swapped to the engine loop while
airborne); it must be destroyed on despawn or it leaks. wepsound holds one-shot cues (flight/hit/land/etc).
The jet has no spawn or remove clip, so it just starts its ground loop on spawn and tears down silently. */
sound_pool jetpool;
security_jet@[] jets(0);

// phase constants for the security jet state machine (used from jetloop, section 4)
const int JET_GROUND = 0;    // homing at the player on the ground
const int JET_ASCEND = 1;    // hit while grounded, climbing to the flight height
const int JET_AIR = 2;       // cruising back and forth across the map at flight height
const int JET_DESCEND = 3;   // flight timer expired, coming back down to the ground

class security_jet
{
int loopsound, wepsound;
int jetx;
int jety;
int jetz;
int groundlevel;   // the vertical the jet sits at / returns to on the ground (spawn y on 2d, spawn z on 3d); the climb/descent runs between this and flightheight
int cur_x_step;    // +1 / -1 air-patrol heading along x, flipped when it bounces off a map edge
double health, maxhealth;
double level, xp;
int attack;
int firetime;
int speed;
int flightheight;
int flighttime;
int phase;
string jettype;
timer movetimer, firetimer, flighttimer;
security_jet(int jx, int jy, double hp, double mhp, int atk, int ft, int sp, double lv, double xpv, int fh, int fti, string jt, int jz=0)
{
jetx=jx;
jety=jy;
jetz=jz;
groundlevel=(mapmode == "3d") ? jz : jy;
health=hp;
maxhealth=mhp;
attack=atk;
firetime=ft;
speed=sp;
level=lv;
xp=xpv;
flightheight=fh;
flighttime=fti;
jettype=jt;
phase=JET_GROUND;
cur_x_step=1;
double sz = (mapmode == "3d") ? jetz : 0;
loopsound=jetpool.play_extended_3d(get_map_sound("builder/traps/security jets/"+jettype+"/*loop*"),me.x,me.y,me.z,jetx,jety,sz,calculate_theta(me_rotation),0,0,0,0,0,0,true,0,0,0,100,false);
}
}
void spawn_security_jet(int x, int y, double health, double maxhealth, int attack, int firetime, int speed, double level, double xp, int flightheight, int flighttime, string jettype, int z=0)
{
security_jet sj1(x,y,health,maxhealth,attack,firetime,speed,level,xp,flightheight,flighttime,jettype,z);
jets.insert_last(sj1);
}
/* Non-standard coords (jetx/y/z, int, and mutable as the jet roams). Stops the always-looping loopsound
before nulling. A jet roams at runtime, so a coord match uses its CURRENT (drifted) position -- the bare
newest-of-type form is more reliable for a moving one, like fire/teleporter/container. The jet has no
*remove* clip, so despawn is silent (like the tts enemie's), just tearing down the loop slot. */
bool despawn_security_jet(bool by_coord, double gx, double gy, double gz)
{
int target = -1;
for(uint i=0; i<jets.length(); i++)
{
if(@jets[i]==null) continue;
if(!by_coord || (jets[i].jetx==gx && jets[i].jety==gy && (mapmode!="3d" || jets[i].jetz==gz))) target = int(i);
}
if(target < 0) return false;
jetpool.destroy_sound(jets[target].loopsound);
@jets[target] = null;
return true;
}
/* Map-clear teardown (runs on every load/reload/leave). No *remove* cue (the jet has none), so it just
stops each jet's looping slot and clears the array. */
void destroy_all_security_jets()
{
for(uint i=0; i<jets.length(); i++)
{
if(@jets[i] == null) continue;
jetpool.destroy_sound(jets[i].loopsound);
}
jets.resize(0);
}

/* On-disk: security_jet x y [z] health attack firetime speed level xp flightheight flighttime jettype.
12 tokens on 2d, 13 on 3d (z after y) -- the o-offset walks past the optional 3d z, mirroring
read_container/read_ttsenemie. health is read once and handed to spawn as both current and max. */
void read_security_jet(string[] sd)
{
int x = stn(sd[1]);
int y = stn(sd[2]);
int z = 0;
int o = 3;
if(mapmode == "3d") { z = stn(sd[3]); o = 4; }
double hp = stn(sd[o]);
int atk = stn(sd[o+1]);
int ft = stn(sd[o+2]);
int sp = stn(sd[o+3]);
double lv = stn(sd[o+4]);
double xpv = stn(sd[o+5]);
int fh = stn(sd[o+6]);
int fti = stn(sd[o+7]);
string jt = sd[o+8];
spawn_security_jet(x, y, hp, hp, atk, ft, sp, lv, xpv, fh, fti, jt, z);
}

void write_security_jet(int x, int y, double health, int attack, int firetime, int speed, double level, double xp, int flightheight, int flighttime, string jettype, int z=0)
{
mapper.open("data/builder/maps/decompiled/"+mapname+"/"+"data/main.sif","ab");
mapdata=mapper.read();
string zsrc = (mapmode == "3d") ? (" "+z) : "";
mapper.write("\r\n"+"security_jet "+x+" "+y+zsrc+" "+health+" "+attack+" "+firetime+" "+speed+" "+level+" "+xp+" "+flightheight+" "+flighttime+" "+jettype);
mapper.close();
bump_map_modified();
}

/* Build form. Field order per the builder-form control convention: inputs, then the sound list, then
okay/cancel -- NO checkboxes for this element. Audition keys on the sound list: Space hurt, Ctrl+L loop,
Ctrl+E engine, Ctrl+F flight, Ctrl+H hit, Ctrl+A land, Ctrl+D death -- the same set wired into the gallery
and security_jets.txt. health/level/xp/flight height/flight time carry sensible defaults (1 / 1 / 0 / 5 /
5000); attack, fire time, and speed are required with no default. */
void build_security_jet()
{
string[] jets_l = get_map_sound_folders("builder/traps/security jets/*");
if(jets_l.length() == 0)
{
dlg("Error. There are no security jets available to view. Press enter to continue.", dlgsound:true);
resume_pools();
return;
}
string disallowed_nums = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ `!@#$%^&*()[]{};:'\"\\|,<>?_/.+=~";
form.reset();
form.create_window("security jet", false);
bool y_uses_back_front = mapmode != "2d";
int sx = form.create_input_box("x", sel_left_set ? sel_left : "");
int sy = form.create_input_box("y", y_uses_back_front ? (sel_back_set ? sel_back : "") : (sel_bottom_set ? sel_bottom : ""));
int sz = -1;
if(mapmode == "3d") sz = form.create_input_box("z", sel_bottom_set ? sel_bottom : "");
int hp = form.create_input_box("health", "1");
int atk = form.create_input_box("attack");
int ft = form.create_input_box("fire time");
int sp = form.create_input_box("speed");
int lev = form.create_input_box("level", "1");
int exper = form.create_input_box("xp", "0");
int fh = form.create_input_box("flight height", "5");
int fti = form.create_input_box("flight time", "5000");
form.set_disallowed_chars(sx, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(sy, disallowed_nums, false, "This character is not allowed.");
if(sz != -1) form.set_disallowed_chars(sz, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(hp, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(atk, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(ft, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(sp, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(lev, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(exper, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(fh, disallowed_nums, false, "This character is not allowed.");
form.set_disallowed_chars(fti, disallowed_nums, false, "This character is not allowed.");
int jet_list = form.create_list("security jet sound");
form.add_list_item(jet_list, "none", "none");
for(uint i = 0; i < jets_l.length(); i++)
form.add_list_item(jet_list, jets_l[i], jets_l[i]);
form.set_list_position(jet_list, 0, false);
int ok = form.create_button("&okay", true);
int cn = form.create_button("&cancel");
form.focus(sx);
while(true)
{
wait(5);
form.monitor();
int cur_focus = form.get_current_focus();
if(key_down(KEY_SPACE) && keytimer.elapsed >= keytime)
{
t.destroy_sound(prevslot);
if(cur_focus == jet_list)
{
int p = form.get_list_position(jet_list);
if(p > 0) prevslot = t.play_stationary(get_map_sound("builder/traps/security jets/"+jets_l[p-1]+"/*hurt*"), false);
}
keytimer.restart();
}
if(cur_focus == jet_list && control_is_down() && key_repeating(KEY_L))
{
int p = form.get_list_position(jet_list);
if(p > 0) { t.destroy_sound(prevslot); prevslot = t.play_stationary(get_map_sound("builder/traps/security jets/"+jets_l[p-1]+"/*loop*"), false); }
}
if(cur_focus == jet_list && control_is_down() && key_repeating(KEY_E))
{
int p = form.get_list_position(jet_list);
if(p > 0) { t.destroy_sound(prevslot); prevslot = t.play_stationary(get_map_sound("builder/traps/security jets/"+jets_l[p-1]+"/*engine*"), false); }
}
if(cur_focus == jet_list && control_is_down() && key_repeating(KEY_F))
{
int p = form.get_list_position(jet_list);
if(p > 0) { t.destroy_sound(prevslot); prevslot = t.play_stationary(get_map_sound("builder/traps/security jets/"+jets_l[p-1]+"/*flight*"), false); }
}
if(cur_focus == jet_list && control_is_down() && key_repeating(KEY_H))
{
int p = form.get_list_position(jet_list);
if(p > 0) { t.destroy_sound(prevslot); prevslot = t.play_stationary(get_map_sound("builder/traps/security jets/"+jets_l[p-1]+"/*hit*"), false); }
}
if(cur_focus == jet_list && control_is_down() && key_repeating(KEY_A))
{
int p = form.get_list_position(jet_list);
if(p > 0) { t.destroy_sound(prevslot); prevslot = t.play_stationary(get_map_sound("builder/traps/security jets/"+jets_l[p-1]+"/*land*"), false); }
}
if(cur_focus == jet_list && control_is_down() && key_repeating(KEY_D))
{
int p = form.get_list_position(jet_list);
if(p > 0) { t.destroy_sound(prevslot); prevslot = t.play_stationary(get_map_sound("builder/traps/security jets/"+jets_l[p-1]+"/*death*"), false); }
}
if(key_pressed(KEY_ESCAPE))
{
t.destroy_sound(prevslot);
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(cn))
{
t.destroy_sound(prevslot);
resume_pools();
speak("canceled");
return;
}
if(form.is_pressed(ok))
{
if(form.get_text(sx) == "") { speak("X is required."); form.focus(sx); continue; }
if(form.get_text(sy) == "") { speak("Y is required."); form.focus(sy); continue; }
if(sz != -1 && form.get_text(sz) == "") { speak("Z is required."); form.focus(sz); continue; }
if(form.get_text(hp) == "") { speak("Health is required."); form.focus(hp); continue; }
if(form.get_text(atk) == "") { speak("Attack is required."); form.focus(atk); continue; }
if(form.get_text(ft) == "") { speak("Fire time is required."); form.focus(ft); continue; }
if(form.get_text(sp) == "") { speak("Speed is required."); form.focus(sp); continue; }
if(form.get_text(lev) == "") { speak("Level is required."); form.focus(lev); continue; }
if(form.get_text(exper) == "") { speak("XP is required."); form.focus(exper); continue; }
if(form.get_text(fh) == "") { speak("Flight height is required."); form.focus(fh); continue; }
if(form.get_text(fti) == "") { speak("Flight time is required."); form.focus(fti); continue; }
int bsx = string_to_number(form.get_text(sx));
int bsy = string_to_number(form.get_text(sy));
int bsz = (sz != -1) ? string_to_number(form.get_text(sz)) : 0;
double bhp = string_to_number(form.get_text(hp));
int batk = string_to_number(form.get_text(atk));
int bft = string_to_number(form.get_text(ft));
int bsp = string_to_number(form.get_text(sp));
double blev = string_to_number(form.get_text(lev));
double bxp = string_to_number(form.get_text(exper));
int bfh = string_to_number(form.get_text(fh));
int bfti = string_to_number(form.get_text(fti));
int p = form.get_list_position(jet_list);
string btype = (p > 0) ? jets_l[p-1] : "none";
t.destroy_sound(prevslot);
resume_pools();
write_security_jet(bsx, bsy, bhp, batk, bft, bsp, blev, bxp, bfh, bfti, btype, bsz);
spawn_security_jet(bsx, bsy, bhp, bhp, batk, bft, bsp, blev, bxp, bfh, bfti, btype, bsz);
load_map(mapname, mapowner);
mpool.play_stationary(get_pack_sound("main/characters/"+chartype+"/map/*update*"), false);
speak("Map updated.");
return;
}
}
}
